#. clinicSites.infirmary.name
#: src/data/clinic.js:8
msgctxt "text:clinicSites.infirmary.name"
msgid "Hakurei Gate Infirmary"
msgstr "Hakurei Gate Infirmary"

#. clinicSites.infirmary.short
#: src/data/clinic.js:9
msgctxt "text:clinicSites.infirmary.short"
msgid "Main infirmary"
msgstr "Main infirmary"

#. clinicSites.infirmary.location
#: src/data/clinic.js:10
msgctxt "text:clinicSites.infirmary.location"
msgid "Main campus · old shrine office east of Hakurei Gate"
msgstr "Main campus · old shrine office east of Hakurei Gate"

#. clinicSites.infirmary.hours
#: src/data/clinic.js:11
msgctxt "text:clinicSites.infirmary.hours"
msgid "07:40—21:30; the desk is not guaranteed occupied for twenty minutes after the noon bell"
msgstr "07:40—21:30; the desk is not guaranteed occupied for twenty minutes after the noon bell"

#. clinicSites.infirmary.scope
#: src/data/clinic.js:12
msgctxt "text:clinicSites.infirmary.scope"
msgid ""
"Scrapes, mild magical feedback, flight-muscle strains, paper-talisman cuts, "
"class-related sleep loss, and symptoms still deciding whether they require "
"Eientei."
msgstr ""
"Scrapes, mild magical feedback, flight-muscle strains, paper-talisman cuts, "
"class-related sleep loss, and symptoms still deciding whether they require "
"Eientei."

#. clinicSites.infirmary.staff
#: src/data/clinic.js:13
msgctxt "text:clinicSites.infirmary.staff"
msgid ""
"Duty clinician, two moon-rabbit trainees, and Reimu when she comes to "
"collect the offering-box fee"
msgstr ""
"Duty clinician, two moon-rabbit trainees, and Reimu when she comes to "
"collect the offering-box fee"

#. clinicSites.eientei.name
#: src/data/clinic.js:19
msgctxt "text:clinicSites.eientei.name"
msgid "Eientei University Hospital"
msgstr "Eientei University Hospital"

#. clinicSites.eientei.short
#: src/data/clinic.js:20
msgctxt "text:clinicSites.eientei.short"
msgid "Eientei Hospital"
msgstr "Eientei Hospital"

#. clinicSites.eientei.location
#: src/data/clinic.js:21
msgctxt "text:clinicSites.eientei.location"
msgid "Bamboo Forest · Eientei clinical wing and lunar pharmacy"
msgstr "Bamboo Forest · Eientei clinical wing and lunar pharmacy"

#. clinicSites.eientei.hours
#: src/data/clinic.js:22
msgctxt "text:clinicSites.eientei.hours"
msgid "Always open; full-moon traffic diverts through the pharmacy corridor"
msgstr "Always open; full-moon traffic diverts through the pharmacy corridor"

#. clinicSites.eientei.scope
#: src/data/clinic.js:23
msgctxt "text:clinicSites.eientei.scope"
msgid ""
"Cross-species care, lunar sensory conditions, boundary sickness, phantom "
"desynchrony, fairy-core trouble, magical-material exposure, and cases marked "
"with three exclamation points by the infirmary."
msgstr ""
"Cross-species care, lunar sensory conditions, boundary sickness, phantom "
"desynchrony, fairy-core trouble, magical-material exposure, and cases marked "
"with three exclamation points by the infirmary."

#. clinicSites.eientei.staff
#: src/data/clinic.js:24
msgctxt "text:clinicSites.eientei.staff"
msgid ""
"Eirin Yagokoro consulting, Reisen triaging, and Tewi hiding queue tokens "
"back where they came from"
msgstr ""
"Eirin Yagokoro consulting, Reisen triaging, and Tewi hiding queue tokens "
"back where they came from"

#. clinicComplaints.danmaku-impact.name
#: src/data/clinic.js:36
msgctxt "text:clinicComplaints.danmaku-impact.name"
msgid "Danmaku impact / talisman abrasion"
msgstr "Danmaku impact / talisman abrasion"

#. clinicComplaints.danmaku-impact.prompt
#: src/data/clinic.js:37
msgctxt "text:clinicComplaints.danmaku-impact.prompt"
msgid ""
"Is the impact site still glowing, smoking, or insisting it was merely a "
"background bullet?"
msgstr ""
"Is the impact site still glowing, smoking, or insisting it was merely a "
"background bullet?"

#. clinicComplaints.magic-feedback.name
#: src/data/clinic.js:46
msgctxt "text:clinicComplaints.magic-feedback.name"
msgid "Magical feedback / hakkero overheating"
msgstr "Magical feedback / hakkero overheating"

#. clinicComplaints.magic-feedback.prompt
#: src/data/clinic.js:47
msgctxt "text:clinicComplaints.magic-feedback.prompt"
msgid "Sleeves, hair, or thesis appendices continue discharging after the spell stops."
msgstr "Sleeves, hair, or thesis appendices continue discharging after the spell stops."

#. clinicComplaints.boundary-vertigo.name
#: src/data/clinic.js:56
msgctxt "text:clinicComplaints.boundary-vertigo.name"
msgid "Boundary vertigo / door arriving first"
msgstr "Boundary vertigo / door arriving first"

#. clinicComplaints.boundary-vertigo.prompt
#: src/data/clinic.js:57
msgctxt "text:clinicComplaints.boundary-vertigo.prompt"
msgid ""
"The two sides of one door show different dates, or descending returns you to "
"before you climbed."
msgstr ""
"The two sides of one door show different dates, or descending returns you to "
"before you climbed."

#. clinicComplaints.lunar-overload.name
#: src/data/clinic.js:66
msgctxt "text:clinicComplaints.lunar-overload.name"
msgid "Lunar overload / wavelength desynchrony"
msgstr "Lunar overload / wavelength desynchrony"

#. clinicComplaints.lunar-overload.prompt
#: src/data/clinic.js:67
msgctxt "text:clinicComplaints.lunar-overload.prompt"
msgid ""
"Moonlight is too loud, colours are arguing, or rabbit ears receive "
"broadcasts from the wrong week."
msgstr ""
"Moonlight is too loud, colours are arguing, or rabbit ears receive "
"broadcasts from the wrong week."

#. clinicComplaints.mushroom-exposure.name
#: src/data/clinic.js:76
msgctxt "text:clinicComplaints.mushroom-exposure.name"
msgid "Unknown-mushroom exposure"
msgstr "Unknown-mushroom exposure"

#. clinicComplaints.mushroom-exposure.prompt
#: src/data/clinic.js:77
msgctxt "text:clinicComplaints.mushroom-exposure.prompt"
msgid ""
"The batch is labelled “that basket from the forest,” and each sneeze "
"produces a different element."
msgstr ""
"The batch is labelled “that basket from the forest,” and each sneeze "
"produces a different element."

#. clinicComplaints.flight-strain.name
#: src/data/clinic.js:86
msgctxt "text:clinicComplaints.flight-strain.name"
msgid "Wing / broom-launch strain"
msgstr "Wing / broom-launch strain"

#. clinicComplaints.flight-strain.prompt
#: src/data/clinic.js:87
msgctxt "text:clinicComplaints.flight-strain.prompt"
msgid "Turning remains possible, but Aya has already printed the landing posture as an extra."
msgstr "Turning remains possible, but Aya has already printed the landing posture as an extra."

#. clinicComplaints.phantom-desync.name
#: src/data/clinic.js:96
msgctxt "text:clinicComplaints.phantom-desync.name"
msgid "Phantom desynchrony / duplicate half-phantom check-in"
msgstr "Phantom desynchrony / duplicate half-phantom check-in"

#. clinicComplaints.phantom-desync.prompt
#: src/data/clinic.js:97
msgctxt "text:clinicComplaints.phantom-desync.prompt"
msgid "The body says it has arrived while the half-phantom token remains en route."
msgstr "The body says it has arrived while the half-phantom token remains en route."

#. clinicComplaints.fairy-core-flicker.name
#: src/data/clinic.js:106
msgctxt "text:clinicComplaints.fairy-core-flicker.name"
msgid "Fairy-core flicker / local season pause"
msgstr "Fairy-core flicker / local season pause"

#. clinicComplaints.fairy-core-flicker.prompt
#: src/data/clinic.js:107
msgctxt "text:clinicComplaints.fairy-core-flicker.prompt"
msgid "Nearby flowers cannot decide the season, and wing transparency is not intentional."
msgstr "Nearby flowers cannot decide the season, and wing transparency is not intentional."

#. clinicMedicines.hakurei-seal-patch.name
#: src/data/clinic.js:118
msgctxt "text:clinicMedicines.hakurei-seal-patch.name"
msgid "Hakurei Stop-Sign Patch"
msgstr "Hakurei Stop-Sign Patch"

#. clinicMedicines.hakurei-seal-patch.maker
#: src/data/clinic.js:119
msgctxt "text:clinicMedicines.hakurei-seal-patch.maker"
msgid "Supplied by Hakurei Shrine; hand-cut beside the offering box"
msgstr "Supplied by Hakurei Shrine; hand-cut beside the offering box"

#. clinicMedicines.hakurei-seal-patch.indication
#: src/data/clinic.js:120
msgctxt "text:clinicMedicines.hakurei-seal-patch.indication"
msgid "Glowing abrasions, mild talisman residue, and small seasonal leaks around a fairy core."
msgstr "Glowing abrasions, mild talisman residue, and small seasonal leaks around a fairy core."

#. clinicMedicines.hakurei-seal-patch.directions
#: src/data/clinic.js:121
msgctxt "text:clinicMedicines.hakurei-seal-patch.directions"
msgid ""
"Apply until the glow admits it has been noticed; inspect once per bell and "
"remove after three."
msgstr ""
"Apply until the glow admits it has been noticed; inspect once per bell and "
"remove after three."

#. clinicMedicines.hakurei-seal-patch.caution
#: src/data/clinic.js:122
msgctxt "text:clinicMedicines.hakurei-seal-patch.caution"
msgid "“Great Fortune” is not a potency grade; Reimu does not refund blurred ink."
msgstr "“Great Fortune” is not a potency grade; Reimu does not refund blurred ink."

#. clinicMedicines.magic-diversion-powder.name
#: src/data/clinic.js:130
msgctxt "text:clinicMedicines.magic-diversion-powder.name"
msgid "Yagokoro Magical Diversion Powder"
msgstr "Yagokoro Magical Diversion Powder"

#. clinicMedicines.magic-diversion-powder.maker
#: src/data/clinic.js:131
msgctxt "text:clinicMedicines.magic-diversion-powder.maker"
msgid "Eientei Lunar Pharmacy · Eirin reviewed"
msgstr "Eientei Lunar Pharmacy · Eirin reviewed"

#. clinicMedicines.magic-diversion-powder.indication
#: src/data/clinic.js:132
msgctxt "text:clinicMedicines.magic-diversion-powder.indication"
msgid "Magic returning through hair, sleeves, or equipment grounding after a spell ends."
msgstr "Magic returning through hair, sleeves, or equipment grounding after a spell ends."

#. clinicMedicines.magic-diversion-powder.directions
#: src/data/clinic.js:133
msgctxt "text:clinicMedicines.magic-diversion-powder.directions"
msgid ""
"One non-conductive bamboo spoon with unenchanted warm water; do not restart "
"the same spell for four class breaks."
msgstr ""
"One non-conductive bamboo spoon with unenchanted warm water; do not restart "
"the same spell for four class breaks."

#. clinicMedicines.magic-diversion-powder.caution
#: src/data/clinic.js:134
msgctxt "text:clinicMedicines.magic-diversion-powder.caution"
msgid "Carrying it beside a hakkero treats the medicine bag before it treats you."
msgstr "Carrying it beside a hakkero treats the medicine bag before it treats you."

#. clinicMedicines.seven-day-cooling-ampoule.name
#: src/data/clinic.js:142
msgctxt "text:clinicMedicines.seven-day-cooling-ampoule.name"
msgid "Seven-Day Residual-Heat Ampoule"
msgstr "Seven-Day Residual-Heat Ampoule"

#. clinicMedicines.seven-day-cooling-ampoule.maker
#: src/data/clinic.js:143
msgctxt "text:clinicMedicines.seven-day-cooling-ampoule.maker"
msgid ""
"Jointly prepared by Seven-Day Laboratory and the hospital; stoppers "
"inventoried by Koakuma"
msgstr ""
"Jointly prepared by Seven-Day Laboratory and the hospital; stoppers "
"inventoried by Koakuma"

#. clinicMedicines.seven-day-cooling-ampoule.indication
#: src/data/clinic.js:144
msgctxt "text:clinicMedicines.seven-day-cooling-ampoule.indication"
msgid ""
"Residual elemental heat, local fire/water/wood cycling after mushroom "
"sneezes, and self-igniting appendices."
msgstr ""
"Residual elemental heat, local fire/water/wood cycling after mushroom "
"sneezes, and self-igniting appendices."

#. clinicMedicines.seven-day-cooling-ampoule.directions
#: src/data/clinic.js:145
msgctxt "text:clinicMedicines.seven-day-cooling-ampoule.directions"
msgid ""
"Snap one open a lecture-sheet away from the heat source; do not drink the "
"blue Tuesday vial."
msgstr ""
"Snap one open a lecture-sheet away from the heat source; do not drink the "
"blue Tuesday vial."

#. clinicMedicines.seven-day-cooling-ampoule.caution
#: src/data/clinic.js:146
msgctxt "text:clinicMedicines.seven-day-cooling-ampoule.caution"
msgid "If the bottle shows an eighth day, return it to Patchouli without adding a date."
msgstr "If the bottle shows an eighth day, return it to Patchouli without adding a date."

#. clinicMedicines.boundary-motion-slip.name
#: src/data/clinic.js:154
msgctxt "text:clinicMedicines.boundary-motion-slip.name"
msgid "Boundary Motion-Anchor Slip"
msgstr "Boundary Motion-Anchor Slip"

#. clinicMedicines.boundary-motion-slip.maker
#: src/data/clinic.js:155
msgctxt "text:clinicMedicines.boundary-motion-slip.maker"
msgid "Eientei clinical wing; Hieda Hall supplies yesterday and today editions"
msgstr "Eientei clinical wing; Hieda Hall supplies yesterday and today editions"

#. clinicMedicines.boundary-motion-slip.indication
#: src/data/clinic.js:156
msgctxt "text:clinicMedicines.boundary-motion-slip.indication"
msgid "Short-range anchoring when doors, stairs, dates, or the patient arrive out of order."
msgstr "Short-range anchoring when doors, stairs, dates, or the patient arrive out of order."

#. clinicMedicines.boundary-motion-slip.directions
#: src/data/clinic.js:157
msgctxt "text:clinicMedicines.boundary-motion-slip.directions"
msgid ""
"Write today’s date and toe direction on a floor known to exist; carry "
"through five corners."
msgstr ""
"Write today’s date and toe direction on a floor known to exist; carry "
"through five corners."

#. clinicMedicines.boundary-motion-slip.caution
#: src/data/clinic.js:158
msgctxt "text:clinicMedicines.boundary-motion-slip.caution"
msgid ""
"Yukari’s signature proves only that she saw the slip, not that the location "
"is more reliable."
msgstr ""
"Yukari’s signature proves only that she saw the slip, not that the location "
"is more reliable."

#. clinicMedicines.bamboo-return-tea.name
#: src/data/clinic.js:166
msgctxt "text:clinicMedicines.bamboo-return-tea.name"
msgid "Bamboo-Dew Return Tea"
msgstr "Bamboo-Dew Return Tea"

#. clinicMedicines.bamboo-return-tea.maker
#: src/data/clinic.js:167
msgctxt "text:clinicMedicines.bamboo-return-tea.maker"
msgid "Second kettle behind the east-gate rabbit-shuttle shelter"
msgstr "Second kettle behind the east-gate rabbit-shuttle shelter"

#. clinicMedicines.bamboo-return-tea.indication
#: src/data/clinic.js:168
msgctxt "text:clinicMedicines.bamboo-return-tea.indication"
msgid ""
"Passing one lantern three times, having your sense of direction outvoted by "
"bamboo, or finding the signpost more tired than you."
msgstr ""
"Passing one lantern three times, having your sense of direction outvoted by "
"bamboo, or finding the signpost more tired than you."

#. clinicMedicines.bamboo-return-tea.directions
#: src/data/clinic.js:169
msgctxt "text:clinicMedicines.bamboo-return-tea.directions"
msgid ""
"Drink half a cup facing true east; if east is unknown, follow the medicine "
"scent and do not ask Tewi."
msgstr ""
"Drink half a cup facing true east; if east is unknown, follow the medicine "
"scent and do not ask Tewi."

#. clinicMedicines.bamboo-return-tea.caution
#: src/data/clinic.js:170
msgctxt "text:clinicMedicines.bamboo-return-tea.caution"
msgid "The shortcut seen afterward may not be shorter, but usually reaches whoever needs you."
msgstr "The shortcut seen afterward may not be shorter, but usually reaches whoever needs you."

#. clinicMedicines.moon-dust-eye-drops.name
#: src/data/clinic.js:178
msgctxt "text:clinicMedicines.moon-dust-eye-drops.name"
msgid "Lunar-Dust Isolation Drops"
msgstr "Lunar-Dust Isolation Drops"

#. clinicMedicines.moon-dust-eye-drops.maker
#: src/data/clinic.js:179
msgctxt "text:clinicMedicines.moon-dust-eye-drops.maker"
msgid "Lunar Pharmacy · fourth cold-store shelf (not the Hourai compartment)"
msgstr "Lunar Pharmacy · fourth cold-store shelf (not the Hourai compartment)"

#. clinicMedicines.moon-dust-eye-drops.indication
#: src/data/clinic.js:180
msgctxt "text:clinicMedicines.moon-dust-eye-drops.indication"
msgid ""
"Moonlight that is too loud, star-point afterimages, and unapproved silver "
"lingering after full moon."
msgstr ""
"Moonlight that is too loud, star-point afterimages, and unapproved silver "
"lingering after full moon."

#. clinicMedicines.moon-dust-eye-drops.directions
#: src/data/clinic.js:181
msgctxt "text:clinicMedicines.moon-dust-eye-drops.directions"
msgid ""
"One drop at a time; close eyes until the next non-prime-numbered bell. Four "
"doses form one course."
msgstr ""
"One drop at a time; close eyes until the next non-prime-numbered bell. Four "
"doses form one course."

#. clinicMedicines.moon-dust-eye-drops.caution
#: src/data/clinic.js:182
msgctxt "text:clinicMedicines.moon-dust-eye-drops.caution"
msgid "A telescope is not a dropper; the astronomy club has received three written notices."
msgstr "A telescope is not a dropper; the astronomy club has received three written notices."

#. clinicMedicines.reisen-calibration-drop.name
#: src/data/clinic.js:190
msgctxt "text:clinicMedicines.reisen-calibration-drop.name"
msgid "Reisen Wavelength Calibration Drop"
msgstr "Reisen Wavelength Calibration Drop"

#. clinicMedicines.reisen-calibration-drop.maker
#: src/data/clinic.js:191
msgctxt "text:clinicMedicines.reisen-calibration-drop.maker"
msgid "Reisen formula; count before signing for any batch handled by Tewi"
msgstr "Reisen formula; count before signing for any batch handled by Tewi"

#. clinicMedicines.reisen-calibration-drop.indication
#: src/data/clinic.js:192
msgctxt "text:clinicMedicines.reisen-calibration-drop.indication"
msgid ""
"Colours interrupting one another, rabbit ears receiving the wrong week, or "
"gaze and trajectory disagreeing."
msgstr ""
"Colours interrupting one another, rabbit ears receiving the wrong week, or "
"gaze and trajectory disagreeing."

#. clinicMedicines.reisen-calibration-drop.directions
#: src/data/clinic.js:193
msgctxt "text:clinicMedicines.reisen-calibration-drop.directions"
msgid ""
"Dissolve until sourness and red reach an agreement; pause wavelength danmaku "
"during three calibrations."
msgstr ""
"Dissolve until sourness and red reach an agreement; pause wavelength danmaku "
"during three calibrations."

#. clinicMedicines.reisen-calibration-drop.caution
#: src/data/clinic.js:194
msgctxt "text:clinicMedicines.reisen-calibration-drop.caution"
msgid ""
"May briefly reveal, with excessive honesty, the distance between a headline "
"and its article."
msgstr ""
"May briefly reveal, with excessive honesty, the distance between a headline "
"and its article."

#. clinicMedicines.spore-truth-syrup.name
#: src/data/clinic.js:202
msgctxt "text:clinicMedicines.spore-truth-syrup.name"
msgid "Mushroom Batch-Confession Syrup"
msgstr "Mushroom Batch-Confession Syrup"

#. clinicMedicines.spore-truth-syrup.maker
#: src/data/clinic.js:203
msgctxt "text:clinicMedicines.spore-truth-syrup.maker"
msgid "Eientei Pharmacy; Marisa is still submitting the ingredient labels"
msgstr "Eientei Pharmacy; Marisa is still submitting the ingredient labels"

#. clinicMedicines.spore-truth-syrup.indication
#: src/data/clinic.js:204
msgctxt "text:clinicMedicines.spore-truth-syrup.indication"
msgid ""
"Elemental sneezes, hat-brim spore rain, and a newly added forest in memory "
"after unknown mushrooms."
msgstr ""
"Elemental sneezes, hat-brim spore rain, and a newly added forest in memory "
"after unknown mushrooms."

#. clinicMedicines.spore-truth-syrup.directions
#: src/data/clinic.js:205
msgctxt "text:clinicMedicines.spore-truth-syrup.directions"
msgid ""
"One bamboo segment per dose; state known material provenance first, or let "
"the pharmacist record “unknown.”"
msgstr ""
"One bamboo segment per dose; state known material provenance first, or let "
"the pharmacist record “unknown.”"

#. clinicMedicines.spore-truth-syrup.caution
#: src/data/clinic.js:206
msgctxt "text:clinicMedicines.spore-truth-syrup.caution"
msgid "Does not compel truth; it merely makes the mushroom smell difficult to deny."
msgstr "Does not compel truth; it merely makes the mushroom smell difficult to deny."

#. clinicMedicines.kappa-joint-salve.name
#: src/data/clinic.js:214
msgctxt "text:clinicMedicines.kappa-joint-salve.name"
msgid "Kappa Waterproof Joint Salve"
msgstr "Kappa Waterproof Joint Salve"

#. clinicMedicines.kappa-joint-salve.maker
#: src/data/clinic.js:215
msgctxt "text:clinicMedicines.kappa-joint-salve.maker"
msgid "Kappa Joint Workshop medical line; the lid still uses tape as its final quality seal"
msgstr "Kappa Joint Workshop medical line; the lid still uses tape as its final quality seal"

#. clinicMedicines.kappa-joint-salve.indication
#: src/data/clinic.js:216
msgctxt "text:clinicMedicines.kappa-joint-salve.indication"
msgid ""
"Wing roots, broom-launch muscles, ordinary shoulders, and ordinary shoulders "
"strained while fixing equipment."
msgstr ""
"Wing roots, broom-launch muscles, ordinary shoulders, and ordinary shoulders "
"strained while fixing equipment."

#. clinicMedicines.kappa-joint-salve.directions
#: src/data/clinic.js:217
msgctxt "text:clinicMedicines.kappa-joint-salve.directions"
msgid ""
"Apply thinly and wait for the tape smell to fade; check range of motion "
"around four practice sessions."
msgstr ""
"Apply thinly and wait for the tape smell to fade; check range of motion "
"around four practice sessions."

#. clinicMedicines.kappa-joint-salve.caution
#: src/data/clinic.js:218
msgctxt "text:clinicMedicines.kappa-joint-salve.caution"
msgid ""
"Works suspiciously well on mechanical joints; prosthetic users should ask "
"Nitori whether the jar is actually machine oil."
msgstr ""
"Works suspiciously well on mechanical joints; prosthetic users should ask "
"Nitori whether the jar is actually machine oil."

#. clinicMedicines.tengu-tailwind-tape.name
#: src/data/clinic.js:226
msgctxt "text:clinicMedicines.tengu-tailwind-tape.name"
msgid "Tengu Headwind Muscle Tape"
msgstr "Tengu Headwind Muscle Tape"

#. clinicMedicines.tengu-tailwind-tape.maker
#: src/data/clinic.js:227
msgctxt "text:clinicMedicines.tengu-tailwind-tape.maker"
msgid "Youkai Mountain sports-medicine class; Aya turned the caution into a subheadline"
msgstr "Youkai Mountain sports-medicine class; Aya turned the caution into a subheadline"

#. clinicMedicines.tengu-tailwind-tape.indication
#: src/data/clinic.js:228
msgctxt "text:clinicMedicines.tengu-tailwind-tape.indication"
msgid ""
"Wing-back and shoulder-girdle strain after sharp turns, diving interviews, "
"or emergency broom braking."
msgstr ""
"Wing-back and shoulder-girdle strain after sharp turns, diving interviews, "
"or emergency broom braking."

#. clinicMedicines.tengu-tailwind-tape.directions
#: src/data/clinic.js:229
msgctxt "text:clinicMedicines.tengu-tailwind-tape.directions"
msgid ""
"Apply three strips facing the headwind; same-day return is limited to low "
"straight flight, with no exclusive-story dives."
msgstr ""
"Apply three strips facing the headwind; same-day return is limited to low "
"straight flight, with no exclusive-story dives."

#. clinicMedicines.tengu-tailwind-tape.caution
#: src/data/clinic.js:230
msgctxt "text:clinicMedicines.tengu-tailwind-tape.caution"
msgid "Arranging it as an arrow does not void a flight ban; it only helps patrols find you."
msgstr "Arranging it as an arrow does not void a flight ban; it only helps patrols find you."

#. clinicMedicines.phantom-position-thread.name
#: src/data/clinic.js:238
msgctxt "text:clinicMedicines.phantom-position-thread.name"
msgid "Half-Phantom Positioning Thread"
msgstr "Half-Phantom Positioning Thread"

#. clinicMedicines.phantom-position-thread.maker
#: src/data/clinic.js:239
msgctxt "text:clinicMedicines.phantom-position-thread.maker"
msgid "Eientei Cross-Species Clinic; Youmu supplied the post-use knot"
