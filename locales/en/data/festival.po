msgstr "Cut three ribbons facing different directions"

#. festivalIncidentPool.0.gate-claimants.responses.yukari-gate.label
#: src/data/festival.js:479
msgctxt "text:festivalIncidentPool.0.gate-claimants.responses.yukari-gate.label"
