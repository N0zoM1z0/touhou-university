msgid "The fairies say the venue moved first and they faithfully stayed inside it."
msgstr "The fairies say the venue moved first and they faithfully stayed inside it."

#. festivalIncidentPool.0.fairy-lantern-drift.responses.widen-exit.label
#: src/data/festival.js:377
msgctxt "text:festivalIncidentPool.0.fairy-lantern-drift.responses.widen-exit.label"
msgid "Pause the main stage and widen the physical exit"
msgstr "Pause the main stage and widen the physical exit"

#. festivalIncidentPool.0.fairy-lantern-drift.responses.parade-cloud.label
#: src/data/festival.js:382
msgctxt "text:festivalIncidentPool.0.fairy-lantern-drift.responses.parade-cloud.label"
msgid "Reclassify the drift as an impromptu parade with two guides"
msgstr "Reclassify the drift as an impromptu parade with two guides"

#. festivalIncidentPool.0.fairy-lantern-drift.responses.ring-recall.label
#: src/data/festival.js:387
msgctxt "text:festivalIncidentPool.0.fairy-lantern-drift.responses.ring-recall.label"
msgid "Ring the recall bell and admit only thirty percent of fairies recognise it"
msgstr "Ring the recall bell and admit only thirty percent of fairies recognise it"

#. festivalIncidentPool.0.prismriver-airless-noise.title
#: src/data/festival.js:395
msgctxt "text:festivalIncidentPool.0.prismriver-airless-noise.title"
msgid "Ghost residence files a noise complaint; Prismriver asks whether sound used air"
msgstr "Ghost residence files a noise complaint; Prismriver asks whether sound used air"

#. festivalIncidentPool.0.prismriver-airless-noise.body
#: src/data/festival.js:396
msgctxt "text:festivalIncidentPool.0.prismriver-airless-noise.body"
msgid "No windows vibrate; residents' dreams and photographs inside the walls keep time."
msgstr "No windows vibrate; residents' dreams and photographs inside the walls keep time."

#. festivalIncidentPool.0.prismriver-airless-noise.responses.end-encore.label
#: src/data/festival.js:400
msgctxt "text:festivalIncidentPool.0.prismriver-airless-noise.responses.end-encore.label"
msgid "End the encore and list unplayed pieces for next year"
msgstr "End the encore and list unplayed pieces for next year"

#. festivalIncidentPool.0.prismriver-airless-noise.responses.move-lake.label
#: src/data/festival.js:405
msgctxt "text:festivalIncidentPool.0.prismriver-airless-noise.responses.move-lake.label"
msgid "Move to the lake and ask the library to register the reflected sound"
msgstr "Move to the lake and ask the library to register the reflected sound"

#. festivalIncidentPool.0.prismriver-airless-noise.responses.silent-ruling.label
#: src/data/festival.js:410
msgctxt "text:festivalIncidentPool.0.prismriver-airless-noise.responses.silent-ruling.label"
msgid "Rule that no airborne transmission does not mean no shared burden"
msgstr "Rule that no airborne transmission does not mean no shared burden"

#. festivalIncidentPool.0.full-moon-book-flock.title
#: src/data/festival.js:418
msgctxt "text:festivalIncidentPool.0.full-moon-book-flock.title"
msgid "Full-moon special collections attend the festival; the library wants them counted"
msgstr "Full-moon special collections attend the festival; the library wants them counted"

#. festivalIncidentPool.0.full-moon-book-flock.body
#: src/data/festival.js:419
msgctxt "text:festivalIncidentPool.0.full-moon-book-flock.body"
msgid "Seventeen books form their own programme in the air; none carries a visitor ticket."
msgstr "Seventeen books form their own programme in the air; none carries a visitor ticket."

#. festivalIncidentPool.0.full-moon-book-flock.responses.count-spines.label
#: src/data/festival.js:423
msgctxt "text:festivalIncidentPool.0.full-moon-book-flock.responses.count-spines.label"
msgid "Count every spine toward capacity and open a return lane"
msgstr "Count every spine toward capacity and open a return lane"

#. festivalIncidentPool.0.full-moon-book-flock.responses.performers.label
#: src/data/festival.js:428
msgctxt "text:festivalIncidentPool.0.full-moon-book-flock.responses.performers.label"
msgid "Register them as impromptu performers, outside audience capacity"
msgstr "Register them as impromptu performers, outside audience capacity"

#. festivalIncidentPool.0.full-moon-book-flock.responses.library-recall.label
#: src/data/festival.js:433
msgctxt "text:festivalIncidentPool.0.full-moon-book-flock.responses.library-recall.label"
msgid "Ask the library to issue due notices without promising compliance"
msgstr "Ask the library to issue due notices without promising compliance"

#. festivalIncidentPool.0.rain-border-pocket.title
#: src/data/festival.js:441
msgctxt "text:festivalIncidentPool.0.rain-border-pocket.title"
msgid "Fairy-local rain falls only outside the official wet-weather zone"
msgstr "Fairy-local rain falls only outside the official wet-weather zone"

#. festivalIncidentPool.0.rain-border-pocket.body
#: src/data/festival.js:442
msgctxt "text:festivalIncidentPool.0.rain-border-pocket.body"
msgid ""
"Yukari offers to move “outside”; logistics first wants to know which side "
"contains the tents."
msgstr ""
"Yukari offers to move “outside”; logistics first wants to know which side "
"contains the tents."

#. festivalIncidentPool.0.rain-border-pocket.responses.move-boundary.label
#: src/data/festival.js:446
msgctxt "text:festivalIncidentPool.0.rain-border-pocket.responses.move-boundary.label"
msgid "Move the wet-weather boundary, not the audience"
msgstr "Move the wet-weather boundary, not the audience"

#. festivalIncidentPool.0.rain-border-pocket.responses.paper-capes.label
#: src/data/festival.js:451
msgctxt "text:festivalIncidentPool.0.rain-border-pocket.responses.paper-capes.label"
msgid "Issue campus-paper rain capes; Aya reserves the readable front page"
msgstr "Issue campus-paper rain capes; Aya reserves the readable front page"

#. festivalIncidentPool.0.rain-border-pocket.responses.pause-lanterns.label
#: src/data/festival.js:456
msgctxt "text:festivalIncidentPool.0.rain-border-pocket.responses.pause-lanterns.label"
msgid "Pause lanterns for one watch until the rain acknowledges the site"
msgstr "Pause lanterns for one watch until the rain acknowledges the site"

#. festivalIncidentPool.0.gate-claimants.title
#: src/data/festival.js:464
msgctxt "text:festivalIncidentPool.0.gate-claimants.title"
