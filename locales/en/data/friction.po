#. faithFaculty.byakuren.name
#: src/data/friction.js:87
msgctxt "text:faithFaculty.byakuren.name"
msgid "Byakuren Hijiri"
msgstr "Byakuren Hijiri"

#. faithFaculty.byakuren.role
#: src/data/friction.js:88
msgctxt "text:faithFaculty.byakuren.role"
msgid "Professor of Religious Coexistence & Temple Public Life"
msgstr "Professor of Religious Coexistence & Temple Public Life"

#. faithFaculty.byakuren.summary
#: src/data/friction.js:89
msgctxt "text:faithFaculty.byakuren.summary"
msgid ""
"She argues that humans and youkai can share one table, while insisting that "
"welcome does not make the temple serve every convenience. Courses co-taught "
"with Miko usually change title three times before opening."
msgstr ""
"She argues that humans and youkai can share one table, while insisting that "
"welcome does not make the temple serve every convenience. Courses co-taught "
"with Miko usually change title three times before opening."

#. faithFaculty.byakuren.course
#: src/data/friction.js:90
msgctxt "text:faithFaculty.byakuren.course"
msgid "FCP-214 Temples, Youkai & Arguments After Supper"
msgstr "FCP-214 Temples, Youkai & Arguments After Supper"

#. faithFaculty.byakuren.tension
#: src/data/friction.js:91
msgctxt "text:faithFaculty.byakuren.tension"
msgid "Refuses to turn coexistence into a slogan—or let admissions use temple rites as scenery."
msgstr "Refuses to turn coexistence into a slogan—or let admissions use temple rites as scenery."

#. faithFaculty.kanako.name
#: src/data/friction.js:95
msgctxt "text:faithFaculty.kanako.name"
msgid "Kanako Yasaka"
msgstr "Kanako Yasaka"

#. faithFaculty.kanako.role
#: src/data/friction.js:96
msgctxt "text:faithFaculty.kanako.role"
msgid "Professor of Faith Infrastructure & Public Works"
msgstr "Professor of Faith Infrastructure & Public Works"

#. faithFaculty.kanako.summary
#: src/data/friction.js:97
msgctxt "text:faithFaculty.kanako.summary"
msgid ""
"She brings ropeway, water, and festival-flow plans to class and writes "
"objections straight into version two. The problem is that version one is "
"often already under construction; Kappa Engineering calls it “preliminary "
"research with divine-speed decisions.”"
msgstr ""
"She brings ropeway, water, and festival-flow plans to class and writes "
"objections straight into version two. The problem is that version one is "
"often already under construction; Kappa Engineering calls it “preliminary "
"research with divine-speed decisions.”"

#. faithFaculty.kanako.course
#: src/data/friction.js:98
msgctxt "text:faithFaculty.kanako.course"
msgid "FCP-241 Faith Economies & Projects That Won't Wait for Budget"
msgstr "FCP-241 Faith Economies & Projects That Won't Wait for Budget"

#. faithFaculty.kanako.tension
#: src/data/friction.js:99
msgctxt "text:faithFaculty.kanako.tension"
msgid ""
"Asks every tradition to prove it can survive; colleagues ask her not to "
"build the proof as a ropeway first."
msgstr ""
"Asks every tradition to prove it can survive; colleagues ask her not to "
"build the proof as a ropeway first."

#. faithFaculty.miko.name
#: src/data/friction.js:103
msgctxt "text:faithFaculty.miko.name"
msgid "Toyosatomimi no Miko"
msgstr "Toyosatomimi no Miko"

#. faithFaculty.miko.role
#: src/data/friction.js:104
msgctxt "text:faithFaculty.miko.role"
msgid "Professor of Public Desire, Representation & Leadership"
msgstr "Professor of Public Desire, Representation & Leadership"

#. faithFaculty.miko.summary
#: src/data/friction.js:105
msgctxt "text:faithFaculty.miko.summary"
msgid ""
"She can hear ten desires at once and produce an elegant summary before "
"person eleven speaks. The key assignment is not to be heard, but to rebut "
"that too-perfect summary line by line."
msgstr ""
"She can hear ten desires at once and produce an elegant summary before "
"person eleven speaks. The key assignment is not to be heard, but to rebut "
"that too-perfect summary line by line."

#. faithFaculty.miko.course
#: src/data/friction.js:106
msgctxt "text:faithFaculty.miko.course"
msgid "FCP-266 Hearing Ten People Is Not Representing Ten People"
msgstr "FCP-266 Hearing Ten People Is Not Representing Ten People"

#. faithFaculty.miko.tension
#: src/data/friction.js:107
msgctxt "text:faithFaculty.miko.tension"
msgid ""
"She genuinely revises a judgment—but usually only after someone proves in "
"public that she judged too quickly."
msgstr ""
"She genuinely revises a judgment—but usually only after someone proves in "
"public that she judged too quickly."

#. faithFaculty.sanae.name
#: src/data/friction.js:111
msgctxt "text:faithFaculty.sanae.name"
msgid "Sanae Kochiya"
msgstr "Sanae Kochiya"

#. faithFaculty.sanae.role
#: src/data/friction.js:112
msgctxt "text:faithFaculty.sanae.role"
msgid "Lecturer in Festival Design & Outside-World Translation"
msgstr "Lecturer in Festival Design & Outside-World Translation"

#. faithFaculty.sanae.summary
#: src/data/friction.js:113
msgctxt "text:faithFaculty.sanae.summary"
msgid ""
"She makes spreadsheets, borrows loudspeakers, paints queue lines, and "
"cheerfully promises that “Outside universities all do this.” When they do "
"not, she posts an earnest correction—then immediately proposes a larger "
"miracle demonstration."
msgstr ""
"She makes spreadsheets, borrows loudspeakers, paints queue lines, and "
"cheerfully promises that “Outside universities all do this.” When they do "
"not, she posts an earnest correction—then immediately proposes a larger "
"miracle demonstration."

#. faithFaculty.sanae.course
#: src/data/friction.js:114
msgctxt "text:faithFaculty.sanae.course"
msgid "FCP-118 Miracles, Megaphones & Rain-Smeared Run Sheets"
msgstr "FCP-118 Miracles, Megaphones & Rain-Smeared Run Sheets"

#. faithFaculty.sanae.tension
#: src/data/friction.js:115
msgctxt "text:faithFaculty.sanae.tension"
msgid ""
"She gets four religious blocs to meetings on time; each bloc thinks "
"punctuality is a special demand placed only on them."
msgstr ""
"She gets four religious blocs to meetings on time; each bloc thinks "
"punctuality is a special demand placed only on them."

#. faithReview.name
#: src/data/friction.js:120
msgctxt "text:faithReview.name"
msgid "Eiki Shiki, Yamaxanadu"
msgstr "Eiki Shiki, Yamaxanadu"

#. faithReview.role
#: src/data/friction.js:121
msgctxt "text:faithReview.role"
msgid "External appeals examiner · visits on the last Higan day each month"
msgstr "External appeals examiner · visits on the last Higan day each month"

#. faithReview.note
#: src/data/friction.js:122
msgctxt "text:faithReview.note"
msgid ""
"She does not mediate doctrine; she separates action, reason, and consequence "
"into three columns. Last month's longest ruling was one sentence: “Every "
"side failed to hear one person.”"
msgstr ""
"She does not mediate doctrine; she separates action, reason, and consequence "
"into three columns. Last month's longest ruling was one sentence: “Every "
"side failed to hear one person.”"
