msgctxt "text:advancedGaokaoQuestions.mathematics.5.LU-M03.5.3"
msgid "Indeterminate"
msgstr "Indeterminate"

#. advancedGaokaoQuestions.mathematics.5.LU-M03.7
#: src/data/gaokao-advanced.js:165
msgctxt "text:advancedGaokaoQuestions.mathematics.5.LU-M03.7"
msgid "σ⁵=σ² sends A→C; τ then sends C→B, so the final label is B."
msgstr "σ⁵=σ² sends A→C; τ then sends C→B, so the final label is B."

#. advancedGaokaoQuestions.mathematics.6.EX-M01.3
#: src/data/gaokao-advanced.js:169
msgctxt "text:advancedGaokaoQuestions.mathematics.6.EX-M01.3"
msgid ""
"From 08:00: G–B=8; B–E=12 (entry only during minutes 10–19 each hour); "
"G–W=5; W–E=9 (at full moon, entry closed on odd-numbered minutes); G–E=30. "
"Waiting is allowed. Depart G at 08:07:30; round arrivals up to a whole "
"minute before testing entry."
msgstr ""
"From 08:00: G–B=8; B–E=12 (entry only during minutes 10–19 each hour); "
"G–W=5; W–E=9 (at full moon, entry closed on odd-numbered minutes); G–E=30. "
"Waiting is allowed. Depart G at 08:07:30; round arrivals up to a whole "
"minute before testing entry."

