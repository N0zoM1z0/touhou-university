#. gaokaoSubjects.language.name
#: src/data/gaokao.js:16
msgctxt "text:gaokaoSubjects.language.name"
msgid "Gensokyo Language & Letters"
msgstr "Gensokyo Language & Letters"

#. gaokaoSubjects.language.note
#: src/data/gaokao.js:17
msgctxt "text:gaokaoSubjects.language.note"
msgid "Reading, source expression, notices, and news rhetoric"
msgstr "Reading, source expression, notices, and news rhetoric"

#. gaokaoSubjects.language.questions.0.L01.2
#: src/data/gaokao.js:21
msgctxt "text:gaokaoSubjects.language.questions.0.L01.2"
msgid ""
"The paper first reports “North windway permanently repaired,” then corrects "
"it to “kappa tape still counts as temporary.” What does the correction "
"chiefly restore?"
msgstr ""
"The paper first reports “North windway permanently repaired,” then corrects "
"it to “kappa tape still counts as temporary.” What does the correction "
"chiefly restore?"

#. gaokaoSubjects.language.questions.0.L01.3.0
#: src/data/gaokao.js:22
msgctxt "text:gaokaoSubjects.language.questions.0.L01.3.0"
msgid "A more cautious tone for “permanent,” without changing the access judgment"
msgstr "A more cautious tone for “permanent,” without changing the access judgment"

#. gaokaoSubjects.language.questions.0.L01.3.1
#: src/data/gaokao.js:22
msgctxt "text:gaokaoSubjects.language.questions.0.L01.3.1"
msgid "The repair status and the standard used to classify it"
msgstr "The repair status and the standard used to classify it"

#. gaokaoSubjects.language.questions.0.L01.3.2
#: src/data/gaokao.js:22
msgctxt "text:gaokaoSubjects.language.questions.0.L01.3.2"
msgid "The tape's material name, without stating whether passage is currently allowed"
msgstr "The tape's material name, without stating whether passage is currently allowed"

#. gaokaoSubjects.language.questions.0.L01.3.3
#: src/data/gaokao.js:22
msgctxt "text:gaokaoSubjects.language.questions.0.L01.3.3"
msgid "The publication sequence, without correcting the permanent–temporary distinction"
msgstr "The publication sequence, without correcting the permanent–temporary distinction"

#. gaokaoSubjects.language.questions.0.L01.5
#: src/data/gaokao.js:23
msgctxt "text:gaokaoSubjects.language.questions.0.L01.5"
msgid ""
"The changed fact is whether the repair is permanent or temporary, which "
"affects travel and risk decisions."
msgstr ""
"The changed fact is whether the repair is permanent or temporary, which "
"affects travel and risk decisions."

#. gaokaoSubjects.language.questions.1.L02.2
#: src/data/gaokao.js:27
msgctxt "text:gaokaoSubjects.language.questions.1.L02.2"
msgid ""
"A bamboo notice says: “Do not stop at the second identical meeting point; it "
"is last week's.” What is the soundest reading?"
msgstr ""
"A bamboo notice says: “Do not stop at the second identical meeting point; it "
"is last week's.” What is the soundest reading?"

#. gaokaoSubjects.language.questions.1.L02.3.0
#: src/data/gaokao.js:28
msgctxt "text:gaokaoSubjects.language.questions.1.L02.3.0"
msgid "Because they look identical, treat the later one as a reserve meeting point"
msgstr "Because they look identical, treat the later one as a reserve meeting point"

#. gaokaoSubjects.language.questions.1.L02.3.1
#: src/data/gaokao.js:28
msgctxt "text:gaokaoSubjects.language.questions.1.L02.3.1"
msgid "Route identification must check both spatial position and associated time"
msgstr "Route identification must check both spatial position and associated time"

#. gaokaoSubjects.language.questions.1.L02.3.2
#: src/data/gaokao.js:28
msgctxt "text:gaokaoSubjects.language.questions.1.L02.3.2"
msgid "“Second” means the traveller overshot and should return to the first point"
msgstr "“Second” means the traveller overshot and should return to the first point"

#. gaokaoSubjects.language.questions.1.L02.3.3
#: src/data/gaokao.js:28
msgctxt "text:gaokaoSubjects.language.questions.1.L02.3.3"
msgid "“Last week's” dates the notice and does not affect the point now in view"
msgstr "“Last week's” dates the notice and does not affect the point now in view"

#. gaokaoSubjects.language.questions.1.L02.5
#: src/data/gaokao.js:29
msgctxt "text:gaokaoSubjects.language.questions.1.L02.5"
msgid ""
"The notice combines spatial and temporal evidence; identical appearance does "
"not prove identical place."
msgstr ""
"The notice combines spatial and temporal evidence; identical appearance does "
"not prove identical place."

#. gaokaoSubjects.language.questions.2.L03.2
#: src/data/gaokao.js:33
msgctxt "text:gaokaoSubjects.language.questions.2.L03.2"
msgid "Which sentence is best suited to a research field record?"
msgstr "Which sentence is best suited to a research field record?"

#. gaokaoSubjects.language.questions.2.L03.3.0
#: src/data/gaokao.js:34
msgctxt "text:gaokaoSubjects.language.questions.2.L03.3.0"
msgid "Fairies probably extinguished the eastern lamps, because they are usually unreliable"
msgstr "Fairies probably extinguished the eastern lamps, because they are usually unreliable"

#. gaokaoSubjects.language.questions.2.L03.3.1
#: src/data/gaokao.js:34
msgctxt "text:gaokaoSubjects.language.questions.2.L03.3.1"
msgid "After the third bell, two of five eastern lamps went out"
msgstr "After the third bell, two of five eastern lamps went out"

#. gaokaoSubjects.language.questions.2.L03.3.2
#: src/data/gaokao.js:34
msgctxt "text:gaokaoSubjects.language.questions.2.L03.3.2"
msgid "The third bell caused a minor incident and the lighting failure"
msgstr "The third bell caused a minor incident and the lighting failure"

#. gaokaoSubjects.language.questions.2.L03.3.3
#: src/data/gaokao.js:34
msgctxt "text:gaokaoSubjects.language.questions.2.L03.3.3"
msgid "A duty worker says more failed yesterday, so today's condition should count as normal"
msgstr "A duty worker says more failed yesterday, so today's condition should count as normal"

#. gaokaoSubjects.language.questions.2.L03.5
#: src/data/gaokao.js:35
msgctxt "text:gaokaoSubjects.language.questions.2.L03.5"
msgid "It records time, direction, total count, and change, allowing later verification."
msgstr "It records time, direction, total count, and change, allowing later verification."

#. gaokaoSubjects.language.questions.3.L04.2
#: src/data/gaokao.js:39
msgctxt "text:gaokaoSubjects.language.questions.3.L04.2"
msgid "For the same minor incident, which headline least presents conjecture as fact?"
msgstr "For the same minor incident, which headline least presents conjecture as fact?"

#. gaokaoSubjects.language.questions.3.L04.3.0
#: src/data/gaokao.js:40
msgctxt "text:gaokaoSubjects.language.questions.3.L04.3.0"
msgid "Mountain works stop campus clocks; university investigates responsibility"
msgstr "Mountain works stop campus clocks; university investigates responsibility"

#. gaokaoSubjects.language.questions.3.L04.3.1
#: src/data/gaokao.js:40
msgctxt "text:gaokaoSubjects.language.questions.3.L04.3.1"
msgid "Campus clocks stop; cause remains under investigation"
msgstr "Campus clocks stop; cause remains under investigation"

#. gaokaoSubjects.language.questions.3.L04.3.2
#: src/data/gaokao.js:40
msgctxt "text:gaokaoSubjects.language.questions.3.L04.3.2"
msgid "Kappa deny changing time settings, so the university rules out equipment failure"
msgstr "Kappa deny changing time settings, so the university rules out equipment failure"

#. gaokaoSubjects.language.questions.3.L04.3.3
#: src/data/gaokao.js:40
msgctxt "text:gaokaoSubjects.language.questions.3.L04.3.3"
msgid "The stoppage coincides with a Mountain trial, making the works the sole cause"
msgstr "The stoppage coincides with a Mountain trial, making the works the sole cause"

#. gaokaoSubjects.language.questions.3.L04.5
#: src/data/gaokao.js:41
msgctxt "text:gaokaoSubjects.language.questions.3.L04.5"
msgid ""
"The stoppage is observed, while “under investigation” clearly marks the "
"cause as unknown."
msgstr ""
"The stoppage is observed, while “under investigation” clearly marks the "
"cause as unknown."

#. gaokaoSubjects.language.questions.4.L05.2
#: src/data/gaokao.js:45
msgctxt "text:gaokaoSubjects.language.questions.4.L05.2"
msgid ""
"A source reads, “The gate remained but the path was lost; visitors followed "
"the bell.” What does “lost” chiefly mean here?"
msgstr ""
"A source reads, “The gate remained but the path was lost; visitors followed "
"the bell.” What does “lost” chiefly mean here?"

#. gaokaoSubjects.language.questions.4.L05.3.0
#: src/data/gaokao.js:46
msgctxt "text:gaokaoSubjects.language.questions.4.L05.3.0"
msgid "The road was destroyed, forcing visitors to navigate by the bell"
msgstr "The road was destroyed, forcing visitors to navigate by the bell"

#. gaokaoSubjects.language.questions.4.L05.3.1
#: src/data/gaokao.js:46
msgctxt "text:gaokaoSubjects.language.questions.4.L05.3.1"
msgid "The road fled its former place but could still be followed by its traces"
msgstr "The road fled its former place but could still be followed by its traces"

#. gaokaoSubjects.language.questions.4.L05.3.2
#: src/data/gaokao.js:46
msgctxt "text:gaokaoSubjects.language.questions.4.L05.3.2"
msgid "The road vanished and could no longer be followed"
msgstr "The road vanished and could no longer be followed"

#. gaokaoSubjects.language.questions.4.L05.3.3
#: src/data/gaokao.js:46
msgctxt "text:gaokaoSubjects.language.questions.4.L05.3.3"
msgid "The road was lent elsewhere, requiring visitors to wait for its return"
msgstr "The road was lent elsewhere, requiring visitors to wait for its return"

#. gaokaoSubjects.language.questions.4.L05.5
#: src/data/gaokao.js:47
msgctxt "text:gaokaoSubjects.language.questions.4.L05.5"
msgid ""
"The contrast is between a remaining gate and an untraceable path, so the "
"sense is disappearance."
msgstr ""
"The contrast is between a remaining gate and an untraceable path, so the "
"sense is disappearance."

#. gaokaoSubjects.language.questions.5.L06.2
#: src/data/gaokao.js:51
msgctxt "text:gaokaoSubjects.language.questions.5.L06.2"
msgid ""
"Which sequence makes a mistaken campus alert into the most traceable "
"correction? ① impact scope ② preserve original headline ③ identify error ④ "
"give correct information and time"
msgstr ""
"Which sequence makes a mistaken campus alert into the most traceable "
"correction? ① impact scope ② preserve original headline ③ identify error ④ "
"give correct information and time"

#. gaokaoSubjects.language.questions.5.L06.3.0
#: src/data/gaokao.js:52
msgctxt "text:gaokaoSubjects.language.questions.5.L06.3.0"
msgid "②③④①: preserve, identify, give the timed correction, then state scope"
msgstr "②③④①: preserve, identify, give the timed correction, then state scope"

#. gaokaoSubjects.language.questions.5.L06.3.1
#: src/data/gaokao.js:52
msgctxt "text:gaokaoSubjects.language.questions.5.L06.3.1"
msgid "④②①③: publish the new information first and identify the error last"
msgstr "④②①③: publish the new information first and identify the error last"

#. gaokaoSubjects.language.questions.5.L06.3.2
#: src/data/gaokao.js:52
msgctxt "text:gaokaoSubjects.language.questions.5.L06.3.2"
msgid "③①②④: name the error and scope before preserving and correcting"
msgstr "③①②④: name the error and scope before preserving and correcting"

#. gaokaoSubjects.language.questions.5.L06.3.3
#: src/data/gaokao.js:52
msgctxt "text:gaokaoSubjects.language.questions.5.L06.3.3"
msgid "④①③②: give the update and scope now, preserving the original only afterward"
msgstr "④①③②: give the update and scope now, preserving the original only afterward"

#. gaokaoSubjects.language.questions.5.L06.5
#: src/data/gaokao.js:53
msgctxt "text:gaokaoSubjects.language.questions.5.L06.5"
msgid ""
"Preserve the original, identify the error, supply corrected dated "
"information, then state the affected scope."
msgstr ""
"Preserve the original, identify the error, supply corrected dated "
"information, then state the affected scope."

