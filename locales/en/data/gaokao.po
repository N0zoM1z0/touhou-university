#: src/data/gaokao.js:137
msgctxt "text:gaokaoDifficulties.normal.description"
msgid ""
"Foundation · 24 questions. Read the notices, calculate the route, and do not "
"follow the fourth lantern."
msgstr ""
"Foundation · 24 questions. Read the notices, calculate the route, and do not "
"follow the fourth lantern."

#. gaokaoDifficulties.hard.description
#: src/data/gaokao.js:143
msgctxt "text:gaokaoDifficulties.hard.description"
msgid "Source paper · 12 questions. Every item combines at least two records or conditions."
msgstr "Source paper · 12 questions. Every item combines at least two records or conditions."

#. gaokaoDifficulties.lunatic.description
#: src/data/gaokao.js:149
msgctxt "text:gaokaoDifficulties.lunatic.description"
msgid ""
"Cross-source reasoning · 12 questions. Lunar phases, versions, route graphs, "
"and conflicting testimony arrive together."
msgstr ""
"Cross-source reasoning · 12 questions. Lunar phases, versions, route graphs, "
"and conflicting testimony arrive together."

#. gaokaoDifficulties.extra.description
#: src/data/gaokao.js:155
msgctxt "text:gaokaoDifficulties.extra.description"
msgid ""
"Incident paper · 12 questions. Trace data generation, fault timelines, and "
"identifiable causal designs."
msgstr ""
"Incident paper · 12 questions. Trace data generation, fault timelines, and "
"identifiable causal designs."
