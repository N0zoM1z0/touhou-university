msgstr "16"

#. gaokaoSubjects.mathematics.questions.3.M04.3.2
#: src/data/gaokao.js:65
msgctxt "text:gaokaoSubjects.mathematics.questions.3.M04.3.2"
msgid "24"
msgstr "24"

#. gaokaoSubjects.mathematics.questions.3.M04.3.3
#: src/data/gaokao.js:65
msgctxt "text:gaokaoSubjects.mathematics.questions.3.M04.3.3"
msgid "27"
msgstr "27"

#. gaokaoSubjects.mathematics.questions.3.M04.5
#: src/data/gaokao.js:65
msgctxt "text:gaokaoSubjects.mathematics.questions.3.M04.5"
