#. incidentCases.late-bell-seven.location
#: src/data/incidents.js:16
msgctxt "text:incidentCases.late-bell-seven.location"
msgid "Boundary Hall · Bell Tower"
msgstr "Boundary Hall · Bell Tower"

#. incidentCases.late-bell-seven.title
#: src/data/incidents.js:17
msgctxt "text:incidentCases.late-bell-seven.title"
msgid "Seven punctual students heard the latecomer-only bell"
msgstr "Seven punctual students heard the latecomer-only bell"

#. incidentCases.late-bell-seven.lede
#: src/data/incidents.js:18
msgctxt "text:incidentCases.late-bell-seven.lede"
msgid ""
"On the first trial day, the bell should have reached only latecomers. Seven "
"students with punctual records heard the same strike in different places; "
"three then left their next class early."
msgstr ""
"On the first trial day, the bell should have reached only latecomers. Seven "
"students with punctual records heard the same strike in different places; "
"three then left their next class early."

#. incidentCases.late-bell-seven.dispatch
#: src/data/incidents.js:19
msgctxt "text:incidentCases.late-bell-seven.dispatch"
msgid ""
"Automatic judgment is suspended; ordinary timekeeping remains active. Do not "
"be deliberately late for testing."
msgstr ""
"Automatic judgment is suspended; ordinary timekeeping remains active. Do not "
"be deliberately late for testing."

#. incidentCases.late-bell-seven.affected
#: src/data/incidents.js:20
msgctxt "text:incidentCases.late-bell-seven.affected"
