#. copy/title
#: src/js/academic-calendar.js:40
msgctxt "tree:copy#/title"
msgid ""
"Terms have start dates; spring, full moons, and incidents retain the right "
"to arrive off schedule."
msgstr ""
"Terms have start dates; spring, full moons, and incidents retain the right "
"to arrive off schedule."

#. copy/lead
#: src/js/academic-calendar.js:40
msgctxt "tree:copy#/lead"
msgid ""
"This calendar is not a static poster. Season, moon, and date alter classes, "
"facilities, transport, dining, and clinic load. Saving a leaf stores a "
"reminder; it does not pin the world down."
msgstr ""
"This calendar is not a static poster. Season, moon, and date alter classes, "
"facilities, transport, dining, and clinic load. Saving a leaf stores a "
"reminder; it does not pin the world down."

