#: src/js/phantasm-model.js:219
msgctxt "text:governanceFragment.ordinary"
msgid "Ballot"
msgstr "Ballot"

#. governanceFragment.dream
#: src/js/phantasm-model.js:222
msgctxt "text:governanceFragment.dream"
msgid "Passed in shadow"
msgstr "Passed in shadow"

#. incidentFragment.ordinary
#: src/js/phantasm-model.js:242
