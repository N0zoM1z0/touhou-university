#. copy.retain.ruling
#: src/js/phantasm-model.js:403
msgctxt "text:copy.retain.ruling"
msgid ""
"{value0} rules that the untaken route may remain in Dream Campus but may not "
"impersonate an official conclusion."
msgstr ""
"{value0} rules that the untaken route may remain in Dream Campus but may not "
"impersonate an official conclusion."

#. copy.retain.condition
#: src/js/phantasm-model.js:404
msgctxt "text:copy.retain.condition"
msgid "Every citation must show the route actually adopted while awake on the same page."
msgstr "Every citation must show the route actually adopted while awake on the same page."

#. copy.retain.dissent
#: src/js/phantasm-model.js:405
msgctxt "text:copy.retain.dissent"
msgid "Reimu dissents: a route not taken cannot claim travel expenses."
msgstr "Reimu dissents: a route not taken cannot claim travel expenses."

#. copy.conditional.ruling
#: src/js/phantasm-model.js:408
msgctxt "text:copy.conditional.ruling"
msgid ""
"{value0} grants dream-boundary conditional approval: teachable here, never "
"backfilled into official records."
msgstr ""
"{value0} grants dream-boundary conditional approval: teachable here, never "
"backfilled into official records."

#. copy.conditional.condition
#: src/js/phantasm-model.js:409
msgctxt "text:copy.conditional.condition"
msgid ""
"After the bell, explain again why it was not adopted. An identical answer "
"proves you are still dreaming."
msgstr ""
"After the bell, explain again why it was not adopted. An identical answer "
"proves you are still dreaming."

#. copy.conditional.dissent
#: src/js/phantasm-model.js:410
msgctxt "text:copy.conditional.dissent"
msgid "Aya dissents that “conditional” may be added in the extra edition's second printing."
msgstr "Aya dissents that “conditional” may be added in the extra edition's second printing."

#. copy.wake.ruling
#: src/js/phantasm-model.js:413
msgctxt "text:copy.wake.ruling"
msgid ""
"{value0} finds the argument suspiciously tidy and orders one waking before "
"retention is reconsidered."
msgstr ""
"{value0} finds the argument suspiciously tidy and orders one waking before "
"retention is reconsidered."

#. copy.wake.condition
#: src/js/phantasm-model.js:414
msgctxt "text:copy.wake.condition"
msgid ""
"If the route survives waking, add one inconsistent detail on the dream "
"transcript continuation sheet."
msgstr ""
"If the route survives waking, add one inconsistent detail on the dream "
"transcript continuation sheet."

#. copy.wake.dissent
#: src/js/phantasm-model.js:415
msgctxt "text:copy.wake.dissent"
msgid ""
"Doremy dissents that a dream this tidy is probably an administrative form "
"and not worth an appetite."
msgstr ""
"Doremy dissents that a dream this tidy is probably an administrative form "
"and not worth an appetite."

#. assignmentFragment.dream
#: src/js/phantasm-model.js:204
msgctxt "text:assignmentFragment.dream"
msgid ""
"An option you did not write has resubmitted itself for full marks and asks "
"the ordinary answer for a citation."
msgstr ""
"An option you did not write has resubmitted itself for full marks and asks "
"the ordinary answer for a citation."

