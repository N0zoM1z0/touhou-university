msgstr "幽霊・霊体"

#. identityKinds.lunar
#: src/data/mytu.js:9
msgctxt "text:identityKinds.lunar"
msgid "Lunarian / moon rabbit"
msgstr "月人・月兎"

#. identityKinds.other
