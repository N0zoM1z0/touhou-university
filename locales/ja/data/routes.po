#. transportModes.walk.name
#: src/data/routes.js:6
msgctxt "text:transportModes.walk.name"
msgid "Village Walk"
msgstr "里道徒歩"

#. transportModes.walk.summary
#: src/data/routes.js:7
msgctxt "text:transportModes.walk.summary"
msgid "All paths · no waiting"
msgstr "全路網・待ち時間なし"

#. transportModes.walk.notice
#: src/data/routes.js:8
msgctxt "text:transportModes.walk.notice"
msgid ""
"Based on an average human walking pace, with extra time included for "
"mountain and bamboo paths."
msgstr "一般的な人間の歩行速度を基準とし、山道と竹林には余裕時間を加算しています。"

#. transportModes.broom.name
#: src/data/routes.js:12
msgctxt "text:transportModes.broom.name"
msgid "Magic Broom"
msgstr "魔法の箒"

#. transportModes.broom.summary
#: src/data/routes.js:13
msgctxt "text:transportModes.broom.summary"
msgid "Berth airways + walking"
msgstr "駐箒所の空路＋徒歩"

#. transportModes.broom.notice
#: src/data/routes.js:14
msgctxt "text:transportModes.broom.notice"
msgid ""
"Brooms may berth only at Misty Lake, Boundary, Seven-Day, and Youkai "
"Mountain. Low flight is banned at Hakurei Gate, so the last leg may still be "
"on foot."
msgstr "箒の駐機は霧の湖・境界・七曜・妖怪の山のみ。博麗門前は低空飛行禁止のため、最後は歩くことがあります。"

#. transportModes.tengu.name
#: src/data/routes.js:18
msgctxt "text:transportModes.tengu.name"
msgid "Tengu Express Windway"
msgstr "天狗急行風路"

#. transportModes.tengu.summary
#: src/data/routes.js:19
msgctxt "text:transportModes.tengu.summary"
msgid "Fixed wind stops + hourly wait"
msgstr "固定風駅＋毎正時"

#. transportModes.tengu.notice
#: src/data/routes.js:20
msgctxt "text:transportModes.tengu.notice"
msgid ""
"Express windways stop only at Boundary Hall, Hieda Archives, and Youkai "
"Mountain. Do not chase a missed flag unless you want to become tengu news."
msgstr "急行は境界講堂・稗田史料館・妖怪の山のみ停車。旗を逃して追うと、その姿が天狗の記事になります。"

#. transportModes.rabbit.name
#: src/data/routes.js:24
msgctxt "text:transportModes.rabbit.name"
msgid "Moon-Rabbit Shuttle"
msgstr "竹林月兎シャトル"

#. transportModes.rabbit.summary
#: src/data/routes.js:25
msgctxt "text:transportModes.rabbit.summary"
msgid "Boundary Hall / Eientei only"
msgstr "境界講堂／永遠亭のみ"

#. transportModes.rabbit.notice
#: src/data/routes.js:26
msgctxt "text:transportModes.rabbit.notice"
msgid ""
"Rabbit carts run only between Boundary Hall and Eientei Clinic; every other "
"leg is on foot. During emergencies, the timetable pretends it never existed."
msgstr "兎車は境界講堂と永遠亭診療所の往復のみ。ほかは徒歩です。救急時には時刻表が最初から無かったことになります。"

