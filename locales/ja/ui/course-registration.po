#: src/js/course-registration.js:22
msgctxt "tree:copy#/droppedToast"
msgid "Course dropped. The event remains on record but leaves your timetable."
msgstr "履修を取り消しました。出来事は残りますが時間割から外れます。"

#. copy/cancelledToast
#: src/js/course-registration.js:22
msgctxt "tree:copy#/cancelledToast"
