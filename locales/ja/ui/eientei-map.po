msgstr "EIENTEI FOCUS MAP / 永遠亭・迷いの竹林"

#. copy/title
#: src/js/eientei-map.js:27
msgctxt "tree:copy#/title"
msgid "The road exists every day. Its location may not."
msgstr "道は毎日ある。位置は毎日同じとは限らない。"

#. copy/lead
#: src/js/eientei-map.js:27
msgctxt "tree:copy#/lead"
msgid ""
"This detail map follows your device date, time, and lunar phase. Bamboo "
"forks rotate daily; rabbit lamps appear at night; full-moon clinic traffic "
"diverts through the pharmacy."
msgstr "端末の日付・時刻・月相で変化する詳細図。竹林分岐は日替わり、夜は兎灯、満月は調剤室経由の診療動線になります。"

#. copy/back
#: src/js/eientei-map.js:27
msgctxt "tree:copy#/back"
msgid "Back to main campus"
msgstr "メインキャンパスへ"

#. copy/hospital
#: src/js/eientei-map.js:27
msgctxt "tree:copy#/hospital"
msgid "Open hospital triage"
msgstr "校医院トリアージへ"

#. copy/now
