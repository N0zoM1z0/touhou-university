#. copy/eyebrow
#: src/js/employment.js:42
msgctxt "tree:copy#/eyebrow"
msgid "GENSOKYO EMPLOYMENT MARKET / FOR THOSE LEAVING WITH PROBLEMS"
msgstr "GENSOKYO EMPLOYMENT MARKET / 離校後も問題を抱える者へ"

#. copy/title
#: src/js/employment.js:42
msgctxt "tree:copy#/title"
msgid "Find work in Gensokyo."
msgstr "幻想郷で働く。"

#. copy/lead
#: src/js/employment.js:42
msgctxt "tree:copy#/lead"
msgid ""
"Browse twenty-one vacancies, read the conditions, and send an odd résumé. "
"You can also add your whereabouts to the graduate survey."
msgstr "二十一件の求人から条件を比べ、履歴書を送れます。卒業生の進路調査にも参加できます。"

#. copy/jobs
#: src/js/employment.js:42
msgctxt "tree:copy#/jobs"
msgid "notices still hiring"
msgstr "件の募集中掲示"

#. copy/applications
#: src/js/employment.js:42
msgctxt "tree:copy#/applications"
msgid "odd résumés dispatched"
msgstr "通の怪歴書を発送"

#. copy/attestations
#: src/js/employment.js:42
msgctxt "tree:copy#/attestations"
msgid "graduate statements"
msgstr "進路の回答"

