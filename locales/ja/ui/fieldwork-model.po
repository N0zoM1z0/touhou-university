#. fieldworkTravelEstimate.0
#: src/js/fieldwork-model.js:476
msgctxt "text:fieldworkTravelEstimate.0.2"
msgid "Night brooms detour around the patrol edge."
msgstr "夜間山域の箒は巡回外縁へ迂回。"

#. fieldworkTravelEstimate.0
#: src/js/fieldwork-model.js:481
msgctxt "text:fieldworkTravelEstimate.0.3"
