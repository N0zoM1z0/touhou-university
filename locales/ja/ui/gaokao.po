#. copy/eyebrow
#: src/js/gaokao.js:21
msgctxt "tree:copy#/eyebrow"
msgid "UNIFIED EXAMINATION / GENSOKYO UNIFIED EXAM"
msgstr "UNIFIED EXAMINATION / 幻想郷統一高等試験"

#. copy/title
#: src/js/gaokao.js:21
msgctxt "tree:copy#/title"
msgid "NORMAL to EXTRA: four unified papers whose questions truly change."
msgstr "NORMALからEXTRAまで、問題そのものが変わる四つの統一試験。"

#. copy/lead
#: src/js/gaokao.js:21
msgctxt "tree:copy#/lead"
msgid ""
"Humanities and sciences each run at four difficulties. Higher papers combine "
"notices, versions, lunar phases, route graphs, observations, and conflicting "
"testimony."
msgstr "文系・理系それぞれ四難度。語文、境界数学、幻想郷共通常識に加え、高難度では告知版、月相、経路網、観測表、対立証言を同時に扱います。"

#. copy/chooseDifficulty
#: src/js/gaokao.js:21
msgctxt "tree:copy#/chooseDifficulty"
msgid "Choose a danmaku difficulty"
msgstr "弾幕難度を選択"

#. copy/choose
#: src/js/gaokao.js:21
msgctxt "tree:copy#/choose"
msgid "Choose an examination track"
msgstr "受験区分を選択"

#. copy/chooseLead
#: src/js/gaokao.js:21
msgctxt "tree:copy#/chooseLead"
msgid ""
"Four subjects, 150 marks. Printable papers are untimed and work offline or "
"as saved PDFs."
msgstr "各区分4科目・150点満点。紙版は時間制限なしで、オフライン受験・印刷・PDF保存に対応。"

#. copy/start
#: src/js/gaokao.js:21
msgctxt "tree:copy#/start"
msgid "Start online simulation"
msgstr "オンライン模試を開始"

#. copy/resume
#: src/js/gaokao.js:21
msgctxt "tree:copy#/resume"
msgid "Resume unfinished paper"
msgstr "未完了答案を続ける"

#. copy/discard
#: src/js/gaokao.js:21
msgctxt "tree:copy#/discard"
msgid "Discard draft"
msgstr "下書きを破棄"

#. copy/paper
#: src/js/gaokao.js:21
msgctxt "tree:copy#/paper"
