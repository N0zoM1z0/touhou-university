msgstr "端末記録を削除"

#. copy/deleteConfirm
#: src/js/gaokao.js:21
msgctxt "tree:copy#/deleteConfirm"
msgid "Delete this examination record?"
msgstr "この受験記録を削除しますか。"

#. copy/recordDeleted
#: src/js/gaokao.js:21
msgctxt "tree:copy#/recordDeleted"
