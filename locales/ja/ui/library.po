#. copy/identityNeeded
#: src/js/library.js:19
msgctxt "tree:copy#/identityNeeded"
msgid ""
"Create a My TU identity to borrow or place holds. The catalogue remains open "
"to everyone."
msgstr "My TU身分を作成すると貸出・予約できます。検索は自由に利用できます。"

#. copy/createIdentity
#: src/js/library.js:19
msgctxt "tree:copy#/createIdentity"
msgid "Create My TU identity"
msgstr "My TU身分を作成"

#. copy/maxLoans
#: src/js/library.js:19
msgctxt "tree:copy#/maxLoans"
msgid "You may borrow five holdings at once. Return one first."
msgstr "同時貸出は5点までです。先に一冊返却してください。"

#. copy/courseNeeded
#: src/js/library.js:19
msgctxt "tree:copy#/courseNeeded"
msgid "This book clasp accepts only the specified course record."
msgstr "この本の留め具は指定科目の履修記録だけを認めます。"

#. copy/alreadyLoaned
#: src/js/library.js:19
msgctxt "tree:copy#/alreadyLoaned"
msgid "This book is already in your loan bag."
msgstr "この本はすでに貸出袋に入っています。"

#. copy/alreadyHeld
#: src/js/library.js:19
msgctxt "tree:copy#/alreadyHeld"
msgid "You are already in this book's hold queue."
msgstr "この本の予約列へ登録済みです。"

#. copy/borrowed
#: src/js/library.js:19
msgctxt "tree:copy#/borrowed"
msgid "Checked out. The librarian added one extra moon-shaped stamp nobody can read."
msgstr "貸出完了。司書が読めない月印を一つ余分に押しました。"

#. copy/held
#: src/js/library.js:19
msgctxt "tree:copy#/held"
msgid ""
"Hold placed. When the book reaches the desk, a paper crane will leave a "
"notice on this page."
msgstr "予約しました。本がカウンターへ着くと紙鶴がこの頁へ通知を残します。"

#. copy/renewed
#: src/js/library.js:19
msgctxt "tree:copy#/renewed"
msgid "Renewed. The new due date is written into your on-device library card."
msgstr "延長しました。新しい返却期限を端末内貸出票に記録しました。"

#. copy/returned
#: src/js/library.js:19
msgctxt "tree:copy#/returned"
msgid "Returned. The shelf has provisionally agreed to take it."
msgstr "返却しました。書架は一旦受入れに同意しました。"

#. copy/holdCancelled
#: src/js/library.js:19
msgctxt "tree:copy#/holdCancelled"
msgid "Hold cancelled. The queue moved forward by one."
msgstr "予約を取り消しました。列が一つ進みました。"

#. copy/renewalLimit
#: src/js/library.js:19
msgctxt "tree:copy#/renewalLimit"
msgid "This book has used all permitted renewals."
msgstr "この本は延長回数を使い切りました。"

#. copy/renewalBlocked
#: src/js/library.js:19
msgctxt "tree:copy#/renewalBlocked"
msgid "Another reader has a hold, so this loan cannot be renewed."
msgstr "予約者がいるため延長できません。"

