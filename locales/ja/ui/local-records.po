#. copy/eyebrow
#: src/js/local-records.js:22
msgctxt "tree:copy#/eyebrow"
msgid "LOCAL ARCHIVES / ON-DEVICE RECORDS CABINET"
msgstr "LOCAL ARCHIVES / 端末内資料棚"

#. copy/title
#: src/js/local-records.js:22
msgctxt "tree:copy#/title"
msgid "Records saved in this browser"
msgstr "このブラウザの保存記録"

#. copy/lead
#: src/js/local-records.js:22
msgctxt "tree:copy#/lead"
msgid ""
"Browse your applications, courses, loans, clinic records, and drafts. Export "
"an archive to keep a backup or move it to another browser."
msgstr "出願、履修、貸出、診療、下書きを確認できます。バックアップや別のブラウザへの移動には、アーカイブを書き出してください。"

#. copy/offline
#: src/js/local-records.js:22
msgctxt "tree:copy#/offline"
msgid "Browser storage"
msgstr "ブラウザの保存領域"

#. copy/offlineLead
#: src/js/local-records.js:22
msgctxt "tree:copy#/offlineLead"
msgid "These records belong to this browser profile at the site address shown below."
msgstr "以下のサイトアドレスで、このブラウザのプロファイルに保存した記録です。"

#. copy/origin
#: src/js/local-records.js:22
msgctxt "tree:copy#/origin"
msgid "Current origin"
msgstr "現在のオリジン"

#. copy/writtenFiles
#: src/js/local-records.js:22
msgctxt "tree:copy#/writtenFiles"
msgid "Stored files"
msgstr "保存済み"

#. copy/entries
#: src/js/local-records.js:22
msgctxt "tree:copy#/entries"
msgid "Content entries"
msgstr "内容件数"

#. copy/used
#: src/js/local-records.js:22
msgctxt "tree:copy#/used"
msgid "Cabinet usage"
msgstr "資料棚の使用量"

#. copy/portable
#: src/js/local-records.js:22
msgctxt "tree:copy#/portable"
msgid "Portable files"
msgstr "箱詰め可能"

#. copy/allowance
#: src/js/local-records.js:22
msgctxt "tree:copy#/allowance"
msgid ""
"Gauge uses a common 5 MiB localStorage allowance as a reference; the browser "
"sets the actual limit."
msgstr "一般的な 5 MiB の localStorage 枠を目安に表示。実際の上限はブラウザが決めます。"

#. copy/originEstimate
#: src/js/local-records.js:22
msgctxt "tree:copy#/originEstimate"
msgid ""
"Browser estimate: this origin uses {usage} of {quota}; this may include "
"other site storage."
msgstr "ブラウザ報告：このオリジンは {usage}／{quota} を使用。サイトの他の保存領域を含む場合があります。"

#. copy/originUnknown
#: src/js/local-records.js:22
msgctxt "tree:copy#/originUnknown"
msgid ""
"The browser did not provide an origin-wide allowance; the figure above "
"remains an exact UTF-8 estimate of university files."
msgstr "オリジン全体の上限は取得できません。上記は本学ファイルの UTF-8 による正確な見積りです。"

#. copy/visibility
#: src/js/local-records.js:22
msgctxt "tree:copy#/visibility"
msgid "Who can see these papers?"
msgstr "この紙を見られるのは誰？"

#. copy/visibilityLead
#: src/js/local-records.js:22
msgctxt "tree:copy#/visibilityLead"
msgid ""
"Other browsers, private windows, devices, and site addresses keep separate "
"records. Use export and import to transfer a copy."
msgstr "別のブラウザ、プライベートウィンドウ、端末、サイトアドレスでは記録が別になります。移す場合は書き出しと読み込みをご利用ください。"

#. copy/export
#: src/js/local-records.js:22
msgctxt "tree:copy#/export"
msgid "Export all records"
msgstr "全記録を書き出す"

#. copy/exportLead
#: src/js/local-records.js:22
msgctxt "tree:copy#/exportLead"
msgid ""
"Downloads a JSON archive with a SHA-256 integrity check. Temporary tab "
"passes are excluded."
msgstr "整合性を確認するSHA-256値を付けたJSONアーカイブを保存します。一時的なタブ通行証は含みません。"

#. copy/exporting
#: src/js/local-records.js:22
msgctxt "tree:copy#/exporting"
msgid "Preparing archive…"
msgstr "アーカイブを作成中…"

#. copy/exported
#: src/js/local-records.js:22
msgctxt "tree:copy#/exported"
msgid "Archive downloaded."
msgstr "アーカイブを保存しました。"

#. copy/import
#: src/js/local-records.js:22
msgctxt "tree:copy#/import"
msgid "Import an archive"
msgstr "アーカイブを読み込む"

#. copy/importLead
#: src/js/local-records.js:22
msgctxt "tree:copy#/importLead"
msgid ""
"Checks the file's integrity, format, and records before importing. Choose "
"whether to keep or replace records already saved here."
msgstr "読み込み前に整合性、形式、記録を確認します。同じ記録がある場合に、現在のものを残すか置き換えるか選んでください。"

#. copy/chooseFile
#: src/js/local-records.js:22
msgctxt "tree:copy#/chooseFile"
msgid "Choose JSON file"
msgstr "JSON ファイルを選択"

#. copy/collision
#: src/js/local-records.js:22
msgctxt "tree:copy#/collision"
msgid "Existing records"
msgstr "既存の記録"

#. copy/preserve
#: src/js/local-records.js:22
msgctxt "tree:copy#/preserve"
msgid "Keep current version (recommended)"
msgstr "現在の版を保持（推奨）"

#. copy/overwrite
#: src/js/local-records.js:22
msgctxt "tree:copy#/overwrite"
msgid "Replace matching records"
msgstr "一致する記録を置き換える"

#. copy/applyImport
#: src/js/local-records.js:22
msgctxt "tree:copy#/applyImport"
msgid "Import records"
msgstr "記録を読み込む"

#. copy/imported
#: src/js/local-records.js:22
msgctxt "tree:copy#/imported"
msgid "Imported {imported}; kept {skipped} existing records."
msgstr "{imported}件を読み込み、既存の{skipped}件を保持しました。"

#. copy/importReady
#: src/js/local-records.js:22
msgctxt "tree:copy#/importReady"
msgid "Integrity check passed: {count} files, {size}"
msgstr "整合性を確認：{count}件、{size}"

#. copy/importConflicts
#: src/js/local-records.js:22
msgctxt "tree:copy#/importConflicts"
msgid "{count} share a name with a current file"
msgstr "{count} 件が現在のファイルと同名"

#. copy/importUnknown
#: src/js/local-records.js:22
msgctxt "tree:copy#/importUnknown"
msgid "{count} are not yet catalogued but retain the tu: campus prefix"
msgstr "{count} 件は未登録ですが tu: 学務接頭辞を保持"

#. copy/importBlocked
#: src/js/local-records.js:22
msgctxt "tree:copy#/importBlocked"
msgid "{count} short-lived or non-portable files will be skipped"
msgstr "{count} 件の短時間／持出不可データをスキップ"

#. copy/importSource
#: src/js/local-records.js:22
msgctxt "tree:copy#/importSource"
msgid "Packed {date} · origin {origin}"
msgstr "箱詰め {date} · 出所 {origin}"

#. copy/importReplaceWarning
#: src/js/local-records.js:22
msgctxt "tree:copy#/importReplaceWarning"
msgid ""
"Only matching records in the archive will be replaced. Your other records "
"stay as they are."
msgstr "アーカイブに含まれる同じ記録だけを置き換えます。ほかの保存記録はそのまま残ります。"

#. copy/filter
#: src/js/local-records.js:22
msgctxt "tree:copy#/filter"
msgid "Search file title or storage key"
msgstr "ファイル名または保存キーを検索"

#. copy/presentOnly
#: src/js/local-records.js:22
msgctxt "tree:copy#/presentOnly"
msgid "Stored files only"
msgstr "保存済みだけ表示"

#. copy/showCatalogue
#: src/js/local-records.js:22
msgctxt "tree:copy#/showCatalogue"
msgid "Show full registered catalogue"
msgstr "登録済み全ファイルを見る"

#. copy/hideCatalogue
#: src/js/local-records.js:22
msgctxt "tree:copy#/hideCatalogue"
msgid "Hide blank files"
msgstr "空のファイルを閉じる"

#. copy/noMatch
#: src/js/local-records.js:22
msgctxt "tree:copy#/noMatch"
msgid "No matching records. Try another search term."
msgstr "一致する記録がありません。別の語句で検索してください。"

#. copy/stored
#: src/js/local-records.js:22
msgctxt "tree:copy#/stored"
msgid "Stored"
msgstr "保存済み"

#. copy/empty
#: src/js/local-records.js:22
msgctxt "tree:copy#/empty"
msgid "Not written"
msgstr "未保存"

#. copy/item
#: src/js/local-records.js:22
msgctxt "tree:copy#/item"
msgid "entry"
msgstr "件"

#. copy/items
#: src/js/local-records.js:22
msgctxt "tree:copy#/items"
msgid "entries"
msgstr "件"

#. copy/view
#: src/js/local-records.js:22
msgctxt "tree:copy#/view"
msgid "Open file"
msgstr "開いて見る"

#. copy/destroy
#: src/js/local-records.js:22
msgctxt "tree:copy#/destroy"
msgid "Delete"
msgstr "削除"

#. copy/destroyGroup
#: src/js/local-records.js:22
msgctxt "tree:copy#/destroyGroup"
msgid "Delete this group"
msgstr "この分類を削除"

#. copy/destroyAll
#: src/js/local-records.js:22
msgctxt "tree:copy#/destroyAll"
msgid "Delete all university records"
msgstr "学内記録をすべて削除"

#. copy/destroyOneConfirm
#: src/js/local-records.js:22
msgctxt "tree:copy#/destroyOneConfirm"
msgid "Delete “{title}”? This cannot be undone. Export a backup first if you need one."
msgstr "「{title}」を削除しますか？元に戻せません。必要なら先にバックアップを書き出してください。"

#. copy/destroyGroupConfirm
#: src/js/local-records.js:22
msgctxt "tree:copy#/destroyGroupConfirm"
msgid "Delete {count} saved files in “{title}”?"
msgstr "「{title}」の保存済みファイル{count}件を削除しますか？"

#. copy/destroyAllConfirm
#: src/js/local-records.js:22
msgctxt "tree:copy#/destroyAllConfirm"
msgid ""
"Delete all university records for this site in this browser? This removes "
"your identity, applications, grades, drafts, and temporary tab data."
msgstr "このブラウザにある当サイトの学内記録をすべて削除しますか？学籍、出願、成績、下書き、一時的なタブの記録が削除されます。"

#. copy/destroyed
#: src/js/local-records.js:22
msgctxt "tree:copy#/destroyed"
msgid "Deleted {count} saved files."
msgstr "保存ファイル{count}件を削除しました。"

#. copy/cabinetEmpty
#: src/js/local-records.js:22
msgctxt "tree:copy#/cabinetEmpty"
msgid "No saved records to delete."
msgstr "削除する保存記録はありません。"

#. copy/rawTitle
#: src/js/local-records.js:22
msgctxt "tree:copy#/rawTitle"
msgid "Raw file"
msgstr "ファイル原文"

#. copy/storageKey
#: src/js/local-records.js:22
msgctxt "tree:copy#/storageKey"
msgid "Storage key"
msgstr "保存キー"

#. copy/storageKind
#: src/js/local-records.js:22
msgctxt "tree:copy#/storageKind"
msgid "Storage location"
msgstr "保存場所"

#. copy/persistent
#: src/js/local-records.js:22
msgctxt "tree:copy#/persistent"
msgid "localStorage · retained after closing the tab"
msgstr "localStorage · タブを閉じても保持"

#. copy/session
#: src/js/local-records.js:22
msgctxt "tree:copy#/session"
msgid "sessionStorage · this tab only"
msgstr "sessionStorage · このタブのみ"

#. copy/bytes
#: src/js/local-records.js:22
msgctxt "tree:copy#/bytes"
msgid "Space used"
msgstr "使用量"

#. copy/scope
#: src/js/local-records.js:22
msgctxt "tree:copy#/scope"
msgid "Visibility"
msgstr "可視範囲"

#. copy/close
#: src/js/local-records.js:22
msgctxt "tree:copy#/close"
msgid "Close file"
msgstr "閉じる"

#. copy/rawWarning
#: src/js/local-records.js:22
msgctxt "tree:copy#/rawWarning"
msgid ""
"This view includes saved names, answers, and medical records. Check the "
"contents before sharing a screenshot or archive."
msgstr "保存された名前、答案、診療記録も表示されます。画像やアーカイブを共有する前に内容をご確認ください。"

#. copy/integrity
#: src/js/local-records.js:22
msgctxt "tree:copy#/integrity"
msgid ""
"The integrity check detects changed or damaged archives. Check where a file "
"came from before importing it."
msgstr "整合性検査で変更や破損を確認します。読み込み前に、ファイルの入手元も確かめてください。"

#. copy/error/archive-size
#: src/js/local-records.js:22
msgctxt "tree:copy#/error/archive-size"
msgid "Choose a non-empty file no larger than 8 MiB."
msgstr "空でない、8MiB以下のファイルを選んでください。"

#. copy/error/archive-json
#: src/js/local-records.js:22
msgctxt "tree:copy#/error/archive-json"
msgid "The file could not be read as a JSON archive."
msgstr "JSONアーカイブとして読み取れませんでした。"

#. copy/error/archive-format
#: src/js/local-records.js:22
msgctxt "tree:copy#/error/archive-format"
msgid "The archive format or version does not belong to this cabinet."
msgstr "資料箱の形式または版が本学資料棚に対応していません。"

#. copy/error/archive-records
#: src/js/local-records.js:22
msgctxt "tree:copy#/error/archive-records"
msgid "The file catalogue is missing or contains an unreasonable number of records."
msgstr "ファイル目録がないか、件数が異常です。"

#. copy/error/archive-record
#: src/js/local-records.js:22
msgctxt "tree:copy#/error/archive-record"
msgid "At least one record has an invalid key, storage location, or value."
msgstr "少なくとも一件のキー、場所、内容形式が不正です。"

#. copy/error/archive-checksum
#: src/js/local-records.js:22
msgctxt "tree:copy#/error/archive-checksum"
msgid "The SHA-256 seal does not match; the file may be edited or incompletely downloaded."
msgstr "SHA-256 封印が一致しません。変更または不完全なダウンロードの可能性があります。"

#. copy/error/archive-import
#: src/js/local-records.js:22
msgctxt "tree:copy#/error/archive-import"
msgid "The import policy is invalid."
msgstr "読み込み方式が不正です。"

#. copy/error/archive-storage
#: src/js/local-records.js:22
msgctxt "tree:copy#/error/archive-storage"
msgid "This browser refused access to localStorage."
msgstr "ブラウザが localStorage を開くことを拒否しました。"

#. copy/error/archive-quota
#: src/js/local-records.js:22
msgctxt "tree:copy#/error/archive-quota"
msgid ""
"The browser is out of space. This import was rolled back and current files "
"were preserved."
msgstr "空き容量不足です。今回の読込を撤回し、以前のファイルを維持しました。"

#. copy/error/unknown
#: src/js/local-records.js:22
msgctxt "tree:copy#/error/unknown"
msgid "The records cabinet cannot complete that action right now."
msgstr "資料棚は現在この操作を完了できません。"
