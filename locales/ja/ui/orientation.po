#. copy/eyebrow
#: src/js/orientation.js:35
msgctxt "tree:copy#/eyebrow"
msgid "FIRST BELL / NEW STUDENT ARRIVAL WEEK"
msgstr "FIRST BELL / 第一鐘・新入生到着週"

#. copy/title
#: src/js/orientation.js:35
msgctxt "tree:copy#/title"
msgid "Welcome to First Bell."
msgstr "第一鐘へようこそ。"

#. copy/lead
#: src/js/orientation.js:35
msgctxt "tree:copy#/lead"
msgid ""
"Check your admission review, plan a route to your school, and choose a stop "
"signal and first destination."
msgstr "合格審査を確認し、学部までの経路、停止合図、最初の行先を選びます。"

#. copy/office
#: src/js/orientation.js:35
msgctxt "tree:copy#/office"
msgid "NEW STUDENT ARRIVAL OFFICE"
msgstr "NEW STUDENT ARRIVAL OFFICE"

#. copy/officeTitle
#: src/js/orientation.js:35
msgctxt "tree:copy#/officeTitle"
msgid "New Student Arrival Office"
msgstr "新入生到着室"

#. copy/window
#: src/js/orientation.js:35
msgctxt "tree:copy#/window"
msgid "Filing window"
msgstr "受付期間"

#. copy/issued
#: src/js/orientation.js:35
msgctxt "tree:copy#/issued"
msgid "Opened"
msgstr "開封済み"

#. copy/completed
#: src/js/orientation.js:35
msgctxt "tree:copy#/completed"
msgid "First Bell rung"
msgstr "第一鐘済み"

#. copy/publicFile
#: src/js/orientation.js:35
msgctxt "tree:copy#/publicFile"
msgid "Public blank file"
msgstr "公開空票"

#. copy/publicLead
#: src/js/orientation.js:35
msgctxt "tree:copy#/publicLead"
msgid ""
"Read the arrival guide here. To open a personal file, you need a formal "
"admission result saved in this browser."
msgstr "到着案内はどなたでも読めます。自分の手続を始めるには、このブラウザに正式な合格結果が必要です。"

#. copy/status
#: src/js/orientation.js:35
msgctxt "tree:copy#/status"
msgid "Current file status"
msgstr "現在のファイル状態"

#. copy/identityMissing
#: src/js/orientation.js:35
msgctxt "tree:copy#/identityMissing"
msgid ""
"Create a My TU identity to begin. Your existing applications and exam "
"records will be kept."
msgstr "まずMy TUの学籍を作成してください。保存済みの出願・試験記録はそのまま残ります。"

#. copy/applicationMissing
#: src/js/orientation.js:35
msgctxt "tree:copy#/applicationMissing"
msgid "Submit an application, then open its faculty review in My TU."
msgstr "出願を提出し、My TUで教員審査を開いてください。"

#. copy/reviewMissing
#: src/js/orientation.js:35
msgctxt "tree:copy#/reviewMissing"
msgid "Your application is saved. Open My TU to request the faculty review."
msgstr "出願は保存されています。My TUから教員審査を依頼してください。"

#. copy/conditional
#: src/js/orientation.js:35
msgctxt "tree:copy#/conditional"
msgid ""
"Your admission is conditional. Read the conditions in My TU; First Bell "
"opens after formal admission."
msgstr "条件付き合格です。My TUで条件を確認してください。第一鐘の手続は正式合格後に始められます。"

#. copy/notAdmitted
#: src/js/orientation.js:35
msgctxt "tree:copy#/notAdmitted"
msgid "Your review requests more information or an interview. Check My TU for the next step."
msgstr "追加資料または面接が必要です。My TUで次の手続をご確認ください。"

#. copy/admitted
#: src/js/orientation.js:35
msgctxt "tree:copy#/admitted"
msgid "Your formal admission is confirmed. You can open your arrival file."
msgstr "正式合格を確認しました。到着手続を始められます。"

#. copy/goMyTu
#: src/js/orientation.js:35
msgctxt "tree:copy#/goMyTu"
msgid "Open My TU"
msgstr "My TU へ"

#. copy/goApplication
#: src/js/orientation.js:35
msgctxt "tree:copy#/goApplication"
msgid "Start an application"
msgstr "入学出願を始める"

#. copy/goAdmissions
#: src/js/orientation.js:35
msgctxt "tree:copy#/goAdmissions"
msgid "Admissions & examinations"
msgstr "入試・試験を見る"

#. copy/openDossier
#: src/js/orientation.js:35
msgctxt "tree:copy#/openDossier"
msgid "Open my arrival file"
msgstr "自分の到着票を開封"

#. copy/privacy
#: src/js/orientation.js:35
msgctxt "tree:copy#/privacy"
msgid ""
"Your name, application, and needs stay in this browser. BBS updates show "
"arrival counts without names."
msgstr "名前、出願、必要な配慮はこのブラウザに保存します。BBSの到着状況には人数だけを載せます。"

#. copy/threeThings
#: src/js/orientation.js:35
msgctxt "tree:copy#/threeThings"
msgid "Before you arrive"
msgstr "到着前に確認すること"

#. copy/threeLead
#: src/js/orientation.js:35
msgctxt "tree:copy#/threeLead"
msgid "Keep your admission review, route, and first destination ready."
msgstr "合格審査、経路、最初の行先をそろえましょう。"

#. copy/ruleOne
#: src/js/orientation.js:35
msgctxt "tree:copy#/ruleOne"
msgid "Check your admission review"
msgstr "合格審査を確認する"

#. copy/ruleOneBody
#: src/js/orientation.js:35
msgctxt "tree:copy#/ruleOneBody"
msgid "Read the decision, conditions, and any dissenting opinions."
msgstr "判定、条件、異議を確認してください。"

#. copy/ruleTwo
#: src/js/orientation.js:35
msgctxt "tree:copy#/ruleTwo"
msgid "Recognise a way back"
msgstr "退路を識別する"

#. copy/ruleTwoBody
#: src/js/orientation.js:35
msgctxt "tree:copy#/ruleTwoBody"
msgid "Routes may change. Your stop signal must be one you can personally recognise."
msgstr "経路は変わっても、停止合図は本人が確実に分かるものにします。"

#. copy/ruleThree
#: src/js/orientation.js:35
msgctxt "tree:copy#/ruleThree"
msgid "Choose a first destination"
msgstr "最初の行先を選ぶ"

#. copy/ruleThreeBody
#: src/js/orientation.js:35
msgctxt "tree:copy#/ruleThreeBody"
msgid "Choose a course, a room, a club, or the festival as your first stop."
msgstr "最初の行先を、授業、学生寮、サークル、祭りから選べます。"

#. copy/dossier
#: src/js/orientation.js:35
msgctxt "tree:copy#/dossier"
msgid "ARRIVAL FILE / THIS DEVICE"
msgstr "ARRIVAL FILE / 端末内到着票"

#. copy/dossierTitle
#: src/js/orientation.js:35
msgctxt "tree:copy#/dossierTitle"
msgid "Your arrival choices"
msgstr "到着手続の内容"

#. copy/student
#: src/js/orientation.js:35
msgctxt "tree:copy#/student"
msgid "Arriving student"
msgstr "到着者"

#. copy/school
#: src/js/orientation.js:35
msgctxt "tree:copy#/school"
msgid "Admitting school"
msgstr "合格学部"

#. copy/application
#: src/js/orientation.js:35
msgctxt "tree:copy#/application"
msgid "Application file"
msgstr "出願記録"

#. copy/review
#: src/js/orientation.js:35
msgctxt "tree:copy#/review"
msgid "Review file"
msgstr "審査記録"

#. copy/decision
#: src/js/orientation.js:35
msgctxt "tree:copy#/decision"
msgid "Decision"
msgstr "審査結果"

#. copy/question
#: src/js/orientation.js:35
msgctxt "tree:copy#/question"
msgid "The question you bring through the gate"
msgstr "門へ持ち込む問い"

#. copy/noQuestion
#: src/js/orientation.js:35
msgctxt "tree:copy#/noQuestion"
msgid "No question is shown here. Check the original application in My TU."
msgstr "ここには問いが記載されていません。My TUで元の出願をご確認ください。"

#. copy/admittedLabel
#: src/js/orientation.js:35
msgctxt "tree:copy#/admittedLabel"
msgid "Admitted"
msgstr "正式合格"

#. copy/stepOne
#: src/js/orientation.js:35
msgctxt "tree:copy#/stepOne"
msgid "01 / ADMISSION EDITION"
msgstr "01 / 合格版"

#. copy/stepOneTitle
#: src/js/orientation.js:35
msgctxt "tree:copy#/stepOneTitle"
msgid "Check the admission result and its conditions."
msgstr "合格結果と条件を確認する。"

#. copy/stepOneBody
#: src/js/orientation.js:35
msgctxt "tree:copy#/stepOneBody"
msgid "Use the application and review references to reopen the original documents in My TU."
msgstr "出願・審査番号から、My TUで元の書類を開けます。"

#. copy/stepTwo
#: src/js/orientation.js:35
msgctxt "tree:copy#/stepTwo"
msgid "02 / ARRIVAL ROUTE"
msgstr "02 / 到着経路"

#. copy/stepTwoTitle
#: src/js/orientation.js:35
msgctxt "tree:copy#/stepTwoTitle"
msgid "Travel from Hakurei Gate to your school."
msgstr "博麗門から合格学部へ。"

#. copy/stepTwoBody
#: src/js/orientation.js:35
msgctxt "tree:copy#/stepTwoBody"
msgid ""
"Choose how to travel. The route accounts for today's closures, calendar, and "
"festival traffic."
msgstr "移動手段を選んでください。今日の通行止め、行事、祭りの交通を反映した経路を表示します。"

#. copy/chooseMode
#: src/js/orientation.js:35
msgctxt "tree:copy#/chooseMode"
msgid "Arrival mode"
msgstr "到着方法"

#. copy/confirmArrival
#: src/js/orientation.js:35
msgctxt "tree:copy#/confirmArrival"
msgid "File this route"
msgstr "この経路を到着票へ記入"

#. copy/routeFiled
#: src/js/orientation.js:35
msgctxt "tree:copy#/routeFiled"
msgid "Arrival route confirmed"
msgstr "到着経路確認済み"

#. copy/minutes
#: src/js/orientation.js:35
msgctxt "tree:copy#/minutes"
msgid "Estimated minutes"
msgstr "所要分"

#. copy/walking
#: src/js/orientation.js:35
msgctxt "tree:copy#/walking"
msgid "Walking"
msgstr "うち徒歩"

#. copy/distance
#: src/js/orientation.js:35
msgctxt "tree:copy#/distance"
msgid "Approx. distance"
msgstr "概算距離"

#. copy/routeClosed
#: src/js/orientation.js:35
msgctxt "tree:copy#/routeClosed"
msgid ""
"This mode cannot form a complete route today. Choose another or inspect "
"closures on the live map."
msgstr "今日はこの方法で全経路を作れません。方法を変えるか、当番地図で閉鎖を確認してください。"

#. copy/openMap
#: src/js/orientation.js:35
msgctxt "tree:copy#/openMap"
msgid "Open the live campus map"
msgstr "当番キャンパス地図を開く"

#. copy/stepThree
#: src/js/orientation.js:35
msgctxt "tree:copy#/stepThree"
msgid "03 / STOP & NOTICE"
msgstr "03 / 停止と通知"

#. copy/stepThreeTitle
#: src/js/orientation.js:35
msgctxt "tree:copy#/stepThreeTitle"
msgid "Choose a stop signal you can recognise yourself."
msgstr "本人が識別できる停止合図を選ぶ。"

#. copy/stepThreeBody
#: src/js/orientation.js:35
msgctxt "tree:copy#/stepThreeBody"
msgid ""
"Choose how you will stop or leave, then how you will check detour notices. "
"Confirm both separately."
msgstr "止まり方・退き方と、迂回通知の確認方法を選び、それぞれ確認してください。"

#. copy/signal
#: src/js/orientation.js:35
msgctxt "tree:copy#/signal"
msgid "Recognisable stop / exit signal"
msgstr "識別できる停止・退路合図"

#. copy/notice
#: src/js/orientation.js:35
msgctxt "tree:copy#/notice"
msgid "Detour notice I will verify"
msgstr "自分で再確認する迂回通知"

#. copy/confirmBoundary
#: src/js/orientation.js:35
msgctxt "tree:copy#/confirmBoundary"
msgid "Confirm exit and notice"
msgstr "退路と通知を確認"

#. copy/boundaryFiled
#: src/js/orientation.js:35
msgctxt "tree:copy#/boundaryFiled"
msgid "Exit field personally confirmed"
msgstr "退路欄を本人確認済み"

#. copy/stepFour
#: src/js/orientation.js:35
msgctxt "tree:copy#/stepFour"
msgid "04 / FIRST DESTINATION"
msgstr "04 / 最初の行先"

#. copy/stepFourTitle
#: src/js/orientation.js:35
msgctxt "tree:copy#/stepFourTitle"
msgid "Where will you go after First Bell?"
msgstr "第一鐘の後、最初にどこへ？"

#. copy/stepFourBody
#: src/js/orientation.js:35
msgctxt "tree:copy#/stepFourBody"
msgid "Your choice opens the relevant course, housing, club, or festival page."
msgstr "選んだ行先の授業、寮、サークル、祭りのページを開きます。"

#. copy/firstStop
#: src/js/orientation.js:35
msgctxt "tree:copy#/firstStop"
msgid "Choose a first destination"
msgstr "最初の行先"

#. copy/ringBell
#: src/js/orientation.js:35
msgctxt "tree:copy#/ringBell"
msgid "Ring First Bell and file arrival"
msgstr "第一鐘を鳴らし、到着票を保存"

#. copy/required
#: src/js/orientation.js:35
msgctxt "tree:copy#/required"
msgid "Complete this field first."
msgstr "この欄を選んでください。"

#. copy/arrivalSaved
#: src/js/orientation.js:35
msgctxt "tree:copy#/arrivalSaved"
msgid "The arrival route is now in the file."
msgstr "到着経路を記入しました。"

#. copy/boundarySaved
#: src/js/orientation.js:35
msgctxt "tree:copy#/boundarySaved"
msgid "Stop signal and detour notice were filed separately."
msgstr "停止合図と迂回通知を別欄で保存しました。"

#. copy/completedToast
#: src/js/orientation.js:35
msgctxt "tree:copy#/completedToast"
msgid "First Bell rang. Your first destination is open."
msgstr "第一鐘が鳴りました。最初の行先へ進めます。"

#. copy/completeEyebrow
#: src/js/orientation.js:35
msgctxt "tree:copy#/completeEyebrow"
msgid "MATRICULATION FILED / ARRIVAL RECORDED"
msgstr "MATRICULATION FILED / 到着記録成立"

#. copy/completeTitle
#: src/js/orientation.js:35
msgctxt "tree:copy#/completeTitle"
msgid "You're ready for your first stop."
msgstr "最初の行先へ出発できます。"

#. copy/completeLead
#: src/js/orientation.js:35
msgctxt "tree:copy#/completeLead"
msgid ""
"Your arrival is recorded in My TU. You can print the slip or continue to "
"your chosen destination."
msgstr "My TUに到着を記録しました。到着票を印刷するか、選んだ行先へ進めます。"

#. copy/firstDestination
#: src/js/orientation.js:35
msgctxt "tree:copy#/firstDestination"
msgid "First destination"
msgstr "最初の行先"

#. copy/stopSignal
#: src/js/orientation.js:35
msgctxt "tree:copy#/stopSignal"
msgid "Stop signal"
msgstr "停止合図"

#. copy/noticePlan
#: src/js/orientation.js:35
msgctxt "tree:copy#/noticePlan"
msgid "Detour notice"
msgstr "迂回通知"

#. copy/filedAt
#: src/js/orientation.js:35
msgctxt "tree:copy#/filedAt"
msgid "First Bell time"
msgstr "第一鐘時刻"

#. copy/print
#: src/js/orientation.js:35
msgctxt "tree:copy#/print"
msgid "Print / save formal arrival slip"
msgstr "正式到着票を印刷／PDF保存"

#. copy/depart
#: src/js/orientation.js:35
msgctxt "tree:copy#/depart"
msgid "Go to first destination"
msgstr "最初の行先へ"

#. copy/openBbs
#: src/js/orientation.js:35
msgctxt "tree:copy#/openBbs"
msgid "See what the BBS says"
msgstr "BBS の反応を見る"

#. copy/openAnother
#: src/js/orientation.js:35
msgctxt "tree:copy#/openAnother"
msgid "Return to arrival file"
msgstr "到着票へ戻る"

#. copy/records
#: src/js/orientation.js:35
msgctxt "tree:copy#/records"
msgid "arrival files"
msgstr "件の到着票"

#. copy/openFiles
#: src/js/orientation.js:35
msgctxt "tree:copy#/openFiles"
msgid "awaiting First Bell"
msgstr "件が第一鐘前"
