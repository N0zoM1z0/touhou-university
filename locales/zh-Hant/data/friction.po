#. unresolvedMatters.ayaCorrection.stamp
#: src/data/friction.js:5
msgctxt "text:unresolvedMatters.ayaCorrection.stamp"
msgid "CORRECTION 11"
msgstr "第 11 次訂正"

#. unresolvedMatters.ayaCorrection.title
#: src/data/friction.js:6
msgctxt "text:unresolvedMatters.ayaCorrection.title"
msgid ""
"The dean teaches public corrections. The headline needing correction this "
"week is also hers."
msgstr "院長親授公開訂正；本週需要訂正的頭條也由院長親擬。"

#. unresolvedMatters.ayaCorrection.summary
#: src/data/friction.js:7
msgctxt "text:unresolvedMatters.ayaCorrection.summary"
msgid ""
"Bunbunmaru Campus News turned “three late students” into “Mass Bamboo "
"Disappearance.” All three were in the dining hall; Aya argues the hall lies "
"within bamboo narrative territory."
msgstr "《文文。校報》把「三名學生遲到」改成「竹林集體失蹤事件」。當事人全數在食堂，Aya 主張食堂也位於竹林敘事範圍內。"

#. unresolvedMatters.ayaCorrection.details.0
#: src/data/friction.js:9
msgctxt "text:unresolvedMatters.ayaCorrection.details.0"
msgid "Owner"
msgstr "承辦"

#. unresolvedMatters.ayaCorrection.details.1
#: src/data/friction.js:10
msgctxt "text:unresolvedMatters.ayaCorrection.details.1"
msgid "Tengu Journalism · Correction Desk"
msgstr "天狗新聞傳播學院・更正桌"

#. unresolvedMatters.ayaCorrection.details.2
#: src/data/friction.js:11
msgctxt "text:unresolvedMatters.ayaCorrection.details.2"
msgid "Current action"
msgstr "目前處置"

#. unresolvedMatters.ayaCorrection.details.3
#: src/data/friction.js:12
msgctxt "text:unresolvedMatters.ayaCorrection.details.3"
msgid "Headline retained at smaller type; Hatate is reviewing version twelve"
msgstr "標題保留，字級縮小；第十二版正由 Hatate 審讀"

#. unresolvedMatters.ayaCorrection.details.4
#: src/data/friction.js:13
msgctxt "text:unresolvedMatters.ayaCorrection.details.4"
msgid "Point of dispute"
msgstr "爭點"

#. unresolvedMatters.ayaCorrection.details.5
#: src/data/friction.js:14
msgctxt "text:unresolvedMatters.ayaCorrection.details.5"
msgid "Whether dramatic value is a measurable public benefit"
msgstr "「戲劇性」到底是不是可量化的公共利益"

#. unresolvedMatters.marisaMaterials.stamp
#: src/data/friction.js:18
msgctxt "text:unresolvedMatters.marisaMaterials.stamp"
msgid "SOURCE RETURNED"
msgstr "來源欄退件"

#. unresolvedMatters.marisaMaterials.title
#: src/data/friction.js:19
msgctxt "text:unresolvedMatters.marisaMaterials.title"
msgid ""
"Reproducibility filing, revision seven: material source still says “found it "
"in the forest.”"
msgstr "可重現實驗第七次補件：材料來源仍寫著「森林裡撿的」。"

#. unresolvedMatters.marisaMaterials.summary
#: src/data/friction.js:20
msgctxt "text:unresolvedMatters.marisaMaterials.summary"
msgid ""
"Marisa reproduced the same explosion three times but refuses to list two "
"grimoires as borrowed because “the books followed me.” Patchouli stamped "
"every copy REJECTED in a different colour."
msgstr "Marisa 已重現三次同樣的爆炸，卻拒絕把兩本魔導書列為借用物，理由是「書自己跟來的」。Patchouli 在每一份複本上蓋了不同顏色的拒絕章。"

#. unresolvedMatters.marisaMaterials.details.0
#: src/data/friction.js:22
msgctxt "text:unresolvedMatters.marisaMaterials.details.0"
msgid "Owner"
msgstr "承辦"

#. unresolvedMatters.marisaMaterials.details.1
#: src/data/friction.js:23
msgctxt "text:unresolvedMatters.marisaMaterials.details.1"
msgid "Seven-Day Laboratory · Materials Shelf"
msgstr "七曜實驗塔・材料來源櫃"

#. unresolvedMatters.marisaMaterials.details.2
#: src/data/friction.js:24
msgctxt "text:unresolvedMatters.marisaMaterials.details.2"
msgid "Current action"
msgstr "目前處置"

#. unresolvedMatters.marisaMaterials.details.3
#: src/data/friction.js:25
msgctxt "text:unresolvedMatters.marisaMaterials.details.3"
msgid ""
"Experiment may continue; books may not leave their current location, whose "
"boundary is disputed"
msgstr "實驗准予繼續；書籍不准離開原地，但原地的邊界尚有爭議"

#. unresolvedMatters.marisaMaterials.details.4
#: src/data/friction.js:26
msgctxt "text:unresolvedMatters.marisaMaterials.details.4"
msgid "Point of dispute"
msgstr "爭點"

#. unresolvedMatters.marisaMaterials.details.5
#: src/data/friction.js:27
msgctxt "text:unresolvedMatters.marisaMaterials.details.5"
msgid "Whether “I’ll return it later” counts as procurement"
msgstr "「之後會還」能否構成採購方式"

#. unresolvedMatters.yukariRoom.stamp
#: src/data/friction.js:31
msgctxt "text:unresolvedMatters.yukariRoom.stamp"
msgid "SPATIAL APPEAL"
msgstr "空間異議"

#. unresolvedMatters.yukariRoom.title
#: src/data/friction.js:32
msgctxt "text:unresolvedMatters.yukariRoom.title"
msgid "Room 4-B was reclassified yesterday as “between present and absent.”"
msgstr "4-B 教室昨日被重新分類為「出席與缺席之間」。"

#. unresolvedMatters.yukariRoom.summary
#: src/data/friction.js:33
msgctxt "text:unresolvedMatters.yukariRoom.summary"
msgid ""
"Professor Yakumo notes that rules require students to be inside the room, "
"not the room to be on campus. Seven arrived on time; attendance recorded "
"them next week."
msgstr "八雲教授認為規章只要求人在教室內，未規定教室必須位於校內。七名學生準時抵達，出席系統卻把他們記在下週。"

#. unresolvedMatters.yukariRoom.details.0
#: src/data/friction.js:35
msgctxt "text:unresolvedMatters.yukariRoom.details.0"
msgid "Owner"
msgstr "承辦"

#. unresolvedMatters.yukariRoom.details.1
#: src/data/friction.js:36
msgctxt "text:unresolvedMatters.yukariRoom.details.1"
msgid "Boundaries & Incidents · Nonexistent Second Floor"
msgstr "結界與異變研究院・不存在的二樓"

#. unresolvedMatters.yukariRoom.details.2
#: src/data/friction.js:37
msgctxt "text:unresolvedMatters.yukariRoom.details.2"
msgid "Current action"
msgstr "目前處置"

#. unresolvedMatters.yukariRoom.details.3
#: src/data/friction.js:38
msgctxt "text:unresolvedMatters.yukariRoom.details.3"
msgid "Make-up time posted—on the inside of the room"
msgstr "補課時間已公告，但公告貼在教室內側"

#. unresolvedMatters.yukariRoom.details.4
#: src/data/friction.js:39
msgctxt "text:unresolvedMatters.yukariRoom.details.4"
msgid "Point of dispute"
msgstr "爭點"

#. unresolvedMatters.yukariRoom.details.5
#: src/data/friction.js:40
msgctxt "text:unresolvedMatters.yukariRoom.details.5"
msgid "Whether policy can take attendance from a definition that moves on purpose"
msgstr "制度能否對故意移動的定義點名"

#. unresolvedMatters.nitoriTape.stamp
#: src/data/friction.js:44
msgctxt "text:unresolvedMatters.nitoriTape.stamp"
msgid "TEMP REPAIR · DAY 129"
msgstr "臨修第 129 日"

#. unresolvedMatters.nitoriTape.title
#: src/data/friction.js:45
msgctxt "text:unresolvedMatters.nitoriTape.title"
msgid ""
"Once kappa tape became a load-bearing part, the warranty wording became "
"highly inventive."
msgstr "河童膠帶列為承重構件後，保固條款突然變得很有創意。"

#. unresolvedMatters.nitoriTape.summary
#: src/data/friction.js:46
msgctxt "text:unresolvedMatters.nitoriTape.summary"
msgid ""
"Nitori calls the north pipe “a temporary version with an undecided date of "
"permanence.” Its leak now powers a corridor turbine, so Engineering applied "
"to list the damp patch as generation infrastructure."
msgstr "Nitori 堅稱北側水管只是「還沒決定何時永久化的臨時版本」。漏水已被接去驅動走廊的小水輪，因此工程院申請把水漬改列為發電設施。"

#. unresolvedMatters.nitoriTape.details.0
#: src/data/friction.js:48
msgctxt "text:unresolvedMatters.nitoriTape.details.0"
msgid "Owner"
msgstr "承辦"

#. unresolvedMatters.nitoriTape.details.1
#: src/data/friction.js:49
msgctxt "text:unresolvedMatters.nitoriTape.details.1"
msgid "Kappa Engineering · Honestly Temporary Repairs"
msgstr "河童工程學院・真的只是暫時修一下組"

#. unresolvedMatters.nitoriTape.details.2
#: src/data/friction.js:50
msgctxt "text:unresolvedMatters.nitoriTape.details.2"
msgid "Current action"
msgstr "目前處置"

#. unresolvedMatters.nitoriTape.details.3
#: src/data/friction.js:51
msgctxt "text:unresolvedMatters.nitoriTape.details.3"
msgid "Do not remove the tape; one strip currently provides grounding"
msgstr "請勿撕膠帶；其中一條目前負責接地"

#. unresolvedMatters.nitoriTape.details.4
#: src/data/friction.js:52
msgctxt "text:unresolvedMatters.nitoriTape.details.4"
msgid "Point of dispute"
msgstr "爭點"

#. unresolvedMatters.nitoriTape.details.5
#: src/data/friction.js:53
msgctxt "text:unresolvedMatters.nitoriTape.details.5"
msgid "Whether a power-generating leak is an incident, a facility, or an exhibit"
msgstr "會發電的漏水算事故、設備，還是展示成果"

#. unresolvedMatters.reimuDonation.stamp
#: src/data/friction.js:57
msgctxt "text:unresolvedMatters.reimuDonation.stamp"
msgid "DONATION BOX TRACE"
msgstr "募金箱追蹤"

#. unresolvedMatters.reimuDonation.title
#: src/data/friction.js:58
msgctxt "text:unresolvedMatters.reimuDonation.title"
msgid ""
"Reimu moved the Hakurei Gate repair box back to the shrine: “It works better "
"over there.”"
msgstr "博麗門修繕募金箱被靈夢本人搬回神社：『放那邊比較有用。』"

#. unresolvedMatters.reimuDonation.summary
#: src/data/friction.js:59
msgctxt "text:unresolvedMatters.reimuDonation.summary"
msgid ""
"Administration asked her to separate “gate repair” from “shrine maiden "
"upkeep.” Reimu replied that they are the same thing in rain and attached a "
"sketch of roof water dripping into her tea."
msgstr "總務處要求分開「校門修繕」與「巫女生活維持」。Reimu 回覆兩者在雨天是一回事，並附上一張屋頂漏水滴進茶杯的素描。"

#. unresolvedMatters.reimuDonation.details.0
#: src/data/friction.js:61
msgctxt "text:unresolvedMatters.reimuDonation.details.0"
msgid "Owner"
msgstr "承辦"

#. unresolvedMatters.reimuDonation.details.1
#: src/data/friction.js:62
msgctxt "text:unresolvedMatters.reimuDonation.details.1"
msgid "Hakurei Shrine · Right Side of Veranda"
msgstr "博麗神社・緣側右邊"

#. unresolvedMatters.reimuDonation.details.2
#: src/data/friction.js:63
msgctxt "text:unresolvedMatters.reimuDonation.details.2"
msgid "Current action"
msgstr "目前處置"

#. unresolvedMatters.reimuDonation.details.3
#: src/data/friction.js:64
msgctxt "text:unresolvedMatters.reimuDonation.details.3"
msgid "The box attends campus twice weekly, except on rain cancellations"
msgstr "募金箱每週二回校；雨天停課時不回"

#. unresolvedMatters.reimuDonation.details.4
#: src/data/friction.js:65
msgctxt "text:unresolvedMatters.reimuDonation.details.4"
msgid "Point of dispute"
msgstr "爭點"

#. unresolvedMatters.reimuDonation.details.5
#: src/data/friction.js:66
msgctxt "text:unresolvedMatters.reimuDonation.details.5"
msgid "Whether the shrine roof is upstream infrastructure for the gate"
msgstr "神社屋頂是否屬於校門的上游設施"

#. unresolvedMatters.patchouliLoan.stamp
#: src/data/friction.js:70
msgctxt "text:unresolvedMatters.patchouliLoan.stamp"
msgid "STACKS DEADLOCK"
msgstr "館藏僵局"

#. unresolvedMatters.patchouliLoan.title
#: src/data/friction.js:71
msgctxt "text:unresolvedMatters.patchouliLoan.title"
msgid ""
"The library requests overdue grimoires. Patchouli requests the return of the "
"120 years borrowed from them."
msgstr "圖書館要求歸還逾期魔導書；帕秋莉要求先歸還被借走的一百二十年。"

#. unresolvedMatters.patchouliLoan.summary
#: src/data/friction.js:72
msgctxt "text:unresolvedMatters.patchouliLoan.summary"
msgid ""
"Interlibrary policy forbids permanent possession of rare holdings. Scarlet "
"Library annotated “permanent” with “for whom?” The case is stuck on page "
"three of the lifespan conversion table."
msgstr "館際互借辦法寫著「稀有館藏不得永久占有」，紅魔館回函在「永久」二字旁註明：對誰而言？案件目前卡在壽命換算表第三頁。"

#. unresolvedMatters.patchouliLoan.details.0
#: src/data/friction.js:74
msgctxt "text:unresolvedMatters.patchouliLoan.details.0"
msgid "Owner"
msgstr "承辦"

#. unresolvedMatters.patchouliLoan.details.1
#: src/data/friction.js:75
msgctxt "text:unresolvedMatters.patchouliLoan.details.1"
msgid "Misty Lake Library · Long-Life Loans"
msgstr "霧湖圖書館・長命種借閱桌"

#. unresolvedMatters.patchouliLoan.details.2
#: src/data/friction.js:76
msgctxt "text:unresolvedMatters.patchouliLoan.details.2"
msgid "Current action"
msgstr "目前處置"

#. unresolvedMatters.patchouliLoan.details.3
#: src/data/friction.js:77
msgctxt "text:unresolvedMatters.patchouliLoan.details.3"
msgid "Both sides have sealed the other's recall notice"
msgstr "雙方各自封存對方的催還函"

#. unresolvedMatters.patchouliLoan.details.4
#: src/data/friction.js:78
msgctxt "text:unresolvedMatters.patchouliLoan.details.4"
msgid "Point of dispute"
msgstr "爭點"

#. unresolvedMatters.patchouliLoan.details.5
#: src/data/friction.js:79
msgctxt "text:unresolvedMatters.patchouliLoan.details.5"
msgid "Whether loan time follows the reader, librarian, or book"
msgstr "借閱期限應以讀者、館員，還是書本的時間感計算"

#. faithFaculty.byakuren.name
#: src/data/friction.js:87
msgctxt "text:faithFaculty.byakuren.name"
msgid "Byakuren Hijiri"
msgstr "聖 白蓮"

#. faithFaculty.byakuren.role
#: src/data/friction.js:88
msgctxt "text:faithFaculty.byakuren.role"
msgid "Professor of Religious Coexistence & Temple Public Life"
msgstr "宗教共生與寺院公共生活教授"

#. faithFaculty.byakuren.summary
#: src/data/friction.js:89
msgctxt "text:faithFaculty.byakuren.summary"
msgid ""
"She argues that humans and youkai can share one table, while insisting that "
"welcome does not make the temple serve every convenience. Courses co-taught "
"with Miko usually change title three times before opening."
msgstr "她主張妖怪與人類能在同一張桌上吃飯，但也會當場指出：歡迎並不代表寺院必須為每一種方便讓路。她和神子共同授課時，課程名稱通常在開課前改三次。"

#. faithFaculty.byakuren.course
#: src/data/friction.js:90
msgctxt "text:faithFaculty.byakuren.course"
msgid "FCP-214 Temples, Youkai & Arguments After Supper"
msgstr "FCP-214 寺院、妖怪與晚餐後的爭論"

#. faithFaculty.byakuren.tension
#: src/data/friction.js:91
msgctxt "text:faithFaculty.byakuren.tension"
msgid "Refuses to turn coexistence into a slogan—or let admissions use temple rites as scenery."
msgstr "拒絕把共生做成漂亮口號，也拒絕讓招生宣傳借用寺院法會當背景。"

#. faithFaculty.kanako.name
#: src/data/friction.js:95
msgctxt "text:faithFaculty.kanako.name"
msgid "Kanako Yasaka"
msgstr "八坂 神奈子"

#. faithFaculty.kanako.role
#: src/data/friction.js:96
msgctxt "text:faithFaculty.kanako.role"
msgid "Professor of Faith Infrastructure & Public Works"
msgstr "信仰基礎設施與公共工程教授"

#. faithFaculty.kanako.summary
#: src/data/friction.js:97
msgctxt "text:faithFaculty.kanako.summary"
msgid ""
"She brings ropeway, water, and festival-flow plans to class and writes "
"objections straight into version two. The problem is that version one is "
"often already under construction; Kappa Engineering calls it “preliminary "
"research with divine-speed decisions.”"
msgstr "她帶著索道、供水與祭典動線圖進教室，喜歡把反對意見直接寫進第二版計畫。問題是第一版往往已經動工；河童工程院稱這叫『具有神速決策力的前期調查』。"

#. faithFaculty.kanako.course
#: src/data/friction.js:98
msgctxt "text:faithFaculty.kanako.course"
msgid "FCP-241 Faith Economies & Projects That Won't Wait for Budget"
msgstr "FCP-241 信仰經濟與不肯等預算的工程"

#. faithFaculty.kanako.tension
#: src/data/friction.js:99
msgctxt "text:faithFaculty.kanako.tension"
msgid ""
"Asks every tradition to prove it can survive; colleagues ask her not to "
"build the proof as a ropeway first."
msgstr "要求一切傳統證明能活下去；其他教席則要求她別先把證明蓋成索道。"

#. faithFaculty.miko.name
#: src/data/friction.js:103
msgctxt "text:faithFaculty.miko.name"
msgid "Toyosatomimi no Miko"
msgstr "豐聰耳 神子"

#. faithFaculty.miko.role
#: src/data/friction.js:104
msgctxt "text:faithFaculty.miko.role"
msgid "Professor of Public Desire, Representation & Leadership"
msgstr "公共欲望、代表與領導修辭教授"

#. faithFaculty.miko.summary
#: src/data/friction.js:105
msgctxt "text:faithFaculty.miko.summary"
msgid ""
"She can hear ten desires at once and produce an elegant summary before "
"person eleven speaks. The key assignment is not to be heard, but to rebut "
"that too-perfect summary line by line."
msgstr "她能同時聽見十個人的欲望，並在第十一個人開口前給出漂亮總結。學生最重要的作業不是被她聽見，而是把那份過度漂亮的總結逐句駁回。"

#. faithFaculty.miko.course
#: src/data/friction.js:106
msgctxt "text:faithFaculty.miko.course"
msgid "FCP-266 Hearing Ten People Is Not Representing Ten People"
msgstr "FCP-266 聽見十個人不等於代表十個人"

#. faithFaculty.miko.tension
#: src/data/friction.js:107
msgctxt "text:faithFaculty.miko.tension"
msgid ""
"She genuinely revises a judgment—but usually only after someone proves in "
"public that she judged too quickly."
msgstr "她真心願意修正判斷，但通常要有人先在全場面前證明她判斷得太快。"

#. faithFaculty.sanae.name
#: src/data/friction.js:111
msgctxt "text:faithFaculty.sanae.name"
msgid "Sanae Kochiya"
msgstr "東風谷 早苗"

#. faithFaculty.sanae.role
#: src/data/friction.js:112
msgctxt "text:faithFaculty.sanae.role"
msgid "Lecturer in Festival Design & Outside-World Translation"
msgstr "祭典設計與外界文化轉譯講師"

#. faithFaculty.sanae.summary
#: src/data/friction.js:113
msgctxt "text:faithFaculty.sanae.summary"
msgid ""
"She makes spreadsheets, borrows loudspeakers, paints queue lines, and "
"cheerfully promises that “Outside universities all do this.” When they do "
"not, she posts an earnest correction—then immediately proposes a larger "
"miracle demonstration."
msgstr "她會做表格、借擴音器、畫排隊線，也會興奮地保證『外界的大學都這樣』。當全院發現外界根本不這樣時，她會認真貼出訂正——再立刻提出更大的奇蹟示範。"

#. faithFaculty.sanae.course
#: src/data/friction.js:114
msgctxt "text:faithFaculty.sanae.course"
msgid "FCP-118 Miracles, Megaphones & Rain-Smeared Run Sheets"
msgstr "FCP-118 奇蹟、擴音器與被雨淋掉的流程表"

#. faithFaculty.sanae.tension
#: src/data/friction.js:115
msgctxt "text:faithFaculty.sanae.tension"
msgid ""
"She gets four religious blocs to meetings on time; each bloc thinks "
"punctuality is a special demand placed only on them."
msgstr "她負責讓四個宗教勢力準時開會；四個勢力都認為準時是對自己的特殊要求。"

#. faithReview.name
#: src/data/friction.js:120
msgctxt "text:faithReview.name"
msgid "Eiki Shiki, Yamaxanadu"
msgstr "四季映姬・夜摩仙那度"

#. faithReview.role
#: src/data/friction.js:121
msgctxt "text:faithReview.role"
msgid "External appeals examiner · visits on the last Higan day each month"
msgstr "校外申訴審查・每月最後一個彼岸日到校"

#. faithReview.note
#: src/data/friction.js:122
msgctxt "text:faithReview.note"
msgid ""
"She does not mediate doctrine; she separates action, reason, and consequence "
"into three columns. Last month's longest ruling was one sentence: “Every "
"side failed to hear one person.”"
msgstr "她不替任何教席調停理念，只會把行為、理由與後果分成三欄。上月最長的判詞只有一句：「你們每一方都少聽了一個人。」"
