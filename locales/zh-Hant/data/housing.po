#. housingFacets.features.waterAccess
#: src/data/housing.js:11
msgctxt "text:housingFacets.features.waterAccess"
msgid "Indoor channel / waterside deck"
msgstr "室內水道／近水平台"

#. housingFacets.features.wideFlight
#: src/data/housing.js:12
msgctxt "text:housingFacets.features.wideFlight"
msgid "Wide-span flight gallery"
msgstr "大翼展回旋廊"

#. housingFacets.features.broomRack
#: src/data/housing.js:13
