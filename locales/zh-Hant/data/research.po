#. text:researchFiles.boundary.meta.2.label
#: src/data/research.js:10
msgctxt "text:researchFiles.boundary.meta.2.label"
msgid "Sample"
msgstr "樣本"

#. text:researchFiles.boundary.meta.2.value
#: src/data/research.js:10
msgctxt "text:researchFiles.boundary.meta.2.value"
msgid "1,842 unclaimed drift objects"
msgstr "1,842 件無主漂移物"

#. text:researchFiles.boundary.meta.3.label
#: src/data/research.js:11
msgctxt "text:researchFiles.boundary.meta.3.label"
msgid "Status"
msgstr "狀態"

#. text:researchFiles.boundary.meta.3.value
#: src/data/research.js:11
msgctxt "text:researchFiles.boundary.meta.3.value"
msgid "Annual index published"
msgstr "年度索引公開"

