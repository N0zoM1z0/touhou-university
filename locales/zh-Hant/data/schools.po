#. schools.boundary.name
#: src/data/schools.js:9
msgctxt "text:schools.boundary.name"
msgid "School of Boundaries & Incidents"
msgstr "結界與異變研究院"

#. schools.boundary.degree
#: src/data/schools.js:11
msgctxt "text:schools.boundary.degree"
msgid "Bachelor of Boundary Studies"
msgstr "境界學學士"

#. schools.boundary.duration
#: src/data/schools.js:12
msgctxt "text:schools.boundary.duration"
msgid "4 years · 8 terms"
msgstr "4 年・8 學期"

#. schools.boundary.intake
#: src/data/schools.js:14
msgctxt "text:schools.boundary.intake"
msgid "48 students"
msgstr "48 名"

#. schools.boundary.tuition
#: src/data/schools.js:15
msgctxt "text:schools.boundary.tuition"
msgid "¥82,000 / term"
msgstr "82,000 円／學期"

#. schools.boundary.director
#: src/data/schools.js:16
msgctxt "text:schools.boundary.director"
msgid "Dean: Yukari Yakumo"
msgstr "院長：八雲紫"

#. schools.boundary.overview
#: src/data/schools.js:17
msgctxt "text:schools.boundary.overview"
msgid ""
"Study how separation, passage, and incidents come into being. Students "
"identify everyone affected by a boundary, build a verifiable incident "
"timeline, and later run a joint exercise with explicit stop conditions."
msgstr "研究分隔、通行與異變何以成立。學生先學會判讀邊界的影響者，再練習把一場異變寫成能公開驗證的時間線；高年級須主持一次有終止條件的共同演習。"

#. schools.boundary.courses.0.1
#: src/data/schools.js:19
msgctxt "text:schools.boundary.courses.0.1"
msgid "Boundary Literacy & Safe Distance"
msgstr "境界識讀與安全距離"

#. schools.boundary.courses.1.1
#: src/data/schools.js:20
msgctxt "text:schools.boundary.courses.1.1"
msgid "Incident Field Recording"
msgstr "異變現場紀錄法"

#. schools.boundary.courses.2.1
#: src/data/schools.js:21
msgctxt "text:schools.boundary.courses.2.1"
msgid "Spell-card Rules & Exit Design"
msgstr "符卡規則與退路設計"

#. schools.boundary.courses.3.1
#: src/data/schools.js:22
msgctxt "text:schools.boundary.courses.3.1"
msgid "Great Barrier Passage Governance"
msgstr "大結界通行治理"

#. schools.boundary.courses.4.1
#: src/data/schools.js:23
msgctxt "text:schools.boundary.courses.4.1"
msgid "Joint Incident Practicum"
msgstr "共同異變演習"

#. schools.boundary.studios
#: src/data/schools.js:25
msgctxt "text:schools.boundary.studios"
msgid ""
"Choose Dream & Reality, Gap Measurement, or Incident Mediation; each studio "
"is capped at twelve."
msgstr "可選「夢境與現實」「間隙測量」「異變仲裁」三組工房；每組最多十二人。"

#. schools.boundary.fieldwork
#: src/data/schools.js:26
msgctxt "text:schools.boundary.fieldwork"
msgid ""
"From year two, students rotate through Hakurei Gate and Boundary Hall. Rifts "
"may never be widened merely to obtain data."
msgstr "二年級起於博麗門與境界講堂輪值；不得為取得資料而主動擴大裂隙。"

#. schools.boundary.progression
#: src/data/schools.js:27
msgctxt "text:schools.boundary.progression"
msgid ""
"Graduation requires 132 credits, two cross-species risk reviews, and a "
"public defence of one route deliberately not taken."
msgstr "畢業須修滿 132 學分、完成兩次跨種族風險審查，並在公開答辯中說明一條沒有採用的路線。"

#. schools.boundary.costs
#: src/data/schools.js:28
msgctxt "text:schools.boundary.costs"
msgid ""
"A ¥4,000 practicum bond is refunded if the venue, barrier, and bystanders "
"all remain intact."
msgstr "另收共同演習保證金 4,000 円；若演習後場地、結界與旁觀者均完整，學期末全額退還。"

#. schools.boundary.outcomes
#: src/data/schools.js:29
msgctxt "text:schools.boundary.outcomes"
msgid ""
"Boundary steward, incident investigator, public-safety planner, inter-campus "
"passage coordinator."
msgstr "結界管理員、異變調查員、公共安全策劃、校際通行協調員。"

#. schools.history.name
#: src/data/schools.js:36
msgctxt "text:schools.history.name"
msgid "School of History & Records"
msgstr "歷史記錄學院"

#. schools.history.degree
#: src/data/schools.js:38
msgctxt "text:schools.history.degree"
msgid "Bachelor of Record Studies"
msgstr "記錄學學士"

#. schools.history.duration
#: src/data/schools.js:39
msgctxt "text:schools.history.duration"
msgid "4 years · 8 terms"
msgstr "4 年・8 學期"

#. schools.history.intake
#: src/data/schools.js:41
msgctxt "text:schools.history.intake"
msgid "56 students"
msgstr "56 名"

#. schools.history.tuition
#: src/data/schools.js:42
msgctxt "text:schools.history.tuition"
msgid "¥68,000 / term"
msgstr "68,000 円／學期"

#. schools.history.director
#: src/data/schools.js:43
msgctxt "text:schools.history.director"
msgid "Dean: Hieda no Akyuu"
msgstr "院長：稗田阿求"

#. schools.history.overview
#: src/data/schools.js:44
msgctxt "text:schools.history.overview"
msgid ""
"Chronicles, oral accounts, terakoya texts, and youkai rumours share one "
"worktable. The accounts need not agree; students must identify who "
"remembered what and when—and who left no written record."
msgstr "把編年、口述、寺子屋教材與妖怪傳聞放在同一張工作桌上。學院不要求所有版本一致，而要求學生標明誰記得、何時記得，以及誰沒有留下文字。"

#. schools.history.courses.0.1
#: src/data/schools.js:46
msgctxt "text:schools.history.courses.0.1"
msgid "History of Gensokyo"
msgstr "幻想鄉通史"

#. schools.history.courses.1.1
#: src/data/schools.js:47
msgctxt "text:schools.history.courses.1.1"
msgid "Source Criticism & Missing Pages"
msgstr "史料校勘與缺頁學"

#. schools.history.courses.2.1
#: src/data/schools.js:48
msgctxt "text:schools.history.courses.2.1"
msgid "Oral History of Long-Lived Species"
msgstr "長命種口述史"

#. schools.history.courses.3.1
#: src/data/schools.js:49
msgctxt "text:schools.history.courses.3.1"
msgid "Terakoya Curriculum Design"
msgstr "寺子屋課程設計"

#. schools.history.courses.4.1
#: src/data/schools.js:50
msgctxt "text:schools.history.courses.4.1"
msgid "Three Histories of One Place"
msgstr "一地三史畢業檔案"

#. schools.history.studios
#: src/data/schools.js:52
msgctxt "text:schools.history.studios"
msgid ""
"Mix paper archives, oral memory, and youkai imagery. Full-moon sealed "
"records require seven days' notice."
msgstr "紙本文獻、口述記憶、妖怪圖像三條路徑可自由混修；滿月封存資料需提前七日申請。"

#. schools.history.fieldwork
#: src/data/schools.js:53
msgctxt "text:schools.history.fieldwork"
msgid ""
"Every student serves one season of village oral-history duty and logs "
"passages narrators ask to remove in a closed catalogue."
msgstr "每名學生須在人里完成一季口述史值班，並把受訪者要求刪除的段落列入不公開目錄。"

#. schools.history.progression
#: src/data/schools.js:54
msgctxt "text:schools.history.progression"
msgid ""
"At least 20 of 128 credits must use non-text sources. The capstone preserves "
"contradictory versions alongside its correction history."
msgstr "128 學分中至少 20 學分必須來自非文字材料；畢業檔案要同時保留矛盾版本與訂正紀錄。"

#. schools.history.costs
#: src/data/schools.js:55
msgctxt "text:schools.history.costs"
msgid ""
"Archive reproduction is capped at ¥2,400 per term and may be offset by "
"transcription or preservation duty."
msgstr "史料複製費每學期上限 2,400 円；以抄寫或協助防蟲維護可折抵。"

#. schools.history.outcomes
#: src/data/schools.js:56
msgctxt "text:schools.history.outcomes"
msgid "Archivist, terakoya teacher, oral historian, public-memory curator."
msgstr "檔案員、寺子屋教師、口述史研究員、公共記憶策展人。"

#. schools.magic.name
#: src/data/schools.js:63
msgctxt "text:schools.magic.name"
msgid "School of Magic Theory & Practice"
msgstr "魔法理論與實作學院"

#. schools.magic.degree
#: src/data/schools.js:65
msgctxt "text:schools.magic.degree"
msgid "Bachelor of Magic Practice"
msgstr "魔法實作學士"

#. schools.magic.duration
#: src/data/schools.js:66
msgctxt "text:schools.magic.duration"
msgid "4 years · 8 terms"
msgstr "4 年・8 學期"

#. schools.magic.intake
#: src/data/schools.js:68
msgctxt "text:schools.magic.intake"
msgid "40 students"
msgstr "40 名"

#. schools.magic.tuition
#: src/data/schools.js:69
msgctxt "text:schools.magic.tuition"
msgid "¥96,000 / term"
msgstr "96,000 円／學期"

#. schools.magic.director
#: src/data/schools.js:70
msgctxt "text:schools.magic.director"
msgid "Dean: Patchouli Knowledge"
msgstr "院長：帕秋莉・諾蕾姬"

#. schools.magic.overview
#: src/data/schools.js:71
msgctxt "text:schools.magic.overview"
msgid ""
"From Seven-Day elements to grimoires, dolls, and high-output trials, the "
"school assesses successful activation separately from safe reproducibility. "
"Students without magic can specialise in magical media and measurement."
msgstr "從七曜元素、魔導書閱讀到人偶與高輸出實驗，課程把「能不能發動」和「能不能安全重現」分開評分。沒有魔力的學生可選媒介設計與測量路線。"

#. schools.magic.courses.0.1
#: src/data/schools.js:73
msgctxt "text:schools.magic.courses.0.1"
msgid "Seven-Day Elemental Theory I"
msgstr "七曜元素論 I"

#. schools.magic.courses.1.1
#: src/data/schools.js:74
msgctxt "text:schools.magic.courses.1.1"
msgid "Grimoire Reading & Counter-Reading"
msgstr "魔導書閱讀與反讀"

#. schools.magic.courses.2.1
#: src/data/schools.js:75
msgctxt "text:schools.magic.courses.2.1"
msgid "Doll Engineering & Remote Control"
msgstr "人偶工學與遠端操作"

#. schools.magic.courses.3.1
#: src/data/schools.js:76
msgctxt "text:schools.magic.courses.3.1"
msgid "High-Output Experimental Safety"
msgstr "高輸出實驗安全"

#. schools.magic.courses.4.1
#: src/data/schools.js:77
msgctxt "text:schools.magic.courses.4.1"
msgid "Reproducible Magic Studio"
msgstr "可重現魔法製作"

#. schools.magic.studios
#: src/data/schools.js:79
msgctxt "text:schools.magic.studios"
msgid ""
"Each laboratory floor corresponds to one element. Cross-floor work needs "
"signatures from two instructors of different elements."
msgstr "七曜塔每層對應一種元素；跨層實驗要取得兩名不同元素導師簽章。"

#. schools.magic.fieldwork
#: src/data/schools.js:80
msgctxt "text:schools.magic.fieldwork"
msgid ""
"Third-years take Borrowed Magic: use only a classmate's spell and report "
"every assumption hidden in its manual."
msgstr "三年級進行「借來的魔法」實習：只能使用同學設計的術式，並回報說明書中所有猜測。"

#. schools.magic.progression
#: src/data/schools.js:81
msgctxt "text:schools.magic.progression"
msgid ""
"Complete 136 credits and two runaway-shutdown assessments. A non-magician "
"must reproduce the capstone from its diagrams."
msgstr "修滿 136 學分，通過兩次失控停機考核；畢業作品須由一名非魔法使依圖重現。"

#. schools.magic.costs
#: src/data/schools.js:82
msgctxt "text:schools.magic.costs"
msgid ""
"A ¥12,000 materials deposit is refunded when unused. Personal mushrooms "
"require spore registration and do not offset tuition."
msgstr "材料預存 12,000 円；未使用部分退回。自帶蘑菇須先經孢子登記，不抵學費。"

#. schools.magic.outcomes
#: src/data/schools.js:83
msgctxt "text:schools.magic.outcomes"
msgid "Magic researcher, spell safety officer, arcane-medium designer, doll-systems engineer."
msgstr "魔法研究員、術式安全官、魔導媒介設計師、人偶系統工程師。"

#. schools.medicine.name
#: src/data/schools.js:90
msgctxt "text:schools.medicine.name"
msgid "School of Lunar Medicine & Life"
msgstr "月都醫藥生命學院"

#. schools.medicine.degree
#: src/data/schools.js:92
msgctxt "text:schools.medicine.degree"
msgid "Bachelor of Cross-Species Medicine"
msgstr "跨種族醫藥學士"

#. schools.medicine.duration
#: src/data/schools.js:93
msgctxt "text:schools.medicine.duration"
msgid "6 years · 12 terms"
msgstr "6 年・12 學期"

#. schools.medicine.intake
#: src/data/schools.js:95
msgctxt "text:schools.medicine.intake"
msgid "32 students"
msgstr "32 名"

#. schools.medicine.tuition
#: src/data/schools.js:96
msgctxt "text:schools.medicine.tuition"
msgid "¥112,000 / term"
msgstr "112,000 円／學期"

#. schools.medicine.director
#: src/data/schools.js:97
msgctxt "text:schools.medicine.director"
msgid "Dean: Eirin Yagokoro"
msgstr "院長：八意永琳"

#. schools.medicine.overview
#: src/data/schools.js:98
msgctxt "text:schools.medicine.overview"
msgid ""
"Study pharmacology, lunar sensation, and care across different bodies. "
"Training begins with “never assume every pulse is alike” and ends with a "
"clear Eientei night-clinic handover."
msgstr "研究藥理、月相感覺與不同身體的臨床照護。課程從「不要假設所有人的脈搏相同」開始，直到學生能在永遠亭夜診中清楚交班。"

#. schools.medicine.courses.0.1
#: src/data/schools.js:100
msgctxt "text:schools.medicine.courses.0.1"
msgid "Comparative Anatomy Across Species"
msgstr "跨種族解剖概論"

#. schools.medicine.courses.1.1
#: src/data/schools.js:101
msgctxt "text:schools.medicine.courses.1.1"
msgid "Lunar Sensation & Neural Safety"
msgstr "月相感覺與神經安全"

#. schools.medicine.courses.2.1
#: src/data/schools.js:102
msgctxt "text:schools.medicine.courses.2.1"
msgid "Hourai Pharmacology & Irreversibility"
msgstr "蓬萊藥理與不可逆性"

#. schools.medicine.courses.3.1
#: src/data/schools.js:103
msgctxt "text:schools.medicine.courses.3.1"
msgid "Bamboo Emergency Navigation"
msgstr "竹林急診導航"

#. schools.medicine.courses.4.1
#: src/data/schools.js:104
msgctxt "text:schools.medicine.courses.4.1"
msgid "Eientei Clinical Rotation"
msgstr "永遠亭臨床輪值"

#. schools.medicine.studios
#: src/data/schools.js:106
msgctxt "text:schools.medicine.studios"
msgid ""
"Choose pharmacology, sensory safety, or community care. Hourai components "
"never leave the sealed teaching cabinet."
msgstr "藥理、感覺安全、社區照護三路徑；禁止把蓬萊成分帶離密封教學櫃。"

#. schools.medicine.fieldwork
#: src/data/schools.js:107
msgctxt "text:schools.medicine.fieldwork"
msgid ""
"From year four, students serve two night clinics per month, using "
"moon-rabbit transport, low-stimulus rooms, and language support as clinical "
"resources."
msgstr "四年級起每月兩次夜診輪值；月兔接駁、滿月低刺激室與語言協助均列入臨床資源。"

#. schools.medicine.progression
#: src/data/schools.js:108
msgctxt "text:schools.medicine.progression"
msgid ""
"Requires 198 credits, three simulated emergencies, complete handover "
"records, and one treatment study causing no permanent change."
msgstr "198 學分、三次模擬急診、完整交班紀錄與一項不造成永久變化的治療研究。"

#. schools.medicine.costs
#: src/data/schools.js:109
msgctxt "text:schools.medicine.costs"
msgid ""
"The clinical equipment fee is ¥8,000 per term; Eientei scholarships can "
"cover it in full through night-clinic assistance."
msgstr "臨床器材費 8,000 円／學期；永遠亭獎學金可用夜診助理時數全額折抵。"

#. schools.medicine.outcomes
#: src/data/schools.js:110
msgctxt "text:schools.medicine.outcomes"
msgid ""
"Cross-species clinician, pharmacology researcher, lunar-safety adviser, "
"bamboo emergency coordinator."
msgstr "跨種族臨床人員、藥理研究員、月相安全顧問、竹林急診協調員。"

#. schools.engineering.name
#: src/data/schools.js:117
msgctxt "text:schools.engineering.name"
msgid "School of Kappa Engineering"
msgstr "河童工程學院"

#. schools.engineering.degree
#: src/data/schools.js:119
msgctxt "text:schools.engineering.degree"
msgid "Bachelor of Public Engineering"
msgstr "公共工程學士"

#. schools.engineering.duration
#: src/data/schools.js:120
msgctxt "text:schools.engineering.duration"
msgid "4 years · 8 terms"
msgstr "4 年・8 學期"

#. schools.engineering.intake
#: src/data/schools.js:122
msgctxt "text:schools.engineering.intake"
msgid "64 students"
msgstr "64 名"

#. schools.engineering.tuition
#: src/data/schools.js:123
msgctxt "text:schools.engineering.tuition"
msgid "¥88,000 / term"
msgstr "88,000 円／學期"

#. schools.engineering.director
#: src/data/schools.js:124
msgctxt "text:schools.engineering.director"
msgid "Dean: Nitori Kawashiro"
msgstr "院長：河城荷取"

#. schools.engineering.overview
#: src/data/schools.js:125
msgctxt "text:schools.engineering.overview"
msgid ""
"Design waterpower, weather instruments, observatories, and repair systems "
"together. Every build must be dismantled, understood, and reassembled by the "
"next person. Prototype sparks are admired but ungraded."
msgstr "把水輪、氣象、觀測器與修理制度一起設計。每件作品都必須能被下一個人拆開、看懂、裝回；原型火花很受歡迎，但不計學分。"

#. schools.engineering.courses.0.1
#: src/data/schools.js:127
msgctxt "text:schools.engineering.courses.0.1"
msgid "Low-Head Hydropower Systems"
msgstr "低落差水力系統"

#. schools.engineering.courses.1.1
#: src/data/schools.js:128
msgctxt "text:schools.engineering.courses.1.1"
msgid "Measurement, Error & Mountain Weather"
msgstr "量測、誤差與妖怪山氣象"

#. schools.engineering.courses.2.1
#: src/data/schools.js:129
msgctxt "text:schools.engineering.courses.2.1"
msgid "Design for Disassembly & Repair"
msgstr "可拆修機構設計"

#. schools.engineering.courses.3.1
#: src/data/schools.js:130
msgctxt "text:schools.engineering.courses.3.1"
msgid "Public Prototypes & Village Trials"
msgstr "公共原型與村落試運轉"

#. schools.engineering.courses.4.1
#: src/data/schools.js:131
msgctxt "text:schools.engineering.courses.4.1"
msgid "Waterfall Workshop Capstone"
msgstr "瀑布工房畢業製作"

#. schools.engineering.studios
#: src/data/schools.js:133
msgctxt "text:schools.engineering.studios"
msgid ""
"Hydropower, weather, and precision-observation studios share one tool wall. "
"Whoever borrows the last wrench brings it back."
msgstr "水力、氣象、精密觀測三工房共用工具牆；拿走最後一支扳手的人負責把它帶回來。"

#. schools.engineering.fieldwork
#: src/data/schools.js:134
msgctxt "text:schools.engineering.fieldwork"
msgid ""
"Second-years complete forty maintenance hours at three village sites. "
"Failure reports must be written for the people who actually use the device."
msgstr "二年級在三處人里設施完成四十小時維修值班；故障報告必須寫給實際使用者看。"

#. schools.engineering.progression
#: src/data/schools.js:135
msgctxt "text:schools.engineering.progression"
msgid ""
"Requires 138 credits and a public prototype that runs for thirty days, plus "
"diagnosis after one component is deliberately reversed."
msgstr "138 學分與一項連續運轉三十日的公共原型；考核包含故意裝反一個零件後的診斷。"

#. schools.engineering.costs
#: src/data/schools.js:136
msgctxt "text:schools.engineering.costs"
msgid ""
"Workshop consumables cost ¥9,600. Reusable offcuts earn weight-based "
"refunds; secret screws are not reimbursable."
msgstr "工房耗材 9,600 円；交回可再用邊角料可按重量退費，祕密螺絲不接受報銷。"

#. schools.engineering.outcomes
#: src/data/schools.js:137
msgctxt "text:schools.engineering.outcomes"
msgid ""
"Water engineer, instrument designer, public-maintenance coordinator, "
"mountain-safety engineer."
msgstr "水利工程師、觀測儀器設計師、公共維修協調員、山地安全技師。"

#. schools.journalism.name
#: src/data/schools.js:144
msgctxt "text:schools.journalism.name"
msgid "School of Tengu Journalism"
msgstr "天狗新聞傳播學院"

#. schools.journalism.degree
#: src/data/schools.js:146
msgctxt "text:schools.journalism.degree"
msgid "Bachelor of Public Journalism"
msgstr "公共報導學士"

#. schools.journalism.duration
#: src/data/schools.js:147
msgctxt "text:schools.journalism.duration"
msgid "4 years · 8 terms"
msgstr "4 年・8 學期"

#. schools.journalism.intake
#: src/data/schools.js:149
msgctxt "text:schools.journalism.intake"
msgid "52 students"
msgstr "52 名"

#. schools.journalism.tuition
#: src/data/schools.js:150
msgctxt "text:schools.journalism.tuition"
msgid "¥72,000 / term"
msgstr "72,000 円／學期"

#. schools.journalism.director
#: src/data/schools.js:151
msgctxt "text:schools.journalism.director"
msgid "Dean: Aya Shameimaru"
msgstr "院長：射命丸文"

#. schools.journalism.overview
#: src/data/schools.js:152
msgctxt "text:schools.journalism.overview"
msgid ""
"Balance breaking news, photography, and public correction. Students file a "
"nine-minute version, an overnight version, then publicly identify the "
"sentence changed by new evidence."
msgstr "在速報、攝影與公共訂正之間找平衡。學生會被要求先交九分鐘版本，再交隔夜版本，最後公開說明哪一句因為新證據而改變。"

#. schools.journalism.courses.0.1
#: src/data/schools.js:154
msgctxt "text:schools.journalism.courses.0.1"
msgid "Interviewing & Source Ethics"
msgstr "採訪與消息來源倫理"

#. schools.journalism.courses.1.1
#: src/data/schools.js:155
msgctxt "text:schools.journalism.courses.1.1"
msgid "High-Speed Photography & Visual Evidence"
msgstr "高速攝影與影像證據"

#. schools.journalism.courses.2.1
#: src/data/schools.js:156
msgctxt "text:schools.journalism.courses.2.1"
msgid "Incident Breaking-News Desk"
msgstr "異變速報編輯室"

#. schools.journalism.courses.3.1
#: src/data/schools.js:157
msgctxt "text:schools.journalism.courses.3.1"
msgid "Retractions, Corrections & Trust"
msgstr "撤稿、訂正與讀者信任"

#. schools.journalism.courses.4.1
#: src/data/schools.js:158
msgctxt "text:schools.journalism.courses.4.1"
msgid "One Event, Three Reports"
msgstr "一事三報公開專題"

#. schools.journalism.studios
#: src/data/schools.js:160
msgctxt "text:schools.journalism.studios"
msgid ""
"Text, photography, and rumour-verification desks exchange one student daily "
"so no desk trusts only its own format."
msgstr "文字、攝影、風聞驗證三編輯台每日交換一名學生，避免任何一桌只相信自己的格式。"

#. schools.journalism.fieldwork
#: src/data/schools.js:161
msgctxt "text:schools.journalism.fieldwork"
msgid ""
"Complete six village morning editions and two mountain night shifts. A "
"second editor must verify every anonymous source exists."
msgstr "至少完成六次人里晨報與兩次妖怪山夜班；匿名消息來源須由第二名編輯確認存在。"

#. schools.journalism.progression
#: src/data/schools.js:162
msgctxt "text:schools.journalism.progression"
msgid ""
"Requires 126 credits, twelve public corrections, four voluntarily withdrawn "
"photographs, and a capstone with a right of reply."
msgstr "126 學分、十二則公開訂正、四張主動撤回的照片，以及一份可供當事人回應的畢業專題。"

#. schools.journalism.costs
#: src/data/schools.js:163
msgctxt "text:schools.journalism.costs"
msgid ""
"A ¥6,000 equipment bond applies. Lenses lost while chasing an exclusive do "
"not count as ordinary wear."
msgstr "攝影器材保證金 6,000 円；因追逐獨家而弄丟的鏡頭不列入正常耗損。"

#. schools.journalism.outcomes
#: src/data/schools.js:164
msgctxt "text:schools.journalism.outcomes"
msgid "Reporter, photo editor, public-information verifier, crisis-communications coordinator."
msgstr "記者、攝影編輯、公共資訊查證員、危機傳播協調員。"

#. schools.policy.name
#: src/data/schools.js:171
msgctxt "text:schools.policy.name"
msgid "School of Faith & Coexistence Policy"
msgstr "信仰與共生政策學院"

#. schools.policy.degree
#: src/data/schools.js:173
msgctxt "text:schools.policy.degree"
msgid "Bachelor of Coexistence Policy"
msgstr "共生政策學士"

#. schools.policy.duration
#: src/data/schools.js:174
msgctxt "text:schools.policy.duration"
msgid "4 years · 8 terms"
msgstr "4 年・8 學期"

#. schools.policy.intake
#: src/data/schools.js:176
msgctxt "text:schools.policy.intake"
msgid "44 students"
msgstr "44 名"

#. schools.policy.tuition
#: src/data/schools.js:177
msgctxt "text:schools.policy.tuition"
msgid "¥70,000 / term"
msgstr "70,000 円／學期"

#. schools.policy.director
#: src/data/schools.js:178
msgctxt "text:schools.policy.director"
msgid "Dean: Sanae Kochiya"
msgstr "院長：東風谷早苗"

#. schools.policy.overview
#: src/data/schools.js:179
msgctxt "text:schools.policy.overview"
msgid ""
"Study how shrines, temples, believers, non-believers, and public systems "
"share one road. Classes do not rank faith by strength; they ask whether the "
"quietest participant can safely leave."
msgstr "研究神社、寺院、信眾、無信仰者與公共制度如何共享同一條道路。課堂不評判哪一種信仰更強，而評估政策是否讓最小聲的人也能安全離席。"

#. schools.policy.courses.0.1
#: src/data/schools.js:181
msgctxt "text:schools.policy.courses.0.1"
msgid "Faith Landscapes of Gensokyo"
msgstr "幻想鄉信仰地景"

#. schools.policy.courses.1.1
#: src/data/schools.js:182
msgctxt "text:schools.policy.courses.1.1"
msgid "Interfaith Dialogue & Facilitation"
msgstr "宗教對話與主持技術"

#. schools.policy.courses.2.1
#: src/data/schools.js:183
msgctxt "text:schools.policy.courses.2.1"
msgid "Human–Youkai Coexistence Policy"
msgstr "人妖共生政策設計"

#. schools.policy.courses.3.1
#: src/data/schools.js:184
msgctxt "text:schools.policy.courses.3.1"
msgid "Festival Flow & Public Safety"
msgstr "祭典人流與公共安全"

#. schools.policy.courses.4.1
#: src/data/schools.js:185
msgctxt "text:schools.policy.courses.4.1"
msgid "Three-Party Negotiation Practicum"
msgstr "三方協議畢業實習"

#. schools.policy.studios
#: src/data/schools.js:187
msgctxt "text:schools.policy.studios"
msgid ""
"Festival governance, public mediation, and faith economy all share one "
"course: How to End a Meeting Well."
msgstr "祭典治理、公共調解、信仰經濟三路徑共用一門「如何好好散會」。"

#. schools.policy.fieldwork
#: src/data/schools.js:188
msgctxt "text:schools.policy.fieldwork"
msgid ""
"Students serve for one season at each of two institutions with different "
"affiliations, then design public guidance that asks no visitor to declare a "
"faith."
msgstr "學生須在兩個立場不同的場所各服務一季，並設計不要求訪客表態信仰的公共指引。"

#. schools.policy.progression
#: src/data/schools.js:189
msgctxt "text:schools.policy.progression"
msgid ""
"Requires 128 credits, three facilitation records, and a public agreement "
"signed by at least three parties, with dissent appended."
msgstr "128 學分、三次主持紀錄與一場至少三方簽字的公開協議；反對意見必須附在正文後。"

#. schools.policy.costs
#: src/data/schools.js:190
msgctxt "text:schools.policy.costs"
msgid ""
"Field travel costs ¥3,200 per term and can be fully offset by "
"accessible-route duty at the university festival."
msgstr "實地交通費每學期 3,200 円；在校慶擔任無障礙動線志工可全額折抵。"

#. schools.policy.outcomes
#: src/data/schools.js:191
msgctxt "text:schools.policy.outcomes"
msgid "Policy analyst, festival-safety planner, interfaith facilitator, community coordinator."
msgstr "公共政策分析員、祭典安全策劃、宗教對話主持人、社區協調員。"
