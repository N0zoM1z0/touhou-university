msgid "Turn incidents into questions,"
msgstr "把異變變成問題，"

#. Global message key: closing2
#: src/sections/about.html:6
msgctxt "text:closing2"
msgid "then return the questions to everyday life."
msgstr "再把問題帶回日常。"

