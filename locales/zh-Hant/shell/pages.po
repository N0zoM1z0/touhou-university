#. Global message key: pageHome
#: scripts/build/pages.mjs:52
msgctxt "text:pageHome"
msgid "University home"
msgstr "大學首頁"

#. Global message key: pageAcademicsTitle
#: site.config.mjs:21 src/js/i18n.js:26
msgctxt "text:pageAcademicsTitle"
msgid "Academics & Teaching"
msgstr "學術與教學"

#. Global message key: pageAcademicsLead
#: site.config.mjs:28
msgctxt "text:pageAcademicsLead"
msgid ""
"The seven schools share more than a name: they share questions that refuse "
"to stay within departmental borders."
msgstr "七所學院不只共用校名，也共用一批不肯安分待在系所邊界內的問題。"

#. Global message key: pageAdmissionsTitle
#: site.config.mjs:36 src/js/i18n.js:27
msgctxt "text:pageAdmissionsTitle"
msgid "Admissions, Applications & Examinations"
msgstr "招生、申請與試驗"

#. Global message key: pageAdmissionsLead
#: site.config.mjs:43
msgctxt "text:pageAdmissionsLead"
msgid ""
"Bring a question and choose an entry route. Papers keep time; your "
"application draft waits on this device."
msgstr "把問題帶來，選一條入學路線；試卷會計時，申請草稿則會在這台裝置上等你回來。"

#. Global message key: pageOrientationTitle
#: site.config.mjs:51 src/sections/orientation.html:5
msgctxt "text:pageOrientationTitle"
msgid "First Bell · New Student Arrival Week"
msgstr "第一鐘・新生到着週"

#. Global message key: pageOrientationLead
#: site.config.mjs:58
msgctxt "text:pageOrientationLead"
msgid ""
"Admission gets you through a gate. Arrival means recognising it, knowing the "
"way back, and choosing a real first destination."
msgstr "錄取讓你進門；報到要讓你認得門、退路，以及第一個真正想去的地方。"

#. Global message key: pageResearchTitle
#: site.config.mjs:71 src/js/i18n.js:28
msgctxt "text:pageResearchTitle"
msgid "Research Results & Open Records"
msgstr "研究成果與公開檔案"

#. Global message key: pageResearchLead
#: site.config.mjs:78
msgctxt "text:pageResearchLead"
msgid ""
"Results are more than titles: methods, failures, limits, corrections, and "
"unfinished arguments remain in the record."
msgstr "成果不只列題目：方法、失敗、限制、訂正與仍然吵不完的結論都留在檔案裡。"

#. Global message key: pageCampusTitle
#: site.config.mjs:197 src/js/i18n.js:29
msgctxt "text:pageCampusTitle"
msgid "Campus, Routes & Shared Life"
msgstr "校園、路線與共同生活"

#. Global message key: pageCampusLead
#: site.config.mjs:204
msgctxt "text:pageCampusLead"
msgid ""
"From Hakurei Gate to Eientei, routes change with transport and moon phase; "
"campus rumours usually move faster."
msgstr "從博麗門到永遠亭，路線會隨交通方式與月相改變；校園裡的傳聞通常更快。"

#. Global message key: pageMyTuTitle
#: site.config.mjs:212 src/js/i18n.js:30
msgctxt "text:pageMyTuTitle"
msgid "Records, Registration & Campus History"
msgstr "學籍、選課與校園履歷"

#. Global message key: pageMyTuLead
#: src/data/i18n.js:1
msgctxt "text:pageMyTuLead"
msgid ""
"This device remembers applications, exams, courses, and campus events; the "
"data need not leave the browser."
msgstr "這台裝置記得你的申請、試驗、課程與校園事件；資料不必離開瀏覽器。"

#. Global message key: pageLibraryTitle
#: site.config.mjs:227 src/js/i18n.js:31
msgctxt "text:pageLibraryTitle"
msgid "Misty Lake Library"
msgstr "霧湖圖書館"

#. Global message key: pageClinicTitle
#: site.config.mjs:247 src/js/i18n.js:32
msgctxt "text:pageClinicTitle"
msgid "Eientei Campus Medical Center"
msgstr "永遠亭校醫院"

#. Global message key: pageLibraryLead
#: site.config.mjs:239
msgctxt "text:pageLibraryLead"
msgid ""
"Books may fly from shelves, refuse their old position, or appear only at "
"full moon; call numbers and your loan record remain."
msgstr "館藏可能飛離書架、拒絕原位置或只在滿月可見；索書號與你的借閱紀錄仍會留下。"

#. Global message key: pageHousingTitle
#: site.config.mjs:267 src/js/i18n.js:33
msgctxt "text:pageHousingTitle"
msgid "Housing, Rooms & Roommates"
msgstr "宿舍、房間與室友"

#. Global message key: pageHousingLead
#: site.config.mjs:274
msgctxt "text:pageHousingLead"
msgid ""
"Moon phase, wingspan, water, walls, and sleep all shape allocation. A "
"suitable roommate is not trouble-free; the trouble can be discussed first."
msgstr "月相、翼展、水域、牆面與作息都會影響分房；適合的室友不是沒有麻煩，而是麻煩能先談清楚。"

#. Global message key: pageIncidentsTitle
#: site.config.mjs:101 src/sections/incidents.html:2 src/js/i18n.js:34
msgctxt "text:pageIncidentsTitle"
msgid "Campus Incident Centre & Research Simulation"
msgstr "校園事件中心與研究模擬"

#. Global message key: pageIncidentsLead
#: site.config.mjs:108
msgctxt "text:pageIncidentsLead"
msgid ""
"An incident may be controlled first, but a finding must remain falsifiable. "
"After closure, the Campus BBS has a life of its own."
msgstr "事件可以先被控制，結論必須能被推翻；至於結案後的爭論，校園 BBS 自有它的生命。"

#. Global message key: pageHomeTitle
#: src/data/i18n.js:1
msgctxt "text:pageHomeTitle"
msgid "Touhou University of Gensokyo"
msgstr "幻想鄉立東方大學"

#. Global message key: pageRecordsTitle
#: site.config.mjs:282
msgctxt "text:pageRecordsTitle"
msgid "On-device Records Cabinet"
msgstr "本機資料櫃"

#. Global message key: pageHiedaTitle
#: site.config.mjs:297 src/sections/hieda-index.html:2
msgctxt "text:pageHiedaTitle"
msgid "Hieda Campus Knowledge Graph"
msgstr "稗田校務知識圖譜"

#. Global message key: pageEthicsTitle
#: site.config.mjs:86
msgctxt "text:pageEthicsTitle"
msgid "Gensokyo Research Ethics Review Board"
msgstr "幻想鄉研究倫理審查委員會"

#. Global message key: pageFestivalTitle
#: site.config.mjs:116
msgctxt "text:pageFestivalTitle"
msgid "Spring Spell-card Lantern / Boundary Festival Operations"
msgstr "春季符卡燈會／境界開學祭營運室"

#. Global message key: pageFestivalLead
#: site.config.mjs:123
msgctxt "text:pageFestivalLead"
msgid ""
"Six desks do not sign for one another. After the opening bell, closures, "
"clinic queues, news, faith disputes, and residence night sounds run on their "
"own temperaments."
msgstr "六張桌不會互相代簽；開門鐘響後，封路、候診、新聞、信仰異議與宿舍夜聲都照各自的脾氣運轉。"

#. Global message key: pageFieldworkTitle
#: site.config.mjs:131
msgctxt "text:pageFieldworkTitle"
msgid "Domestic Placement & Field Inquiry Passport"
msgstr "境內實習與田野調查護照"

#. Global message key: pageCommonsTitle
#: site.config.mjs:146
msgctxt "text:pageCommonsTitle"
msgid "Campus Commons"
msgstr "校園公共服務館"

#. Global message key: pageCalendarTitle
#: site.config.mjs:161
msgctxt "text:pageCalendarTitle"
msgid "Gensokyo Academic Calendar"
msgstr "幻想鄉學年曆"

#. Global message key: pageCareersTitle
#: site.config.mjs:176
msgctxt "text:pageCareersTitle"
msgid "Graduation, Gensokyo Employment Market & Hyakki Yagyo Alumni"
msgstr "卒業、幻想鄉就業市場與百鬼夜行校友會"

#. Global message key: pageCareersLead
#: site.config.mjs:183
msgctxt "text:pageCareersLead"
msgid ""
"A degree does not erase disputes, and graduate whereabouts cannot be "
"compressed into a flattering percentage. State the denominator, strange "
"clauses, and your uncrossable line."
msgstr "學位不會消滅爭議；離校去向也不能壓成一個好看的百分比。先把分母、怪條款與你不願跨過的界線寫清楚。"

#. Global message key: pagePhantasmTitle
#: site.config.mjs:312
msgctxt "text:pagePhantasmTitle"
msgid "Ninth Period Roll"
msgstr "第九節點名簿"

#. Global message key: pageLocation
#: scripts/build/pages.mjs:51
msgctxt "text:pageLocation"
msgid "Page location"
msgstr "頁面位置"
