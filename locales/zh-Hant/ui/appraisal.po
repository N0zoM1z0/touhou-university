msgctxt "tree:copy#/weekly"
msgid "Drift object of the week"
msgstr "本週漂流物"

#. copy/liveNotice
#: src/js/appraisal.js:30
msgctxt "tree:copy#/liveNotice"
msgid "Duty notice on the wooden board"
msgstr "木牌值班通告"

