#: src/js/appraisal.js:30
msgctxt "tree:copy#/selected"
msgid "Currently on the bench"
msgstr "目前在桌上"

#. copy/arrival
#: src/js/appraisal.js:30
msgctxt "tree:copy#/arrival"
msgid "Recovery and transfer"
msgstr "發現與移交"

#. copy/condition
#: src/js/appraisal.js:30
msgctxt "tree:copy#/condition"
msgid "Intake condition"
msgstr "到件狀態"

#. copy/lastRecord
#: src/js/appraisal.js:30
msgctxt "tree:copy#/lastRecord"
msgid "Latest file"
msgstr "最近案卷"

#. copy/noRecord
#: src/js/appraisal.js:30
msgctxt "tree:copy#/noRecord"
msgid "Not yet closed"
msgstr "尚未結案"

#. copy/stepEvidence
#: src/js/appraisal.js:30
msgctxt "tree:copy#/stepEvidence"
msgid "One — Look at the object before the answer"
msgstr "一、先看物，不要先看答案"

#. copy/evidenceLead
#: src/js/appraisal.js:30
msgctxt "tree:copy#/evidenceLead"
msgid "Choose at least two observations to support your appraisal."
msgstr "選擇至少兩項觀察，作為鑑定依據。"

#. copy/reviewed
#: src/js/appraisal.js:30
msgctxt "tree:copy#/reviewed"
msgid "Used"
msgstr "已採用"

#. copy/stepHypothesis
#: src/js/appraisal.js:30
msgctxt "tree:copy#/stepHypothesis"
msgid "Two — Propose the original purpose"
msgstr "二、提出原用途假說"

#. copy/hypothesisLead
#: src/js/appraisal.js:30
msgctxt "tree:copy#/hypothesisLead"
msgid ""
"Choose an original purpose that fits the evidence. Rinnosuke's account is "
"one source to consider."
msgstr "選擇符合證據的原用途，並將霖之助的說法一併考慮。"

#. copy/stepTests
#: src/js/appraisal.js:30
msgctxt "tree:copy#/stepTests"
msgid "Three — Choose non-invasive tests"
msgstr "三、選擇非侵入式測試"

#. copy/testsLead
#: src/js/appraisal.js:30
msgctxt "tree:copy#/testsLead"
msgid "Choose one to three tests. Check what each test could damage before starting."
msgstr "選擇一至三項測試，開始前先確認可能造成的損傷。"

#. copy/method
#: src/js/appraisal.js:30
msgctxt "tree:copy#/method"
msgid "Method"
msgstr "方法"

#. copy/observation
#: src/js/appraisal.js:30
msgctxt "tree:copy#/observation"
msgid "Observation"
msgstr "觀察結果"

#. copy/stepUse
#: src/js/appraisal.js:30
msgctxt "tree:copy#/stepUse"
msgid "Four — Give it a next life in Gensokyo"
msgstr "四、安排它在幻想鄉的下一段用途"

#. copy/currentUse
#: src/js/appraisal.js:30
msgctxt "tree:copy#/currentUse"
msgid "New use"
msgstr "新用途"

#. copy/chooseUse
#: src/js/appraisal.js:30
msgctxt "tree:copy#/chooseUse"
msgid "Choose a present use you can explain"
msgstr "選擇一項可說明的現在用途"

#. copy/destination
#: src/js/appraisal.js:30
msgctxt "tree:copy#/destination"
msgid "Destination"
msgstr "移交去處"

#. copy/agency
#: src/js/appraisal.js:30
msgctxt "tree:copy#/agency"
msgid "Object-agency observation"
msgstr "物品意志觀察"

#. copy/fieldNote
#: src/js/appraisal.js:30
msgctxt "tree:copy#/fieldNote"
msgid "Field note"
msgstr "現場筆記"

#. copy/fieldPlaceholder
#: src/js/appraisal.js:30
msgctxt "tree:copy#/fieldPlaceholder"
msgid ""
"Record one remaining uncertainty, version gap, or the object’s reaction to "
"its proposed treatment…"
msgstr "記錄一項仍然不確定的地方、版本缺口，或物品對處置的反應……"

#. copy/autosaved
#: src/js/appraisal.js:30
msgctxt "tree:copy#/autosaved"
msgid "Draft saved on this device"
msgstr "草稿保存在這台裝置"

#. copy/clear
#: src/js/appraisal.js:30
msgctxt "tree:copy#/clear"
msgid "Clear this draft"
msgstr "清空這張草稿"

#. copy/submit
#: src/js/appraisal.js:30
msgctxt "tree:copy#/submit"
msgid "Send to the four-party appraisal meeting"
msgstr "送交四方鑑定會"

#. copy/incomplete
#: src/js/appraisal.js:30
msgctxt "tree:copy#/incomplete"
msgid ""
"The file cannot close: use at least two evidence items and one test, then "
"complete original use, new use, destination, and agency observation."
msgstr "還不能結案：至少採用兩項證據、一項測試，並填妥原用途、新用途、去處與意志觀察。"

#. copy/saved
#: src/js/appraisal.js:30
msgctxt "tree:copy#/saved"
msgid "The appraisal file is bound; My TU and the campus event ledger received copies."
msgstr "鑑定案卷已裝訂，My TU 與校園事件帳本也收到副本。"

#. copy/cleared
#: src/js/appraisal.js:30
msgctxt "tree:copy#/cleared"
msgid "The bench is clear. Previous case files were not discarded."
msgstr "桌面已清空；過去案卷沒有被丟掉。"

#. copy/supported
#: src/js/appraisal.js:30
msgctxt "tree:copy#/supported"
msgid "Purpose well supported"
msgstr "用途獲得充分支持"

#. copy/provisional
#: src/js/appraisal.js:30
msgctxt "tree:copy#/provisional"
msgid "Provisional purpose pending more port or version evidence"
msgstr "暫定用途，等待更多接口或版本證據"

#. copy/unsupported
#: src/js/appraisal.js:30
msgctxt "tree:copy#/unsupported"
msgid "Original-purpose claim unsupported"
msgstr "原用途未獲支持"

#. copy/contested
#: src/js/appraisal.js:30
msgctxt "tree:copy#/contested"
msgid "Red-pencil contested preservation"
msgstr "紅鉛筆爭議保存"

#. copy/score
#: src/js/appraisal.js:30
msgctxt "tree:copy#/score"
msgid "Appraisal completeness"
msgstr "鑑定完整度"

