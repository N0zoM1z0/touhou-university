#. copy/eyebrow
#: src/js/appraisal.js:30
msgctxt "tree:copy#/eyebrow"
msgid "KOURINDOU × MISTY LAKE LIBRARY"
msgstr "KOURINDOU × MISTY LAKE LIBRARY"

#. copy/title
#: src/js/appraisal.js:30
msgctxt "tree:copy#/title"
msgid "Outside World Drift-Object Appraisal Office"
msgstr "外界漂流物鑑定所"

#. copy/lead
#: src/js/appraisal.js:30
msgctxt "tree:copy#/lead"
msgid ""
"Identify an Outside World object, compare the evidence, and propose a use "
"for it. Rinnosuke can tell you its name; Nitori would like to open the "
"casing."
msgstr "選一件外界物品，比對證據並提出用途。霖之助能告訴你名稱；荷取則想拆開外殼看看。"

#. copy/open
#: src/js/appraisal.js:30
msgctxt "tree:copy#/open"
msgid "Appraisal desk accepting cases"
msgstr "鑑定桌開放中"

#. copy/closed
#: src/js/appraisal.js:30
msgctxt "tree:copy#/closed"
msgid "Appraisal desk closed for today"
msgstr "今日鑑定桌已收起"

#. copy/libraryHours
#: src/js/appraisal.js:30
msgctxt "tree:copy#/libraryHours"
msgid "Library"
msgstr "圖書館"

#. copy/queue
#: src/js/appraisal.js:30
msgctxt "tree:copy#/queue"
msgid "Awaiting appraisal"
msgstr "待鑑定"

