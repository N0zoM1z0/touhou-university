msgstr "漂流物送件架"

#. copy/scrollObjects
#: src/js/appraisal.js:30
msgctxt "tree:copy#/scrollObjects"
msgid "Slide the shelf left or right · 8 files"
msgstr "送件架可左右翻動，共八件"

