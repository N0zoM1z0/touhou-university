msgctxt "text:paths.applicant.lead"
msgid "Compare schools, try an entrance paper, and start your application."
msgstr "比較學院、試做入學試卷，再開始填寫申請。"

#. paths.applicant.actions.0.1
#: src/js/audiences.js:24
msgctxt "text:paths.applicant.actions.0.1"
msgid "Compare seven schools"
msgstr "比較七所學院"

#. paths.applicant.actions.1.1
#: src/js/audiences.js:25
msgctxt "text:paths.applicant.actions.1.1"
msgid "Try the entrance exam"
msgstr "挑戰入學試驗"

#. paths.applicant.actions.2.1
#: src/js/audiences.js:26
msgctxt "text:paths.applicant.actions.2.1"
msgid "Take the Gensokyo exam"
