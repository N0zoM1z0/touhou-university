#: src/js/audiences.js:10
msgctxt "text:paths.visitor.lead"
msgid "Get to know the university, find your way around, or book a campus visit."
msgstr "先認識大學、看看地圖，或預約一次參訪。"

#. paths.visitor.actions.0.1
#: src/js/audiences.js:12
msgctxt "text:paths.visitor.actions.0.1"
msgid "Meet the university"
msgstr "認識學校"

#. paths.visitor.actions.1.1
#: src/js/audiences.js:13
msgctxt "text:paths.visitor.actions.1.1"
msgid "Open campus map"
msgstr "打開校園地圖"

#. paths.visitor.actions.2.1
#: src/js/audiences.js:14
msgctxt "text:paths.visitor.actions.2.1"
msgid "Reserve a visit"
msgstr "預約進校"

#. paths.visitor.actions.3.1
#: src/js/audiences.js:15
msgctxt "text:paths.visitor.actions.3.1"
msgid "Explore campus life"
msgstr "看看校園生活"

#. paths.applicant.label
#: src/js/audiences.js:20
msgctxt "text:paths.applicant.label"
msgid "Applicant"
msgstr "申請生"

