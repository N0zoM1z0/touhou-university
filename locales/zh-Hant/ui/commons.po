#. copy/eyebrow
#: src/js/commons.js:50
msgctxt "tree:copy#/eyebrow"
msgid "CAMPUS COMMONS / TSUKUMOGAMI TITLE × TENGU POST"
msgstr "CAMPUS COMMONS / 付喪神物權 × 鴉天狗郵便"

#. copy/title
#: src/js/commons.js:50
msgctxt "tree:copy#/title"
msgid "Lost Property & Tengu Post"
msgstr "失物窗口與天狗郵便"

#. copy/lead
#: src/js/commons.js:50
msgctxt "tree:copy#/lead"
msgid ""
"File a claim, hear what the object has to say, or check your post. Keep an "
"eye on the date: some letters arrive ahead of their applications."
msgstr "提出申領、聽聽物品的說法，或查看郵件。請留意日期，有些信會比申請早到。"

#. copy/propertyTab
#: src/js/commons.js:50
msgctxt "tree:copy#/propertyTab"
msgid "Lost property & title"
msgstr "失物與物權"

#. copy/postTab
#: src/js/commons.js:50
msgctxt "tree:copy#/postTab"
