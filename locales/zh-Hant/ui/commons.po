#: src/js/commons.js:50
msgctxt "tree:copy#/submitClaim"
msgid "Send to four-seat hearing"
msgstr "送入四席聽證"

#. copy/claimantError
#: src/js/commons.js:50
msgctxt "tree:copy#/claimantError"
msgid "The claimant name needs at least two characters."
msgstr "申請人名稱至少需要兩個字元。"

