msgstr "要先承認物件本人在這宗案子裡有一張椅子。"

#. copy/hearingTitle
#: src/js/commons.js:50
msgctxt "tree:copy#/hearingTitle"
msgid "Four seats leave separate opinions"
msgstr "四席各自留下意見"

#. copy/hearingLead
#: src/js/commons.js:50
msgctxt "tree:copy#/hearingLead"
msgid "Read each of the four opinions before accepting the ruling."
msgstr "接受裁定前，請閱讀四位審查者各自的意見。"

