#: src/js/eientei-map.js:27
msgctxt "tree:copy#/route"
msgid "Calculate bamboo route"
msgstr "計算竹林路線"

#. copy/minutes
#: src/js/eientei-map.js:27
msgctxt "tree:copy#/minutes"
msgid "min"
msgstr "分鐘"

#. copy/steps
#: src/js/eientei-map.js:27
msgctxt "tree:copy#/steps"
msgid "segments"
msgstr "段路"

#. copy/status
#: src/js/eientei-map.js:27
msgctxt "tree:copy#/status"
msgid "Tonight's route status"
msgstr "今晚的路況"

#. copy/day
#: src/js/eientei-map.js:27
msgctxt "tree:copy#/day"
msgid "Day: paper signs are legible. Yesterday's Clearing is not guaranteed to exist."
msgstr "日間：紙牌路標可讀，昨日的空地不保證存在。"

#. copy/dusk
#: src/js/eientei-map.js:27
msgctxt "tree:copy#/dusk"
msgid "Dusk: rabbit lamps are being lit; add one minute at the east gate."
msgstr "黃昏：兔燈正在點亮，東口候車時間增加一分鐘。"

#. copy/night
#: src/js/eientei-map.js:27
msgctxt "tree:copy#/night"
msgid "Night: follow three lanterns. Do not follow a fourth."
msgstr "夜間：跟三盞燈走，不要跟第四盞燈走。"

#. copy/full
#: src/js/eientei-map.js:27
msgctxt "tree:copy#/full"
msgid "Full-moon control: the main-house clinic corridor is closed; divert through Pharmacy."
msgstr "滿月管制：本館至診療所直廊封閉，先經調劑室。"

#. copy/new
#: src/js/eientei-map.js:27
msgctxt "tree:copy#/new"
msgid "New-moon shortcut: the scented path from Three-Lantern Fork to Pharmacy is open."
msgstr "朔月捷徑：三盞燈岔路至調劑室的藥香小徑開放。"

#. copy/shift/0
#: src/js/eientei-map.js:27
msgctxt "tree:copy#/shift/0"
msgid "Leaves point east; the old north path is shorter."
msgstr "竹葉向東，北側舊路縮短。"

#. copy/shift/1
#: src/js/eientei-map.js:27
msgctxt "tree:copy#/shift/1"
msgid "Leaves point south; Yesterday's Clearing shifts one square west."
msgstr "竹葉向南，昨日的空地向西移一格。"

#. copy/shift/2
#: src/js/eientei-map.js:27
msgctxt "tree:copy#/shift/2"
msgid "Leaves point west; the rabbit road is drier."
msgstr "竹葉向西，兔車道較乾燥。"

#. copy/start
#: src/js/eientei-map.js:27
msgctxt "tree:copy#/start"
msgid "Start"
msgstr "起點"

#. copy/arrive
#: src/js/eientei-map.js:27
msgctxt "tree:copy#/arrive"
msgid "Arrive"
msgstr "抵達"

#. copy/noRoute
#: src/js/eientei-map.js:27
msgctxt "tree:copy#/noRoute"
msgid ""
"No reliable route at this hour. Return east and wait for a rabbit shuttle "
"displaying today's date."
msgstr "這個時刻沒有可靠路線。請回東口等一輛寫著今日日期的兔車。"
