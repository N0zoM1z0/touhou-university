msgid "Finding Eientei"
msgstr "前往永遠亭"

#. copy/lead
#: src/js/eientei-map.js:27
msgctxt "tree:copy#/lead"
msgid ""
"Bamboo paths rotate daily. Check today's map and moon phase; at night, "
"follow the rabbit lamps. Full-moon clinic traffic goes via the pharmacy."
msgstr "竹林岔路每天變動，請確認今日地圖與月相；夜間沿兔燈前進。滿月診療路線會繞經藥局。"

#. copy/back
#: src/js/eientei-map.js:27
msgctxt "tree:copy#/back"
msgid "Back to main campus"
msgstr "返回主校區"

#. copy/hospital
#: src/js/eientei-map.js:27
msgctxt "tree:copy#/hospital"
msgid "Open hospital triage"
msgstr "前往校醫院分診台"

#. copy/now
#: src/js/eientei-map.js:27
msgctxt "tree:copy#/now"
msgid "Device time"
msgstr "本機時間"

