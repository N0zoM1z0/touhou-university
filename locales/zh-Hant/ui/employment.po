#. copy/eyebrow
#: src/js/employment.js:42
msgctxt "tree:copy#/eyebrow"
msgid "GENSOKYO EMPLOYMENT MARKET / FOR THOSE LEAVING WITH PROBLEMS"
msgstr "GENSOKYO EMPLOYMENT MARKET / 離校後仍有問題的人"

#. copy/title
#: src/js/employment.js:42
msgctxt "tree:copy#/title"
msgid "Find work in Gensokyo."
msgstr "在幻想鄉找工作。"

