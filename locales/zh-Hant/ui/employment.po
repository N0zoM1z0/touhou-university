#. copy/eyebrow
#: src/js/employment.js:42
msgctxt "tree:copy#/eyebrow"
msgid "GENSOKYO EMPLOYMENT MARKET / FOR THOSE LEAVING WITH PROBLEMS"
msgstr "GENSOKYO EMPLOYMENT MARKET / 離校後仍有問題的人"

#. copy/title
#: src/js/employment.js:42
msgctxt "tree:copy#/title"
msgid "We do not publish one flattering employment rate. First declare how you counted."
msgstr "我們不公佈一個好看的就業率；先說清楚你打算怎麼數。"

#. copy/lead
#: src/js/employment.js:42
msgctxt "tree:copy#/lead"
msgid ""
"Is a half-phantom one graduate, two, or one and a half? Is posthumous Sanzu "
"duty retention or pre-reincarnation unemployment? If work becomes an "
"incident first, is it work or incident? Careers preserves denominators, "
"testimony, and objections while the notice rack continues hiring."
msgstr "一名半靈算一位、兩位還是一份半？死後仍在三途川值班算留任還是轉生前待業？工作先變成異變又該算工作還是異變？進路室保留分母、口供與反對意見，招聘架則照常招人。"

#. copy/jobs
#: src/js/employment.js:42
msgctxt "tree:copy#/jobs"
msgid "notices still hiring"
msgstr "張仍在招人的告示"

#. copy/applications
#: src/js/employment.js:42
msgctxt "tree:copy#/applications"
msgid "odd résumés dispatched"
msgstr "份怪歷書已寄出"

#. copy/attestations
#: src/js/employment.js:42
msgctxt "tree:copy#/attestations"
msgid "on-device whereabouts statements"
msgstr "份本機去向口供"

#. copy/outcomesNav
#: src/js/employment.js:42
msgctxt "tree:copy#/outcomesNav"
msgid "Whereabouts Echo Roll"
msgstr "離校去向回聲簿"

#. copy/marketNav
#: src/js/employment.js:42
msgctxt "tree:copy#/marketNav"
msgid "Recruitment Notice Rack"
msgstr "招聘告示架"

#. copy/recordsNav
#: src/js/employment.js:42
msgctxt "tree:copy#/recordsNav"
msgid "My applications & replies"
msgstr "我的投遞與回音"

#. copy/censusEyebrow
#: src/js/employment.js:42
msgctxt "tree:copy#/censusEyebrow"
msgid "COHORT 146 / DENOMINATOR HEARING"
msgstr "COHORT 146 / DENOMINATOR HEARING"

#. copy/censusTitle
#: src/js/employment.js:42
msgctxt "tree:copy#/censusTitle"
msgid "One graduating cohort produces a different Gensokyo under every counting rule."
msgstr "同一屆畢業生，不同數法會得到不同的幻想鄉。"

#. copy/censusLead
#: src/js/employment.js:42
msgctxt "tree:copy#/censusLead"
msgid ""
"The categories may overlap, so their sum intentionally differs from the "
"denominator. Akyuu keeps overlap, Keine demands a date on each roll, and Aya "
"already drafted a headline for the largest number."
msgstr "下列分類可以同時成立，總和故意不等於分母。阿求拒絕把重疊抹掉，慧音要求每次點名寫清日期，文則已經替最大的一個數字擬好標題。"

#. copy/basis
#: src/js/employment.js:42
msgctxt "tree:copy#/basis"
msgid "What counts as one"
msgstr "這次按什麼數"

#. copy/observation
#: src/js/employment.js:42
msgctxt "tree:copy#/observation"
msgid "When to observe"
msgstr "在哪個時刻看"

#. copy/denominator
#: src/js/employment.js:42
msgctxt "tree:copy#/denominator"
msgid "Current denominator"
msgstr "本次分母"

#. copy/statements
#: src/js/employment.js:42
msgctxt "tree:copy#/statements"
msgid "Valid whereabouts claims"
msgstr "有效去向口供"

#. copy/overlap
#: src/js/employment.js:42
msgctxt "tree:copy#/overlap"
msgid "Overlap / contested seats"
msgstr "重疊／爭議席"

#. copy/notRate
#: src/js/employment.js:42
msgctxt "tree:copy#/notRate"
msgid "Not an employment rate"
msgstr "不是就業率"

#. copy/denominatorNote
#: src/js/employment.js:42
msgctxt "tree:copy#/denominatorNote"
msgid "Denominator hearing"
msgstr "分母聽證"

#. copy/localAdded
#: src/js/employment.js:42
msgctxt "tree:copy#/localAdded"
msgid "Includes this device's statements"
msgstr "含這台裝置的口供"

#. copy/attestTitle
#: src/js/employment.js:42
msgctxt "tree:copy#/attestTitle"
msgid "Place your whereabouts in the echo roll"
msgstr "把你的去向放進回聲簿"

#. copy/attestLead
#: src/js/employment.js:42
msgctxt "tree:copy#/attestLead"
msgid ""
"This statement stays on this device. It joins the current roll and may be "
"disputed on BBS by another graduate."
msgstr "這份口供只保存在本機；它會加入目前的去向點名，也可能在 BBS 被另一位畢業生反對。"

#. copy/name
#: src/js/employment.js:42
msgctxt "tree:copy#/name"
msgid "Name used by this edition of you"
msgstr "你在這一版使用的名字"

#. copy/outcome
#: src/js/employment.js:42
msgctxt "tree:copy#/outcome"
msgid "Closest present whereabouts"
msgstr "目前最接近的去向"

#. copy/simultaneous
#: src/js/employment.js:42
msgctxt "tree:copy#/simultaneous"
msgid "This is not exclusive; another employer simultaneously claims me"
msgstr "這不是唯一去向；我同時還被另一處認領"

#. copy/note
#: src/js/employment.js:42
msgctxt "tree:copy#/note"
msgid "Actual situation / what statistics must not erase"
msgstr "實際情況／哪一點不准被統計抹掉"

#. copy/attestSubmit
#: src/js/employment.js:42
msgctxt "tree:copy#/attestSubmit"
msgid "Leave an on-device statement"
msgstr "留下本機口供"

#. copy/attested
#: src/js/employment.js:42
msgctxt "tree:copy#/attested"
msgid "Your whereabouts statement entered the echo roll; the denominator retains appeal rights."
msgstr "去向口供已夾入回聲簿；分母仍保留申訴權。"

#. copy/marketEyebrow
#: src/js/employment.js:42
msgctxt "tree:copy#/marketEyebrow"
msgid "CLASSIFIEDS / MAY SMOKE, MOVE, OR HAVE HIRED YOU"
msgstr "CLASSIFIEDS / 會冒煙、會移動、可能已錄用你"

#. copy/marketTitle
#: src/js/employment.js:42
msgctxt "tree:copy#/marketTitle"
msgid "Twenty-one notices; none promises the job begins before the incident."
msgstr "二十一張招聘告示，沒有一張保證工作比異變先開始。"

#. copy/marketLead
#: src/js/employment.js:42
msgctxt "tree:copy#/marketLead"
msgid ""
"Filter by trouble, view of time, and risk seals. Open a post for a shareable "
"exact link, full strange clauses, a trial task, and an odd résumé that "
"actually submits."
msgstr "先按麻煩種類、時間觀與風險過濾。點開職缺會得到可分享的固定連結、完整怪條款、試工題與一張真正能投遞的怪歷書。"

#. copy/category
#: src/js/employment.js:42
msgctxt "tree:copy#/category"
msgid "Kind of trouble"
msgstr "麻煩種類"

#. copy/schedule
#: src/js/employment.js:42
msgctxt "tree:copy#/schedule"
msgid "Employer's view of time"
msgstr "上班採用的時間觀"

#. copy/risk
#: src/js/employment.js:42
msgctxt "tree:copy#/risk"
msgid "Maximum risk seals"
msgstr "最多接受幾枚風險印"

#. copy/found
#: src/js/employment.js:42
msgctxt "tree:copy#/found"
msgid "notices match"
msgstr "張告示符合"

#. copy/open
#: src/js/employment.js:42
msgctxt "tree:copy#/open"
msgid "Open recruitment notice"
msgstr "拆開招聘告示"

#. copy/pay
#: src/js/employment.js:42
msgctxt "tree:copy#/pay"
msgid "Settlement"
msgstr "結算"

#. copy/scheduleLabel
#: src/js/employment.js:42
msgctxt "tree:copy#/scheduleLabel"
msgid "Time"
msgstr "時間"

#. copy/danger
#: src/js/employment.js:42
msgctxt "tree:copy#/danger"
msgid "Risk"
msgstr "風險"

#. copy/dangerUnit
#: src/js/employment.js:42
msgctxt "tree:copy#/dangerUnit"
msgid "seals"
msgstr "枚"

#. copy/posterAlt
#: src/js/employment.js:42
msgctxt "tree:copy#/posterAlt"
msgid "Illustrated Gensokyo recruitment notice"
msgstr "幻想鄉招聘告示插畫"

#. copy/noResults
#: src/js/employment.js:42
msgctxt "tree:copy#/noResults"
msgid ""
"No employer admits matching these terms. Add one risk seal or wait for the "
"gate to swap sides."
msgstr "沒有雇主承認符合這組條件。把風險加一，或等門換一邊再查。"

#. copy/fileEyebrow
#: src/js/employment.js:42
msgctxt "tree:copy#/fileEyebrow"
msgid "FULL RECRUITMENT FILE / NOT A FATE GUARANTEE"
msgstr "FULL RECRUITMENT FILE / 不構成命運保證"

