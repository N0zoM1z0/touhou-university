msgstr "實際工作"

#. copy/compensation
#: src/js/employment.js:42
msgctxt "tree:copy#/compensation"
msgid "Wages & exchange"
msgstr "薪資與交換"

#. copy/impossibleClause
#: src/js/employment.js:42
msgctxt "tree:copy#/impossibleClause"
msgid "Clause most likely eaten by fine print"
msgstr "最容易被小字吃掉的條款"

#. copy/trial
#: src/js/employment.js:42
msgctxt "tree:copy#/trial"
msgid "Trial task"
msgstr "試工題"

#. copy/employerReply
#: src/js/employment.js:42
msgctxt "tree:copy#/employerReply"
msgid "Employer's usual reply"
msgstr "這家雇主通常怎麼回"

#. copy/print
#: src/js/employment.js:42
msgctxt "tree:copy#/print"
msgid "Print / save this notice"
msgstr "列印／另存這張告示"

#. copy/share
#: src/js/employment.js:42
msgctxt "tree:copy#/share"
msgid "Share this vacancy"
msgstr "分享此職缺"

#. copy/applyTitle
#: src/js/employment.js:42
msgctxt "tree:copy#/applyTitle"
msgid "Dispatch an odd résumé"
msgstr "寄出一份怪歷書"

#. copy/applyLead
#: src/js/employment.js:42
msgctxt "tree:copy#/applyLead"
msgid ""
"Careers will not beautify abilities or interpret “willing to suffer” as "
"surrendering boundaries. The employer returns an immediately disputable "
"first review."
msgstr "進路室不替你美化能力，也不把『願意吃苦』當作放棄界線。雇主會立刻回一份可爭議的初審。"

#. copy/degree
#: src/js/employment.js:42
msgctxt "tree:copy#/degree"
msgid "Degree number (blank applications remain valid)"
msgstr "學位號（沒有也可投；雇主會看見空白）"

#. copy/strength
#: src/js/employment.js:42
msgctxt "tree:copy#/strength"
msgid "Something you actually did, even if it sounds unlike experience"
msgstr "你真正做過、即使聽起來不像經驗的事"

#. copy/boundary
#: src/js/employment.js:42
msgctxt "tree:copy#/boundary"
msgid "A boundary you will not cross"
msgstr "你不願跨過的界線"

#. copy/desiredPay
#: src/js/employment.js:42
msgctxt "tree:copy#/desiredPay"
msgid "How you expect settlement"
msgstr "你希望如何結算"

#. copy/availability
#: src/js/employment.js:42
msgctxt "tree:copy#/availability"
msgid "Time in which you can report"
msgstr "你能在哪一種時間裡到班"

#. copy/availabilityOptions/ordinary
#: src/js/employment.js:42
msgctxt "tree:copy#/availabilityOptions/ordinary"
msgid "Ordinary continuous time"
msgstr "一般連續時間"

#. copy/availabilityOptions/night
#: src/js/employment.js:42
msgctxt "tree:copy#/availabilityOptions/night"
msgid "Night / underground time"
msgstr "夜班／地下時間"

#. copy/availabilityOptions/lunar
#: src/js/employment.js:42
msgctxt "tree:copy#/availabilityOptions/lunar"
msgid "Lunar rota"
msgstr "月相排班"

#. copy/availabilityOptions/nonlinear
#: src/js/employment.js:42
msgctxt "tree:copy#/availabilityOptions/nonlinear"
msgid "Non-linear / stopped time"
msgstr "非線性／停止時間"

#. copy/availabilityOptions/afterlife
#: src/js/employment.js:42
msgctxt "tree:copy#/availabilityOptions/afterlife"
msgid "Negotiable after death"
msgstr "死後仍可商議"

#. copy/nonlinearReady
#: src/js/employment.js:42
msgctxt "tree:copy#/nonlinearReady"
msgid "Even if time stops, my shift requires an explicit ending"
msgstr "若時間停止，我仍要求班次有明確結束方式"

#. copy/clauseAccepted
#: src/js/employment.js:42
msgctxt "tree:copy#/clauseAccepted"
msgid "I saw the strange clause; this does not waive appeal"
msgstr "我已讀到上方怪條款；這只表示看見，不表示放棄申訴"

#. copy/submit
#: src/js/employment.js:42
msgctxt "tree:copy#/submit"
msgid "Give to crow-tengu dispatch"
msgstr "交給鴉天狗寄發臺"

#. copy/draftSaved
#: src/js/employment.js:42
msgctxt "tree:copy#/draftSaved"
msgid "Odd résumé draft is stored only on this device"
msgstr "怪歷書草稿只保存在這台裝置"

#. copy/submitted
#: src/js/employment.js:42
msgctxt "tree:copy#/submitted"
msgid "Odd résumé dispatched; the employer's first-edition reply has arrived."
msgstr "怪歷書已寄出；雇主的第一版回音也已抵達。"

#. copy/formError
#: src/js/employment.js:42
msgctxt "tree:copy#/formError"
msgid ""
"Add a name, at least eight characters of experience and boundaries, and "
"confirm you saw the clause."
msgstr "請補上名字、至少八字的經驗與界線，並確認你確實看見怪條款。"

#. copy/responseTitle
#: src/js/employment.js:42
msgctxt "tree:copy#/responseTitle"
msgid "How will you answer this reply?"
msgstr "你要怎麼回這份回音？"

#. copy/responseLead
#: src/js/employment.js:42
msgctxt "tree:copy#/responseLead"
msgid ""
"Accepting a trial is not accepting every clause; requesting correction is "
"not rejection. Adjacent-timeline hires especially require this page's "
"applicant to answer again."
msgstr "接受試工不等於接受全部條款；要求訂正也不等於拒絕。相鄰時間線的錄用尤其需要本人在這一頁再表態一次。"

#. copy/responseNote
#: src/js/employment.js:42
msgctxt "tree:copy#/responseNote"
msgid "Note for edition two"
msgstr "要寫進第二版的備註"

#. copy/responses/trial
#: src/js/employment.js:42
msgctxt "tree:copy#/responses/trial"
msgid "Accept one-shift trial"
msgstr "接受一班試工"

#. copy/responses/correction
#: src/js/employment.js:42
msgctxt "tree:copy#/responses/correction"
msgid "Request clause correction"
msgstr "要求訂正條款"

#. copy/responses/adjacent
#: src/js/employment.js:42
msgctxt "tree:copy#/responses/adjacent"
msgid "Provisionally accept adjacent hire"
msgstr "暫認相鄰錄用"

#. copy/responses/hold
#: src/js/employment.js:42
msgctxt "tree:copy#/responses/hold"
msgid "Hold for moon / date"
msgstr "保留，等月相／日期"

#. copy/responses/decline
#: src/js/employment.js:42
msgctxt "tree:copy#/responses/decline"
msgid "I reject this edition"
msgstr "由我拒絕這一版"

#. copy/responded
#: src/js/employment.js:42
msgctxt "tree:copy#/responded"
msgid "Edition-two reply saved. Tengu Post and BBS will each misunderstand it once."
msgstr "第二版回音已保存，鴉天狗郵便與 BBS 會各自誤解一次。"

#. copy/recordsEyebrow
#: src/js/employment.js:42
msgctxt "tree:copy#/recordsEyebrow"
msgid "MY APPLICATIONS / THIS DEVICE ONLY"
msgstr "MY APPLICATIONS / 只在這台裝置"

#. copy/recordsTitle
#: src/js/employment.js:42
msgctxt "tree:copy#/recordsTitle"
msgid "Applications, first reviews, and your replies survive closing the card."
msgstr "投遞、初審與本人回覆都不會在關掉卡片後消失。"

#. copy/recordsLead
#: src/js/employment.js:42
msgctxt "tree:copy#/recordsLead"
msgid ""
"Each record retains the vacancy, employer review, and your edition-two "
"response; export them together from the on-device cabinet."
msgstr "每份回音保留職缺、初審版本與你的第二版表態；可在本機資料櫃一起匯出。"

#. copy/noRecords
#: src/js/employment.js:42
msgctxt "tree:copy#/noRecords"
msgid "No odd résumé has left this device yet."
msgstr "這台裝置尚未寄出怪歷書。"

#. copy/openRecord
#: src/js/employment.js:42
msgctxt "tree:copy#/openRecord"
msgid "Open application file"
msgstr "查看投遞卷"

#. copy/submittedAt
#: src/js/employment.js:42
msgctxt "tree:copy#/submittedAt"
msgid "Sent"
msgstr "寄出"

#. copy/status
#: src/js/employment.js:42
msgctxt "tree:copy#/status"
msgid "Current edition"
msgstr "目前版次"

#. copy/reviewed
#: src/js/employment.js:42
msgctxt "tree:copy#/reviewed"
msgid "Employer review"
msgstr "雇主初審"

#. copy/responseSaved
#: src/js/employment.js:42
msgctxt "tree:copy#/responseSaved"
msgid "Applicant replied"
msgstr "本人已回覆"

#. copy/attestationError
#: src/js/employment.js:42
msgctxt "tree:copy#/attestationError"
msgid "Add a name, whereabouts, and at least eight characters of actual context."
msgstr "請留下名字、去向與至少八字的實際情況。"

#. copy/shareCopied
#: src/js/employment.js:42
msgctxt "tree:copy#/shareCopied"
msgid "Vacancy link copied."
msgstr "職缺連結已複製。"
