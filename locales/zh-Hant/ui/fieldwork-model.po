msgid "Purpose and stop command declared"
msgstr "事前聲明用途與停止口令"

#. abilityLabels.supervised
#: src/js/fieldwork-model.js:254
msgctxt "text:abilityLabels.supervised"
msgid "Use only with supervisor present"
msgstr "只在指導者在場時使用"

#. abilityLabels.sealed
#: src/js/fieldwork-model.js:255
msgctxt "text:abilityLabels.sealed"
msgid "Sealed before departure; jointly released after return"
msgstr "出發前封印；返校後共同解封"

#. emergencyLabels.return-bell
#: src/js/fieldwork-model.js:259
msgctxt "text:emergencyLabels.return-bell"
msgid "Three-tone return bell"
msgstr "三聲返校鈴"

#. emergencyLabels.buddy-rope
#: src/js/fieldwork-model.js:260
msgctxt "text:emergencyLabels.buddy-rope"
msgid "Buddy return rope"
msgstr "雙人回程繩"

#. emergencyLabels.host-escort
#: src/js/fieldwork-model.js:261
msgctxt "text:emergencyLabels.host-escort"
msgid "Host-escorted exit"
msgstr "場地主持陪同撤離"

#. emergencyLabels.clinic-route
#: src/js/fieldwork-model.js:262
msgctxt "text:emergencyLabels.clinic-route"
msgid "Pre-filed Eientei / infirmary route"
msgstr "永遠亭／校醫務室預先路線"

#. assessFieldworkDraft.0.0
#: src/js/fieldwork-model.js:270
msgctxt "text:assessFieldworkDraft.0.0"
msgid "{value0} of three listed items selected; the host must verify the rest."
msgstr "三件指定裝備只登記了 {value0} 件；其餘由場地主持覆核。"

#. assessFieldworkDraft.0.0
#: src/js/fieldwork-model.js:273
msgctxt "text:assessFieldworkDraft.0.0.2"
msgid "High/variable-risk stations require a buddy or medical exit line at dispatch."
msgstr "高／變動風險站須在出發桌另畫雙人或醫療退場線。"

#. assessFieldworkDraft.0.0
#: src/js/fieldwork-model.js:276
msgctxt "text:assessFieldworkDraft.0.0.3"
msgid ""
"Clinical or mental-information work still needs encounter-by-encounter "
"consent after declaration."
msgstr "涉及臨床或精神資訊時，能力聲明仍需在現場逐次取得同意。"

#. note
#: src/js/fieldwork-model.js:388
msgctxt "text:note"
msgid "{value0}: Observation, report, and unresolved matters remain distinct. Seal granted."
msgstr "{value0}：能分清看見的、聽來的與仍未解決的；准予蓋章。"

#. note
#: src/js/fieldwork-model.js:390
msgctxt "text:note.2"
msgid ""
"{value0}: Passport may be stamped; keep the annex. Next time, place sources "
"before the conclusion."
msgstr "{value0}：護照可以蓋，附件不可丟；下次先把來源寫在結論前。"

#. note
#: src/js/fieldwork-model.js:391
msgctxt "text:note.3"
msgid ""
"{value0}: Return certified, but the dispute must not become a tidy success "
"story. Red thread travels with the seal."
msgstr "{value0}：准予返校，但爭議不准變成漂亮的成功故事；紅線隨章同行。"

