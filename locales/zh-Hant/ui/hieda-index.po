msgid "Follow one nuisance through seven offices"
msgstr "從一件麻煩追到七個辦公室"

#. copy/characterHint
#: src/js/hieda-index.js:24
msgctxt "tree:copy#/characterHint"
msgid "See one person's fingerprints across different files"
msgstr "看同一個人如何在不同卷宗留下手印"

#. copy/versionHint
#: src/js/hieda-index.js:24
msgctxt "tree:copy#/versionHint"
msgid "Trace change along the first-parent chronicle"
msgstr "沿 first-parent 校史翻查校園何時改變"

