msgstr "這條紅線怎麼接"

#. copy/contradiction
#: src/js/hieda-index.js:24
msgctxt "tree:copy#/contradiction"
msgid "Contradiction retained by Akyuu"
msgstr "阿求保留的矛盾"

#. copy/people
#: src/js/hieda-index.js:24
msgctxt "tree:copy#/people"
