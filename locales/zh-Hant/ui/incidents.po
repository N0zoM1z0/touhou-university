#. copy/eyebrow
#: src/js/incidents.js:33
msgctxt "tree:copy#/eyebrow"
msgid "INCIDENT RESPONSE / CAMPUS INCIDENT DESK"
msgstr "INCIDENT RESPONSE / 校園事件聯絡室"

#. copy/title
#: src/js/incidents.js:33
msgctxt "tree:copy#/title"
msgid "Do not declare an incident just yet."
msgstr "先別急著宣布異變。"

#. copy/lead
#: src/js/incidents.js:33
msgctxt "tree:copy#/lead"
msgid ""
"Collect testimony, open the version history, choose a reversible response, "
"then let the research design decide what is actually known. The campus wire "
"will be restrained after closure; the BBS usually will not."
msgstr "收證詞、拆開版本差異、選一項可撤回的處置，再讓研究設計決定我們究竟知道了什麼。結案後，校務快訊會寫得很克制；BBS 通常不會。"

#. copy/live
#: src/js/incidents.js:33
msgctxt "tree:copy#/live"
msgid "Active"
msgstr "處理中"

#. copy/resolved
#: src/js/incidents.js:33
msgctxt "tree:copy#/resolved"
msgid "Closed"
msgstr "已結案"

#. copy/experiments
#: src/js/incidents.js:33
msgctxt "tree:copy#/experiments"
msgid "simulations"
msgstr "次模擬"

#. copy/cases
#: src/js/incidents.js:33
msgctxt "tree:copy#/cases"
msgid "Case files"
msgstr "事件案卷"

#. copy/simulator
#: src/js/incidents.js:33
msgctxt "tree:copy#/simulator"
msgid "Research simulator"
msgstr "研究模擬器"

#. copy/records
#: src/js/incidents.js:33
msgctxt "tree:copy#/records"
msgid "Closures & reactions"
msgstr "結案與連動"

#. copy/dispatch
#: src/js/incidents.js:33
msgctxt "tree:copy#/dispatch"
msgid "Duty dispatch"
msgstr "當值通報"

#. copy/affected
#: src/js/incidents.js:33
msgctxt "tree:copy#/affected"
msgid "Scope affected"
msgstr "影響範圍"

#. copy/measure
#: src/js/incidents.js:33
msgctxt "tree:copy#/measure"
msgid "Primary measure"
msgstr "主要觀測量"

#. copy/dossier
#: src/js/incidents.js:33
msgctxt "tree:copy#/dossier"
msgid "Field dossier"
msgstr "現場案卷"

#. copy/evidence
#: src/js/incidents.js:33
msgctxt "tree:copy#/evidence"
msgid "Evidence & records"
msgstr "證物與記錄"

#. copy/evidenceLead
#: src/js/incidents.js:33
msgctxt "tree:copy#/evidenceLead"
msgid ""
"Select an item to mark it reviewed. Reliability describes the material "
"itself, not whether its conclusion is true."
msgstr "點一下標記已審閱；可靠度不等於結論正確，它只說明這份材料本身有多穩。"

#. copy/testimony
#: src/js/incidents.js:33
msgctxt "tree:copy#/testimony"
msgid "Testimony & trouble"
msgstr "證詞與麻煩"

#. copy/testimonyLead
#: src/js/incidents.js:33
msgctxt "tree:copy#/testimonyLead"
msgid ""
"A witness may also maintain the equipment, control the first headline, or be "
"part of the incident. That is a position to record, not a reason to erase "
"them."
msgstr "證人可能同時是設備維護者、新聞來源或事件的一部分。這不是淘汰證詞的理由，而是需要留下的位置。"

#. copy/reviewed
#: src/js/incidents.js:33
msgctxt "tree:copy#/reviewed"
msgid "Reviewed"
msgstr "已審閱"

#. copy/markReviewed
#: src/js/incidents.js:33
msgctxt "tree:copy#/markReviewed"
msgid "Mark reviewed"
msgstr "標記審閱"

#. copy/source
#: src/js/incidents.js:33
msgctxt "tree:copy#/source"
msgid "Source"
msgstr "來源"

#. copy/reliability
#: src/js/incidents.js:33
msgctxt "tree:copy#/reliability"
msgid "Material reliability"
msgstr "材料可靠度"

#. copy/tension
#: src/js/incidents.js:33
msgctxt "tree:copy#/tension"
msgid "Tension to retain"
msgstr "需保留的矛盾"

#. copy/hypothesis
#: src/js/incidents.js:33
msgctxt "tree:copy#/hypothesis"
msgid "Working hypothesis"
msgstr "工作假說"

#. copy/hypothesisLead
#: src/js/incidents.js:33
msgctxt "tree:copy#/hypothesisLead"
msgid "Choose one explanation that can be disproved. The simulator keeps wrong guesses."
msgstr "先選一個可被推翻的解釋。模擬器會保留你猜錯的結果。"

#. copy/response
#: src/js/incidents.js:33
msgctxt "tree:copy#/response"
msgid "Reversible response"
msgstr "可逆處置"

#. copy/responseLead
#: src/js/incidents.js:33
msgctxt "tree:copy#/responseLead"
msgid ""
"Choose up to two first moves. If the study overturns the hypothesis, they "
"can be withdrawn instead of becoming tradition."
msgstr "最多先做兩項；如果研究推翻假說，處置可以撤回，不必把臨時規則寫成傳統。"

#. copy/reversible
#: src/js/incidents.js:33
msgctxt "tree:copy#/reversible"
msgid "Reversible"
msgstr "可撤回"

#. copy/caution
#: src/js/incidents.js:33
msgctxt "tree:copy#/caution"
msgid "Field reaction"
msgstr "現場反作用"

#. copy/selected
#: src/js/incidents.js:33
msgctxt "tree:copy#/selected"
msgid "Selected"
msgstr "已選"

#. copy/actionLimit
#: src/js/incidents.js:33
msgctxt "tree:copy#/actionLimit"
msgid "Two first responses at most. Remove one before adding another."
msgstr "先行處置最多兩項；先撤下一項再加新的。"

#. copy/openLab
#: src/js/incidents.js:33
msgctxt "tree:copy#/openLab"
msgid "Take this hypothesis into the simulator"
msgstr "帶著這個假說進入模擬器"

#. copy/ethicsReference
#: src/js/incidents.js:33
msgctxt "tree:copy#/ethicsReference"
msgid "Prior ethics files for ability intervention"
msgstr "能力干預前置倫理案卷"

#. copy/ethicsReferenceLead
#: src/js/incidents.js:33
msgctxt "tree:copy#/ethicsReferenceLead"
msgid ""
"If this incident becomes an ability-intervention study, cite the files below "
"first. Closing an incident does not retroactively grant research permission."
msgstr "若本事件被用作能力介入研究，聯絡室要求先引用下列審查案；事件結案不會倒推成研究許可。"

#. copy/openEthics
#: src/js/incidents.js:33
msgctxt "tree:copy#/openEthics"
msgid "Open prior ethics question"
msgstr "查看前置倫理爭點"

#. copy/chooseHypothesis
#: src/js/incidents.js:33
msgctxt "tree:copy#/chooseHypothesis"
msgid "Choose a working hypothesis"
msgstr "先選一個工作假說"

#. copy/readiness
#: src/js/incidents.js:33
msgctxt "tree:copy#/readiness"
msgid "Dossier readiness"
msgstr "案卷準備度"

#. copy/reviewedEvidence
#: src/js/incidents.js:33
msgctxt "tree:copy#/reviewedEvidence"
msgid "evidence items"
msgstr "份證物"

#. copy/reviewedWitnesses
#: src/js/incidents.js:33
msgctxt "tree:copy#/reviewedWitnesses"
msgid "testimonies"
msgstr "份證詞"

#. copy/labEyebrow
#: src/js/incidents.js:33
msgctxt "tree:copy#/labEyebrow"
msgid "METHODS LAB / IDENTIFIABILITY IS NOT DECORATION"
msgstr "METHODS LAB / 可識別性不是裝飾"

#. copy/labTitle
#: src/js/incidents.js:33
msgctxt "tree:copy#/labTitle"
msgid "Make the elegant conclusion capable of failing."
msgstr "把漂亮的結論逼到會失敗。"

#. copy/labLead
#: src/js/incidents.js:33
msgctxt "tree:copy#/labLead"
msgid ""
"A larger sample narrows chance error. It does not repair confounding, drift, "
"missing records, or kappa firmware replaced yesterday. Responses also change "
"the field, so they enter the model too."
msgstr "樣本數能縮窄隨機誤差，卻不能自動修好混雜、漂移、缺失或昨天被換掉的河童韌體。處置本身也會改變現場，故一併納入模型。"

#. copy/activeCase
#: src/js/incidents.js:33
msgctxt "tree:copy#/activeCase"
msgid "Active case"
msgstr "目前案卷"

#. copy/testedHypothesis
#: src/js/incidents.js:33
msgctxt "tree:copy#/testedHypothesis"
msgid "Hypothesis tested"
msgstr "受測假說"

#. copy/sample
#: src/js/incidents.js:33
msgctxt "tree:copy#/sample"
msgid "Observation units"
msgstr "觀測單位"

#. copy/sampleHelp
#: src/js/incidents.js:33
msgctxt "tree:copy#/sampleHelp"
msgid "A larger sample reduces random variation, not systematic error."
msgstr "更大的樣本降低隨機波動，不會清除系統性錯誤。"

#. copy/repeats
#: src/js/incidents.js:33
msgctxt "tree:copy#/repeats"
msgid "Replicate rounds"
msgstr "重複輪次"

#. copy/control
#: src/js/incidents.js:33
msgctxt "tree:copy#/control"
msgid "Add a same-time control group"
msgstr "設置同時段對照組"

#. copy/randomize
#: src/js/incidents.js:33
msgctxt "tree:copy#/randomize"
msgid "Randomise observation order"
msgstr "隨機分派觀測順序"

#. copy/calibration
#: src/js/incidents.js:33
msgctxt "tree:copy#/calibration"
msgid "Recalibrate every round"
msgstr "每輪重新校準儀器"

#. copy/versionLock
#: src/js/incidents.js:33
msgctxt "tree:copy#/versionLock"
msgid "Lock equipment and data versions"
msgstr "鎖定設備與資料版本"

#. copy/run
#: src/js/incidents.js:33
msgctxt "tree:copy#/run"
msgid "Run simulation"
msgstr "執行一輪模擬"

#. copy/result
#: src/js/incidents.js:33
msgctxt "tree:copy#/result"
msgid "Latest experiment slip"
msgstr "最新實驗回條"

#. copy/noResult
#: src/js/incidents.js:33
msgctxt "tree:copy#/noResult"
msgid ""
"No simulation exists for this case. Choose a hypothesis and design, then run "
"it; failures are saved too."
msgstr "這宗事件尚無模擬。選擇假說與設計後執行；失敗結果也會保存在本機。"

#. copy/identifiability
#: src/js/incidents.js:33
msgctxt "tree:copy#/identifiability"
msgid "Design identifiability"
msgstr "設計分辨度"

#. copy/observed
#: src/js/incidents.js:33
msgctxt "tree:copy#/observed"
msgid "Observed difference"
msgstr "觀測差"

#. copy/interval
#: src/js/incidents.js:33
msgctxt "tree:copy#/interval"
msgid "Uncertainty range"
msgstr "不確定範圍"

#. copy/residuals
#: src/js/incidents.js:33
msgctxt "tree:copy#/residuals"
msgid "Interference still present"
msgstr "仍未消除的干擾"

#. copy/confounding
#: src/js/incidents.js:33
msgctxt "tree:copy#/confounding"
msgid "Confounding"
msgstr "混雜"

#. copy/drift
#: src/js/incidents.js:33
msgctxt "tree:copy#/drift"
msgid "Drift"
msgstr "漂移"

#. copy/missing
#: src/js/incidents.js:33
msgctxt "tree:copy#/missing"
msgid "Missingness"
msgstr "缺失"

#. copy/version
#: src/js/incidents.js:33
msgctxt "tree:copy#/version"
msgid "Version change"
msgstr "版本變動"

#. copy/hazards
#: src/js/incidents.js:33
msgctxt "tree:copy#/hazards"
msgid "Trouble still in the field"
msgstr "尚在場的麻煩"

#. copy/noHazards
#: src/js/incidents.js:33
msgctxt "tree:copy#/noHazards"
msgid ""
"Major structural interference is low. This does not mean Gensokyo has "
"suddenly become orderly."
msgstr "主要結構性干擾已被壓低；仍不代表幻想鄉突然變得守規矩。"

#. copy/verdicts/supports
#: src/js/incidents.js:33
msgctxt "tree:copy#/verdicts/supports"
msgid "The design supports this hypothesis"
msgstr "設計支持這個假說"

#. copy/verdicts/rejects
#: src/js/incidents.js:33
msgctxt "tree:copy#/verdicts/rejects"
msgid "The design tends to reject this hypothesis"
msgstr "設計傾向推翻這個假說"

#. copy/verdicts/inconclusive
#: src/js/incidents.js:33
msgctxt "tree:copy#/verdicts/inconclusive"
msgid "The design cannot yet separate hypothesis from interference"
msgstr "目前無法區分假說與干擾"

#. copy/verdicts/false-confidence
#: src/js/incidents.js:33
msgctxt "tree:copy#/verdicts/false-confidence"
msgid "The number is loud, but the design is manufacturing confidence"
msgstr "數字很響亮，但設計正在製造假確信"

#. copy/resolve
#: src/js/incidents.js:33
msgctxt "tree:copy#/resolve"
msgid "Close normally with this experiment and publish reactions"
msgstr "以這份實驗正常結案並發布連動"

#. copy/retainContested
#: src/js/incidents.js:33
msgctxt "tree:copy#/retainContested"
msgid "Send to the Red-Thread Desk: retain this unsupported theory"
msgstr "送交紅線席：保留這個未獲支持的異說"

#. copy/retentionTitle
#: src/js/incidents.js:33
msgctxt "tree:copy#/retentionTitle"
msgid "This is not confirmation. Close it anyway?"
msgstr "這不是證實。你仍要讓它結案嗎？"

#. copy/retentionLead
#: src/js/incidents.js:33
msgctxt "tree:copy#/retentionLead"
msgid ""
"Ordinary review rejected this inference, but the duty reviewer thinks its "
"failure, controversy, or headline value deserves a record. If you insist, "
"the university will bind it as a contested closure and release linked "
"campus-wire and BBS reactions."
msgstr "正常審閱已拒絕這項推論，但值班審閱者認為它的錯法、爭議或新聞價值值得留下。若你堅持，校方會以紅線裝訂成「爭議性結案」，並同步放出校務快訊與 BBS。"

#. copy/retentionWarning
#: src/js/incidents.js:33
msgctxt "tree:copy#/retentionWarning"
msgid ""
"The red-thread file permanently keeps the original result and a NOT "
"ESTABLISHED mark. A large headline cannot launder it into confirmation."
msgstr "紅線案卷會永久顯示原始實驗結果與「未獲支持」標記；大字標題不能把它洗成已證實。"

#. copy/originalResult
#: src/js/incidents.js:33
msgctxt "tree:copy#/originalResult"
msgid "Original experiment result"
msgstr "原始實驗結果"

#. copy/reviewer
#: src/js/incidents.js:33
msgctxt "tree:copy#/reviewer"
msgid "Reviewer proposing retention"
msgstr "提出保留的審閱者"

#. copy/retentionReason
#: src/js/incidents.js:33
msgctxt "tree:copy#/retentionReason"
msgid "Reason to retain"
msgstr "保留理由"

#. copy/retentionConfirm
#: src/js/incidents.js:33
msgctxt "tree:copy#/retentionConfirm"
msgid ""
"I understand that the experiment did not establish this claim and still "
"request publication as a contested closure."
msgstr "我明白這項主張沒有被實驗證實，仍要求以爭議性結案公開保存。"

#. copy/cancelRetention
#: src/js/incidents.js:33
msgctxt "tree:copy#/cancelRetention"
msgid "Do not bind it yet"
msgstr "先不要裝訂"

#. copy/publishContested
#: src/js/incidents.js:33
msgctxt "tree:copy#/publishContested"
msgid "Sign, stamp, and let the BBS argue"
msgstr "簽名、蓋章，讓 BBS 開始吵"

#. copy/contestedSaved
#: src/js/incidents.js:33
msgctxt "tree:copy#/contestedSaved"
msgid ""
"The red-thread file is bound. The campus wire kept its warning; the BBS did "
"not keep calm."
msgstr "紅線爭議案卷已裝訂；校務快訊保持警告，BBS 則沒有保持冷靜。"

#. copy/contested
#: src/js/incidents.js:33
msgctxt "tree:copy#/contested"
msgid "Red-thread contested file"
msgstr "紅線爭議案卷"

#. copy/established
#: src/js/incidents.js:33
msgctxt "tree:copy#/established"
msgid "Ordinary closure"
msgstr "一般結案"

#. copy/disposition
#: src/js/incidents.js:33
msgctxt "tree:copy#/disposition"
msgid "File disposition"
msgstr "案卷性質"

#. copy/signedBy
#: src/js/incidents.js:33
msgctxt "tree:copy#/signedBy"
msgid "Signing reviewer"
msgstr "簽名審閱"

#. copy/retainedBecause
#: src/js/incidents.js:33
msgctxt "tree:copy#/retainedBecause"
msgid "Reason retained"
msgstr "保留理由"

#. copy/unsupportedFinding
#: src/js/incidents.js:33
msgctxt "tree:copy#/unsupportedFinding"
msgid "Unsupported theory"
msgstr "未獲支持的異說"

#. copy/resolvedAlready
#: src/js/incidents.js:33
msgctxt "tree:copy#/resolvedAlready"
msgid "This case is closed. The BBS is not."
msgstr "這宗事件已結案；BBS 還沒有。"

#. copy/notReady
#: src/js/incidents.js:33
msgctxt "tree:copy#/notReady"
msgid ""
"Ordinary closure needs identifiability of at least 60, support for the "
"tested hypothesis, and one reversible response. Unsupported results do not "
"slip through silently; a reviewer may instead sign a red-thread retention."
msgstr "一般結案需要分辨度至少 60、結果支持受測假說，並選擇至少一項可逆處置。未獲支持的結果不會悄悄過關；若審閱席願意背書，可另走紅線保留。"

#. copy/experimentSaved
#: src/js/incidents.js:33
msgctxt "tree:copy#/experimentSaved"
msgid "The experiment slip is saved on this device and recorded in the My TU ledger."
msgstr "模擬回條已保存在這台裝置，並寫入 My TU 事件帳本。"

#. copy/resolutionSaved
#: src/js/incidents.js:33
msgctxt "tree:copy#/resolutionSaved"
msgid "Case closed. A campus-wire item and three BBS threads have appeared."
msgstr "事件已結案；校務快訊與三篇 BBS 討論已出現。"

#. copy/archiveEyebrow
#: src/js/incidents.js:33
msgctxt "tree:copy#/archiveEyebrow"
msgid "CASE ARCHIVE / CLOSURE DOES NOT END OBJECTIONS"
msgstr "CASE ARCHIVE / 結案不等於沒人反對"

#. copy/archiveTitle
#: src/js/incidents.js:33
msgctxt "tree:copy#/archiveTitle"
msgid "After a finding enters the campus system."
msgstr "結論進入校務系統之後。"

#. copy/archiveLead
#: src/js/incidents.js:33
msgctxt "tree:copy#/archiveLead"
msgid ""
"Closures, experiment slips, and incident-triggered BBS threads stay on this "
"device. There is one official record and usually three dissatisfied "
"headlines."
msgstr "結案檔案、模擬回條與由事件觸發的 BBS 討論都保存在這台裝置。官方紀錄只有一份；不服氣的標題通常有三份。"

#. copy/resolutionsTitle
#: src/js/incidents.js:33
msgctxt "tree:copy#/resolutionsTitle"
msgid "Closure records"
msgstr "結案檔案"

#. copy/experimentHistory
#: src/js/incidents.js:33
msgctxt "tree:copy#/experimentHistory"
msgid "Experiment slips"
msgstr "模擬回條"

#. copy/noResolutions
#: src/js/incidents.js:33
msgctxt "tree:copy#/noResolutions"
msgid ""
"No cases have closed. Choose a hypothesis from a case and build a design "
"that can distinguish it."
msgstr "尚無事件結案。從案卷選一個假說，到模擬器做出足以分辨的設計。"

#. copy/noExperiments
#: src/js/incidents.js:33
msgctxt "tree:copy#/noExperiments"
msgid "No experiment slips yet."
msgstr "尚無模擬回條。"

#. copy/finding
#: src/js/incidents.js:33
msgctxt "tree:copy#/finding"
msgid "Provisional finding"
msgstr "暫定發現"

#. copy/responseUsed
#: src/js/incidents.js:33
msgctxt "tree:copy#/responseUsed"
msgid "First response"
msgstr "先行處置"

#. copy/published
#: src/js/incidents.js:33
msgctxt "tree:copy#/published"
msgid "Published"
msgstr "已發布"

#. copy/openBbs
#: src/js/incidents.js:33
msgctxt "tree:copy#/openBbs"
msgid "Open linked BBS"
msgstr "查看事件連動 BBS"

#. copy/reopenCase
#: src/js/incidents.js:33
msgctxt "tree:copy#/reopenCase"
msgid "Reopen case file"
msgstr "回看案卷"

#. copy/quality
#: src/js/incidents.js:33
msgctxt "tree:copy#/quality"
msgid "Identifiability"
msgstr "分辨度"

#. copy/design
#: src/js/incidents.js:33
msgctxt "tree:copy#/design"
msgid "Design"
msgstr "設計"

#. copy/samplesShort
#: src/js/incidents.js:33
msgctxt "tree:copy#/samplesShort"
msgid "units"
msgstr "單位"

#. copy/roundsShort
#: src/js/incidents.js:33
msgctxt "tree:copy#/roundsShort"
msgid "rounds"
msgstr "輪"

#. copy/bbsThreads
#: src/js/incidents.js:33
msgctxt "tree:copy#/bbsThreads"
msgid "linked threads"
msgstr "篇連動討論"

#. copy/localOnly
#: src/js/incidents.js:33
msgctxt "tree:copy#/localOnly"
msgid "On-device"
msgstr "本機保存"

#. copy/resolvedOn
#: src/js/incidents.js:33
msgctxt "tree:copy#/resolvedOn"
msgid "Closed"
msgstr "結案時間"
