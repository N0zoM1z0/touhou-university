msgstr "列印日期"

#. copy/receiptNote
#: src/js/library.js:19
msgctxt "tree:copy#/receiptNote"
msgid ""
"If a book shelves itself elsewhere, its return destination remains Misty "
"Lake Library. This receipt is generated from records in the current browser."
msgstr "書籍若自行移架，歸還地仍以借閱回條所列霧湖圖書館為準。此回條由目前瀏覽器中的借閱記錄生成。"

#. copy/print
#: src/js/library.js:19
msgctxt "tree:copy#/print"
msgid "Print / save PDF"
msgstr "列印／另存 PDF"

#. copy/closeReceipt
#: src/js/library.js:19
msgctxt "tree:copy#/closeReceipt"
msgid "Back to library"
msgstr "返回圖書館"

#. copy/lunarNotice
#: src/js/library.js:19
msgctxt "tree:copy#/lunarNotice"
msgid ""
"Full-moon states are updated by staff that night. A torch does not count as "
"a lunar phase."
msgstr "滿月書況由館員在當夜更新；手電筒不算月相。"

#. copy/holdPosition
#: src/js/library.js:19
msgctxt "tree:copy#/holdPosition"
msgid "On-device queue position 1"
msgstr "本機預約第 1 位"
