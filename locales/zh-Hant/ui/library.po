#: src/js/library.js:19
msgctxt "tree:copy#/noLoans"
msgid "Your loan bag is empty except for a Kourindou receipt nobody remembers adding."
msgstr "借閱袋目前是空的，只有一張不知誰放進去的香霖堂收據。"

#. copy/noHolds
#: src/js/library.js:19
msgctxt "tree:copy#/noHolds"
msgid "No holds are waiting."
msgstr "沒有等待中的預約。"

#. copy/noHistory
#: src/js/library.js:19
msgctxt "tree:copy#/noHistory"
msgid "No circulation history yet. The librarian is polite but slightly bored."
msgstr "尚無借閱歷史。館員對此保持禮貌，但略感無聊。"

