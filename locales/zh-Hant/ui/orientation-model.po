#. copies/office
#: src/js/orientation-model.js:231
msgctxt "tree:copies#/office"
msgid "New Student Arrival Office"
msgstr "新生到着室"

#. copies/opened
#: src/js/orientation-model.js:231
msgctxt "tree:copies#/opened"
msgid "Arrival file opened; Hakurei Gate awaits the student"
msgstr "報到卷已開立，博麗門等候本人到校"

#. copies/openedBody
#: src/js/orientation-model.js:231
msgctxt "tree:copies#/openedBody"
msgid ""
"The file lists the route, stop signal, and first destination. Public updates "
"show counts without names."
msgstr "卷內列出路線、停止信號與第一站，公開消息只顯示人數。"

#. copies/complete
#: src/js/orientation-model.js:231
msgctxt "tree:copies#/complete"
msgid "First Bell records one more arrival"
msgstr "第一鐘新增一筆到校紀錄"

#. copies/completeBody
#: src/js/orientation-model.js:231
msgctxt "tree:copies#/completeBody"
msgid "The arrival route and way back are on file. Bunbunmaru receives an anonymous count."
msgstr "到校路線與退路已存卷，文文。新聞收到匿名人數統計。"
